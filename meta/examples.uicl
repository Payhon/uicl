example #example_31 "database"
  path: "examples/fullstack/database.uicl"
  profiles: ["uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.meta@1.0.0", "uicl.postgresql@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    module #database_module
      exports: [database, tasks_table, mapping]
    
    use #backend
      source: @"./backend.uicl"
    
    secret #connection "数据库连接凭据"
      source: credential_store
      binding: "demo.database"
      scope: [postgres_adapter]
    
    pg.database #database
      name: "uicl_demo"
      engine_major: 18
      schema: public
      connection: @connection
    
      pg.table #tasks_table
        name: "tasks"
        columns:
          - name: id
            type: uuid
            nullable: false
          - name: title
            type: text
            nullable: false
          - name: done
            type: boolean
            nullable: false
            default: false
          - name: owner
            type: text
            nullable: false
          - name: version
            type: bigint
            nullable: false
            default: 1
          - name: created_at
            type: timestamptz
            nullable: false
          - name: updated_at
            type: timestamptz
            nullable: false
        primary_key: [id]
        checks:
          - name: title_length
            sql: "char_length(title) BETWEEN 1 AND 120"
          - name: positive_version
            sql: "version >= 1"
        indexes:
          - name: tasks_owner_created
            columns: [owner, created_at, id]
            method: btree
            build: normal
    
      pg.mapping #mapping
        model: @backend::Task
        table: @tasks_table
        id_conversion: uuid_string
        fields:
          id: id
          title: title
          done: done
          owner: owner
          version: version
          created_at: created_at
          updated_at: updated_at
  ```

example #example_32 "deploy"
  path: "examples/fullstack/deploy.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.deployment@1.0.0", "uicl.design@1.0.0", "uicl.host@1.0.0", "uicl.lifecycle@1.0.0", "uicl.meta@1.0.0", "uicl.postgresql@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    module #deploy_module
      exports: [production]
    use #build
      source: @"./build.uicl"
    use #database
      source: @"./database.uicl"
    use #tests
      source: @"./tests.uicl"
    
    parameter #host_ip
      type: text
    parameter #host_user
      type: text
    parameter #host_fingerprint
      type: text
    secret #login
      source: runtime_prompt
      scope: [ssh_adapter]
    secret #database_url
      source: credential_store
      binding: "demo.database-url"
      scope: [remote_service_environment]
    
    ops.ssh_host #host
      address: $host_ip
      user: $host_user
      authentication:
        method: password
        credential: @login
      host_key:
        policy: pinned
        fingerprint: $host_fingerprint
      expected:
        os: linux
        architecture: x86_64
        service_manager: systemd
      privilege:
        method: sudo
        mode: noninteractive
    
    ops.service_release #release
      depends_on: [@database::database]
      host: @host
      artifact: @build::release_build.output
      service_name: "uicl-demo"
      run_as: "uicl-demo"
      directory: "/opt/uicl-demo"
      executable: "bin/api"
      environment:
        DATABASE_URL: @database_url
        HTTP_ADDR: "127.0.0.1:8080"
      retain_releases: 3
      health:
        url: "http://127.0.0.1:8080/health"
        expected_status: 200
        timeout_ms: 30000
      recovery:
        on_unhealthy: previous_binary
        on_disconnect: reconcile
        database: no_automatic_rollback
      approval: required
    
    deployment #production "演示服务器"
      resources: [@database::database, @host, @release]
      state:
        binding: "deployment-state:uicl-demo"
        locking: required
        encryption: required
      existing_resources: require_import
      approval: required
      gates: [@tests::create_visible, @tests::no_cross_user_update]
    
    observe #telemetry
      target: @release
      signals: [logs, metrics, traces]
      payloads: deny
      retention_days: 14
      binding: "approved_observability_sink"
  ```

example #example_33 "design"
  path: "examples/fullstack/design.uicl"
  profiles: ["uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    module #design_module
      exports: [brand]
    
    design #brand "待办设计系统"
      mode: system
      tokens:
        color:
          brand: "#315BEA"
          text: "#172033"
          surface: "#FFFFFF"
        spacing:
          base: 16
      locales: ["zh-CN", en]
      a11y
        target: "wcag-2.2-aa"
        reduce_motion: respect_system
        keyboard: true
  ```

