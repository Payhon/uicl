example #example_35 "requirements"
  path: "examples/fullstack/requirements.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.deployment@1.0.0", "uicl.design@1.0.0", "uicl.lifecycle@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    module #requirements
      exports: [create_note, private_notes]
    
    requirement #create_note "创建待办"
      statement: "已登录用户可以创建长度为 1 到 120 个 Unicode 标量的待办标题。"
      acceptance:
        - "输入先 trim，再校验长度。"
        - "保存成功后列表显示新待办。"
        - "失败不清除输入。"
    
    requirement #private_notes "数据隔离"
      statement: "每个用户只能读取和完成自己的待办；不可由请求体指定所有者。"
      acceptance:
        - "未经认证的创建失败。"
        - "另一用户无法读取或修改已有记录。"
        - "过期版本更新返回冲突。"
  ```

example #example_36 "tests"
  path: "examples/fullstack/tests.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.deployment@1.0.0", "uicl.design@1.0.0", "uicl.lifecycle@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    module #tests_module
      exports: [create_visible, no_cross_user_update]
    use #req
      source: @"./requirements.uicl"
    use #ui
      source: @"./ui.uicl"
    use #backend
      source: @"./backend.uicl"
    
    test #create_visible "创建后看到新待办"
      kind: e2e
      verifies: [@req::create_note]
      isolation: ephemeral
      given
        test.reset
          resource: @backend::Task
        test.actor
          id: "user-a"
          roles: []
        test.open
          page: @ui::home
      when
        test.fill
          target: @ui::editor
          field: title
          value: "买咖啡"
        test.submit
          target: @ui::editor
      then
        expect
          target: @ui::entries
          contains: "买咖啡"
          count: 1
    
    test #no_cross_user_update "用户 B 不能修改用户 A 的待办"
      kind: security
      verifies: [@req::private_notes]
      isolation: ephemeral
      given
        test.reset
          resource: @backend::Task
        test.fixture
          model: @backend::Task
          rows:
            - id: "00000000-0000-4000-8000-000000000001"
              title: "属于 A"
              done: false
              owner: "user-a"
              version: 1
              created_at: "2026-09-20T00:00:00Z"
              updated_at: "2026-09-20T00:00:00Z"
        test.actor
          id: "user-b"
          roles: []
      when
        test.execute #attempt
          action: @backend::complete_task
          args:
            id: "00000000-0000-4000-8000-000000000001"
            version: 1
      then
        expect
          target: @attempt.result
          error: "NOT_FOUND_OR_FORBIDDEN"
  ```

example #example_37 "ui"
  path: "examples/fullstack/ui.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    module #ui_module
      exports: [app, home, editor, entries, tasks, web_target]
    
    use #backend
      source: @"./backend.uicl"
    use #design
      source: @"./design.uicl"
    
    target #web_target
      adapter: "web.react"
      platform: web
      framework: react
      language: typescript
      toolchain: locked
    
    app #app "个人待办"
      target: @web_target
      design: @design::brand
      identity: host
      page #home "待办清单"
        route: "/"
        access: authenticated
        resource #tasks
          query: @backend::my_tasks
          args: {}
        ui.heading "我的待办"
        form #editor "新增待办"
          create: @backend::add_task
          fields: [title]
          on_success_refresh: [@tasks]
        list #entries
          source: @tasks
          empty_text: "还没有待办。"
          ui.row
            ui.text
              value: $item.title
            ui.button #complete "完成"
              on click
                call #completed
                  action: @backend::complete_task
                  args:
                    id: $item.id
                    version: $item.version
                refresh
                  target: @tasks
  ```

example #example_38 "article"
  path: "examples/hosted/article.uicl"
  profiles: ["uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.document@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ````uicl
    <!-- uicl:markdown 1.0 -->
    
    # 产品说明
    
    这是一份 **原生 Markdown** 文档。
    
    <!-- uicl
    doc.block #summary
      target: next
      intent: "保留正文，按需检查与编辑。"
    -->
    
    产品支持整理资料，不会在打开文件时自动部署服务。
    
    ## 使用步骤
    
    - 创建文档。
    - 审阅计划。
    
    下面的代码围栏只是示例，不激活其中的注解。
    
    ```html
    <!-- uicl
    doc.block #inactive
      target: next
    -->
    ```
  ````

example #example_39 "data-block"
  path: "examples/hosted/data-block.uicl"
  profiles: ["uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.document@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    <!doctype html>
    <html lang="zh-CN"><head><meta charset="utf-8"><!-- uicl:html 1.0 --><title>Data block</title></head>
    <body><p id="summary">一份可正常阅读的 HTML 文件。</p>
    <script type="text/plain" data-uicl>
    uicl "1.0"
    doc.block #contract
      target: {html_id: "summary"}
      intent: "这是声明，不是 JavaScript。"
    </script></body></html>
  ```

