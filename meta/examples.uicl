    uicl "1.0"
    
    target #uni
      adapter: "mobile.uniapp_x"
      framework: uniapp_x
      platforms:
        - android
        - ios
      toolchain: locked
    
    target #rn
      adapter: "mobile.react_native"
      framework: react_native
      platforms:
        - android
        - ios
      toolchain: locked
    
    app #mobile_notes "跨端便签"
      targets:
        - @uni
        - @rn
      collection #notes
        storage: device
        field "content"
          type: text
          min: 1
      form #editor "新增"
        create: @notes
      list #entries
        source: @notes
  ```

example #example_7 "07-mobile-camera"
  path: "examples/07-mobile-camera.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.mobile@1.0.0", "uicl.resource@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    target #uni
      adapter: "mobile.uniapp_x"
      platforms: [android, ios]
      toolchain: locked
    
    target #rn
      adapter: "mobile.react_native"
      platforms: [android, ios]
      toolchain: locked
    
    mobile.permission #camera_permission "camera"
      usage: foreground
      request: user_gesture
      on_denied: explain_and_stop
      on_unavailable: show_unavailable
    
    mobile.capability #camera
      interface: "device.camera.capture@1"
      permission: @camera_permission
      bindings:
        - target: @uni
          implementation: "host.uts.camera"
        - target: @rn
          implementation: "host.rn.camera"
      input: {}
      output: "Artifact<image>"
      lifecycle: cancel_on_unmount
      errors: [CANCELLED, PERMISSION_DENIED, UNAVAILABLE]
    
    app #camera_app "拍照示例"
      targets: [@uni, @rn]
      ui.button #capture "拍照"
        on click
          invoke #photo
            capability: @camera
            args: {}
  ```

example #example_8 "08-windows-native"
  path: "examples/08-windows-native.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.native@1.0.0", "uicl.resource@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    target #windows
      adapter: "desktop.wpf"
      platform: windows
      framework: wpf
      language: csharp
      architectures: [x64, arm64]
      toolchain: locked
      build_host: windows
      ui_privilege: as_invoker
    
    file #native_source "原生接口待实现边界"
      media: "text/x-csharp"
      source: @"../assets/ServiceActions.cs"
    
    native.operation #set_start_mode
      interface: "windows.service.set_start_mode@1"
      implementation: @native_source
      entry: "ServiceActions.SetStartMode"
      input:
        service: text
        mode: text
      output: unit
      effects: [os.service.configure]
      policy:
        allowed_objects: [DemoMaintenanceService]
        execution: elevated_broker
        approval: each_invocation
      recovery:
        capture_before: true
        restore: compare_and_set
      threading: worker
      errors: [DENIED, NOT_FOUND, CONFLICT, INDETERMINATE]
    
    app #maintenance "桌面维护工具"
      target: @windows
      ui.text "只允许修改由本示例管理的演示服务。"
      ui.button #manual "设为手动启动"
        on click
          invoke
            capability: @set_start_mode
            args:
              service: "DemoMaintenanceService"
              mode: manual
  ```

example #example_9 "09-postgresql"
  path: "examples/09-postgresql.uicl"
  profiles: ["uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.meta@1.0.0", "uicl.postgresql@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    pg.database #business
      name: "business"
      engine_major: 18
      schema: public
    
      pg.table #customers
        name: "customers"
        columns:
          - name: id
            type: uuid
            nullable: false
          - name: email
            type: text
            nullable: false
        primary_key: [id]
        unique:
          - columns: [email]
    
      pg.table #orders
        name: "orders"
        columns:
          - name: id
            type: uuid
            nullable: false
          - name: customer_id
            type: uuid
            nullable: false
          - name: amount
            type: "numeric(12,2)"
            nullable: false
          - name: status
            type: text
            nullable: false
            default: "pending"
        primary_key: [id]
        foreign_keys:
          - columns: [customer_id]
            target: @customers
            target_columns: [id]
            on_delete: restrict
        checks:
          - name: amount_nonnegative
            sql: "amount >= 0"
        indexes:
          - name: pending_orders_by_customer
            columns: [customer_id]
            method: btree
            where_sql: "status = 'pending'"
            build: concurrently
    
    pg.migration #index_migration
      database: @business
      from_version: "1"
      to_version: "2"
      atomic: split_allowed
      destructive: deny
      lock_timeout_ms: 5000
      statement_timeout_ms: 120000
      steps:
        - operation: create_index
          target: @orders
          name: "pending_orders_by_customer"
          build: concurrently
  ```

example #example_10 "10-cloudflare"
  path: "examples/10-cloudflare.uicl"
  profiles: ["uicl.backend@1.0.0", "uicl.cloudflare@1.0.0", "uicl.core@1.0.0", "uicl.deployment@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    parameter #account_id "Cloudflare 账号"
      type: text
    
    secret #cloudflare_token "资源管理 Token"
      source: runtime_prompt
      scope: [cloudflare_adapter]
    
    cloudflare.provider #cf
      account_id: $account_id
      token: @cloudflare_token
      adapter_binding: "cloudflare_adapter"
    
    file #worker_bundle "Worker 源码"
      source: @"../assets/worker.mjs"
      media: "text/javascript"
    
    cloudflare.r2_bucket #uploads
      provider: @cf
      name: "uicl-example-uploads"
      on_remove: retain
    
    cloudflare.d1_database #db
      provider: @cf
      name: "uicl-example-db"
      on_remove: retain
    
    cloudflare.worker #api
      provider: @cf
      name: "uicl-example-api"
      entry: @worker_bundle
      compatibility_date: "2026-09-01"
      workers_dev: true
      bindings:
        DB: @db
        FILES: @uploads
    
    deployment #production "Cloudflare 示例"
      resources: [@uploads, @db, @api]
      state:
        binding: "infra-state:cloudflare-example"
        locking: required
        encryption: required
      existing_resources: require_import
      approval: required
  ```

example #example_11 "11-ecs-ssh"
  path: "examples/11-ecs-ssh.uicl"
  profiles: ["uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.deployment@1.0.0", "uicl.design@1.0.0", "uicl.host@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    parameter #server_ip "ECS IP"
      type: text
    parameter #ssh_user "SSH 用户"
      type: text
    parameter #host_fingerprint "可信主机指纹"
      type: text
    
    secret #ssh_password "SSH 密码"
      source: runtime_prompt
      scope: [ssh_adapter]
    
    ops.ssh_host #ecs
      address: $server_ip
      user: $ssh_user
      port: 22
      authentication:
        method: password
        credential: @ssh_password
      host_key:
        policy: pinned
        fingerprint: $host_fingerprint
      expected:
        os: linux
        architecture: x86_64
        service_manager: systemd
      privilege:
        method: sudo
        mode: noninteractive
    
    // 此处是外部产物定位声明，不随包提供可执行文件。
    artifact #release
      media: "application/gzip"
      source: @"artifact://host-supplied/example-api"
    
    ops.service_release #api
      host: @ecs
      artifact: @release
      service_name: "example-api"
      run_as: "example-api"
      directory: "/opt/example-api"
      executable: "bin/api"
      retain_releases: 3
      health:
        url: "http://127.0.0.1:8080/health"
        expected_status: 200
        timeout_ms: 30000
      recovery:
        on_unhealthy: previous_binary
        on_disconnect: reconcile
        database: no_automatic_rollback
      approval: required
    
    deployment #production "已有 Linux ECS"
      resources: [@ecs, @api]
      state:
        binding: "ops-state:ecs-example"
        locking: required
      existing_resources: require_import
      approval: required
  ```

example #example_12 "12-aigc-image"
  path: "examples/12-aigc-image.uicl"
  profiles: ["uicl.aigc@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    image #cover "咖啡海报"
      prompt: "一杯冰咖啡，干净背景，顶部为精确标题留白。"
      size: [1200, 1600]
      prefer:
        lighting: "柔和侧光"
        palette:
          - "奶油白"
          - "咖啡棕"
      scene
        background: "浅色无纹理背景"
        subject "冰咖啡"
          count: 1
          region: [0.25, 0.25, 0.5, 0.6]
      overlay
        overlay.text "夏日限定"
          region: [0.1, 0.05, 0.8, 0.12]
          font: "licensed-font:headline"
          font_px: 72
          align: center
      require
        check "media.dimensions"
          equals: [1200, 1600]
        check "media.mime"
          equals: "image/png"
      review
        criterion "主要杯子只有一个，标题不遮挡主体。"
    
    generate #render
      from: @cover
      phase: build
      output: "image/png"
      binding: "image_generation"
      limits:
        timeout_ms: 90000
        attempts: 1
        max_cost_minor: 100
        currency: USD
      approval: required
  ```

example #example_13 "13-aigc-text"
  path: "examples/13-aigc-text.uicl"
  profiles: ["uicl.aigc@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    file #facts "产品事实"
      source: @"../assets/product-facts.md"
      media: "text/markdown"
    
    text #article "产品介绍文章"
      prompt: "根据提供的资料写产品介绍，未提供的性能数据不要补写。"
      language: "zh-CN"
      sources: [@facts]
      prefer:
        tone: "平实"
        sections:
          - "适用场景"
          - "使用过程"
          - "已知限制"
      require
        check "text.max_unicode_scalars"
          max: 2000
      review
        criterion "事实陈述能够追溯到输入资料。"
    
    generate #draft
      from: @article
      phase: build
      output: "text/markdown"
      binding: "text_generation"
      limits:
        timeout_ms: 60000
        attempts: 1
      approval: required
  ```

example #example_14 "14-aigc-video"
  path: "examples/14-aigc-video.uicl"
  profiles: ["uicl.aigc@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    video #promo "八秒产品短片"
      size: [1080, 1920]
      fps: {num: 24, den: 1}
      frames: 192
      track #main
        kind: video
        overlap: forbid
        shot #opening
          start_frame: 0
          frames: 72
          prompt: "产品由暗到亮，缓慢推进。"
        shot #detail
          start_frame: 72
          frames: 120
          prompt: "展示细节，结尾停稳。"
      track #captions
        kind: subtitles
        overlap: forbid
        cue "看见每个细节"
          start_frame: 72
          frames: 96
      require
        check "video.frames"
          equals: 192
      review
        criterion "两个镜头中的产品身份保持一致。"
    
    generate #video_build
      from: @promo
      phase: build
      output: "video/mp4"
      binding: "video_generation"
      limits:
        timeout_ms: 300000
        attempts: 1
      approval: required
  ```

example #example_15 "15-aigc-deck"
  path: "examples/15-aigc-deck.uicl"
  profiles: ["uicl.aigc@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    deck #proposal "产品介绍"
      ratio: "16:9"
      editable: true
      slide #intro "产品定位"
        layout: title_and_body
        slide.text "减少整理内容所需的重复操作。"
        notes: "这里不承诺未验证的效率提升数值。"
      slide #features "核心能力"
        layout: three_columns
        slide.text "创建内容"
        slide.text "检查规则"
        slide.text "保留来源"
      require
        check "deck.slide_count"
          equals: 2
        check "deck.text_editable"
          equals: true
    
    generate #deck_build
      from: @proposal
      phase: build
      output: "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      binding: "deck_export"
      limits:
        timeout_ms: 120000
        attempts: 1
      approval: required
  ```

