example #example_18 "18-document-spec"
  path: "examples/18-document-spec.uicl"
  profiles: ["uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.document@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    document.spec #guide "使用指南"
      language: "zh-CN"
      output: "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      editable: true
      doc.section #purpose "用途"
        format: markdown
        body: |
          本工具用于**整理资料**与检查约束。
          不会在打开文档时自动调用付费服务。
      doc.section #steps "使用步骤"
        body: |
          1. 准备输入。
          2. 审阅计划。
          3. 授权执行。
      require
        check "document.text_editable"
          equals: true
  ```

example #example_19 "19-agent"
  path: "examples/19-agent.uicl"
  profiles: ["uicl.agent@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    type #Answer "检索回答"
      field "text"
        type: text
        min: 1
      field "needs_review"
        type: bool
    
    tool #search "知识库检索"
      adapter: mcp
      binding: "knowledge.search"
      input:
        query: text
      output: "list<text>"
      effects: [data.read]
      permissions: [knowledge.read]
    
    agent #researcher "资料助理"
      input:
        question: text
      output: @Answer
      model_binding: "assistant_model"
      tools: [@search]
      instructions: |
        先检索资料，再根据资料回答。
        无法证实时明确说明，并设置 needs_review。
      memory:
        scope: session
        retention_days: 1
        secrets: deny
      limits:
        timeout_ms: 60000
        attempts: 1
        max_steps: 8
        max_tool_calls: 4
      policy:
        tool_scope: declared_only
        external_writes: deny
        delegation_depth: 0
        data_egress: approved_only
      on_exhausted: human_review
    
    agent.run #answer
      agent: @researcher
      args:
        question: "资料中描述了哪些明确限制？"
      approval: required
  ```

example #example_20 "20-hybrid-classification"
  path: "examples/20-hybrid-classification.uicl"
  profiles: ["uicl.agent@1.0.0", "uicl.aigc@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.hybrid@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    type #Category "工单分类"
      enum: [refund, delivery, product, other]
    
    capability #classifier
      interface: "ticket.classify@1"
      binding: "classification_model"
      input:
        text: text
      output: @Category
      effects: [model.infer, network]
      permissions: [model.invoke]
      limits:
        timeout_ms: 30000
        attempts: 1
      errors: [REFUSED, INVALID_OUTPUT, TIMEOUT]
    
    action #manual "人工审核"
      returns: text
      allow: = $actor.authenticated
      transaction: none
      idempotency: none
      run
        return
          value: "manual_review"
    
    action #refund "退款审核入口"
      returns: text
      allow: = $actor.authenticated
      transaction: none
      idempotency: none
      run
        return
          value: "refund_review"
    
    action #delivery "物流帮助"
      returns: text
      allow: = $actor.authenticated
      transaction: none
      idempotency: none
      run
        return
          value: "delivery_help"
    
    action #product "产品帮助"
      returns: text
      allow: = $actor.authenticated
      transaction: none
      idempotency: none
      run
        return
          value: "product_help"
    
    action #route_ticket "分类后进入固定路径"
      input "text"
        type: text
        min: 1
      returns: text
      allow: = $actor.authenticated
      transaction: none
      idempotency: none
      run
        infer #classification
          using: @classifier
          args:
            text: $input.text
          on_error: @manual
        dispatch
          value: $classification
          routes:
            refund: @refund
            delivery: @delivery
            product: @product
            other: @manual
          on_unknown: @manual
  ```

example #example_21 "21-dynamic-image"
  path: "examples/21-dynamic-image.uicl"
  profiles: ["uicl.agent@1.0.0", "uicl.aigc@1.0.0", "uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.hybrid@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
