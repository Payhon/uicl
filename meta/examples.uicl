    uicl "1.0"
    
    app #counter "计数器"
      state #count
        value: 0
      ui.text
        value: $count
      ui.button #increase "加一"
        on click
          set
            target: @count
            value: = $count + 1
  ```

example #example_3 "03-device-notes"
  path: "examples/03-device-notes.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    app #notes_app "随手记"
      collection #notes
        storage: device
        operations:
          - read
          - create
        field "content"
          type: text
          min: 1
      form #editor "新增便签"
        create: @notes
      list #entries
        source: @notes
        empty_text: "尚无便签。"
  ```

example #example_4 "04-design-system"
  path: "examples/04-design-system.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    design #brand "通用阅读设计系统"
      mode: system
      tokens:
        color:
          brand: "#315BEA"
          surface: "#FFFFFF"
          text: "#172033"
        spacing:
          normal: 16
        radius:
          card: 12
      locales:
        - "zh-CN"
        - en
      breakpoints:
        - name: wide
          min_width: 840
          columns: 2
      theme "dark"
        tokens:
          color:
            surface: "#111827"
            text: "#F9FAFB"
      style #panel "panel"
        values:
          padding: 16
          radius: 12
      a11y
        target: "wcag-2.2-aa"
        reduce_motion: respect_system
        keyboard: true
    
    app #design_demo "设计预览"
      design: @brand
      ui.card
        style: @panel
        ui.heading "产品概览"
        ui.text "目标声明需要通过实际检查才能成为达标证据。"
  ```

example #example_5 "05-component"
  path: "examples/05-component.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.ui@1.0.0"]
