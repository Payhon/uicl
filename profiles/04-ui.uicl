    property "gap"
      type: "number"
      description: "逻辑间距。"
      required: false
      expression: false
    property "columns"
      type: "int"
      description: "grid 的列数。"
      required: false
      expression: false
    property "padding"
      type: "number"
      description: "内边距。"
      required: false
      expression: false
  schema #s_ui_scroll "ui.scroll"
    summary: "有序布局容器，顺序保留。"
    primary: null
    identity: "optional"
    children:
      - "ui.*"
      - "if"
      - "each"
      - "form"
      - "list"
      - "component.use"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
      expression: true
    property "style"
      type: "ref"
      description: "视觉样式引用。"
      required: false
      expression: false
      targets:
        - "style"
    property "test_id"
      type: "text"
      description: "可选稳定测试辅助标识。"
      required: false
      expression: false
    property "gap"
      type: "number"
      description: "逻辑间距。"
      required: false
      expression: false
    property "columns"
      type: "int"
      description: "grid 的列数。"
      required: false
      expression: false
    property "padding"
      type: "number"
      description: "内边距。"
      required: false
      expression: false
  schema #s_ui_card "ui.card"
    summary: "有序布局容器，顺序保留。"
    primary: null
    identity: "optional"
    children:
      - "ui.*"
      - "if"
      - "each"
      - "form"
      - "list"
      - "component.use"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
