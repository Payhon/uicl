uicl "1.0"

profile #profile_ui "界面与交互"
  id: "uicl.ui"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    有序界面树、状态绑定、事件、查询资源、表单列表与组件。
  requires:
    - "uicl.core@1.0.0"
    - "uicl.design@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "component"
    - "fill_slot"
    - "form"
    - "list"
    - "navigate"
    - "notify"
    - "on"
    - "refresh"
    - "resource"
    - "set"
    - "slot"
    - "ui"
  schema #s_ui_column "ui.column"
    summary: "有序布局容器，顺序保留。"
    primary: null
    identity: "optional"
    children:
      - "ui.*"
      - "if"
      - "each"
      - "form"
      - "list"
      - "component.use"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
      expression: true
    property "style"
      type: "ref"
      description: "视觉样式引用。"
      required: false
      expression: false
      targets:
        - "style"
    property "test_id"
      type: "text"
      description: "可选稳定测试辅助标识。"
      required: false
      expression: false
    property "gap"
      type: "number"
      description: "逻辑间距。"
      required: false
      expression: false
    property "columns"
      type: "int"
      description: "grid 的列数。"
      required: false
      expression: false
    property "padding"
      type: "number"
      description: "内边距。"
      required: false
      expression: false
  schema #s_ui_row "ui.row"
    summary: "有序布局容器，顺序保留。"
    primary: null
    identity: "optional"
    children:
      - "ui.*"
      - "if"
      - "each"
      - "form"
      - "list"
      - "component.use"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
      expression: true
    property "style"
      type: "ref"
      description: "视觉样式引用。"
      required: false
      expression: false
      targets:
        - "style"
    property "test_id"
      type: "text"
      description: "可选稳定测试辅助标识。"
      required: false
      expression: false
    property "gap"
      type: "number"
      description: "逻辑间距。"
      required: false
      expression: false
    property "columns"
      type: "int"
      description: "grid 的列数。"
      required: false
      expression: false
    property "padding"
      type: "number"
      description: "内边距。"
      required: false
      expression: false
  schema #s_ui_stack "ui.stack"
    summary: "有序布局容器，顺序保留。"
    primary: null
    identity: "optional"
    children:
      - "ui.*"
      - "if"
      - "each"
      - "form"
      - "list"
      - "component.use"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
      expression: true
    property "style"
      type: "ref"
      description: "视觉样式引用。"
      required: false
      expression: false
      targets:
        - "style"
    property "test_id"
      type: "text"
      description: "可选稳定测试辅助标识。"
      required: false
