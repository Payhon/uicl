uicl "1.0"

profile #profile_aigc "生成内容规格与任务"
  id: "uicl.aigc"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    文本、图片、视频、音频、演示文稿；规格与产物分离。
  requires:
    - "uicl.resource@1.0.0"
    - "uicl.design@1.0.0"
    - "uicl.testing@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "audio"
    - "cue"
    - "deck"
    - "generate"
    - "image"
    - "overlay"
    - "scene"
    - "shot"
    - "slide"
    - "subject"
    - "text"
    - "track"
    - "video"
  record_schema #r_Ratio "Ratio"
    summary: "有理数比率。"
    unknown_fields: "reject"
    property "num"
      type: "int"
      description: "分子。"
      required: true
      expression: false
    property "den"
      type: "int"
      description: "正分母。"
      required: true
      expression: false
  schema #s_text "text"
    summary: "文本生成规格，与 ui.text 不同。"
    primary: "label"
    identity: "required"
    children:
      - "require"
      - "review"
    unknown_properties: "reject"
    effects: []
    category: "spec"
    property "label"
      type: "text"
      description: "规格名称。"
      required: false
      expression: false
    property "prompt"
      type: "text"
      description: "生成意图。"
      required: true
      expression: true
    property "language"
      type: "text"
      description: "输出语言。"
      required: true
      expression: false
    property "sources"
      type: "list<ref>"
      description: "显式输入资料。"
      required: false
      expression: false
    property "prefer"
      type: "record"
      description: "语气、结构等偏好，不作硬保证。"
      required: false
      expression: false
  schema #s_image "image"
    summary: "图像生成规格，不是已有文件。"
    primary: "label"
    identity: "required"
    children:
      - "scene"
      - "overlay"
      - "require"
      - "review"
    unknown_properties: "reject"
    effects: []
    category: "spec"
    property "label"
      type: "text"
      description: "规格名称。"
      required: false
      expression: false
    property "prompt"
      type: "text"
      description: "画面意图。"
      required: true
      expression: true
    property "size"
      type: "list<int>"
      description: "[width,height]。"
      required: true
      expression: false
    property "color_space"
      type: "text"
      description: "色彩空间。"
      required: false
      expression: false
      default: "srgb"
    property "references"
      type: "list<ref>"
      description: "参考产物。"
      required: false
      expression: false
    property "prefer"
      type: "record"
      description: "视觉偏好，适配器报告支持程度。"
      required: false
      expression: false
  schema #s_scene "scene"
    summary: "图像场景层。"
    primary: null
    identity: "optional"
    children:
      - "subject"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "background"
      type: "text"
      description: "背景意图。"
      required: false
      expression: false
  schema #s_subject "subject"
    summary: "一个主要对象的期望描述。"
    primary: "label"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "label"
      type: "text"
      description: "主体说明。"
      required: true
      expression: false
    property "count"
      type: "int"
      description: "期望数量，须检查或评审。"
      required: false
      expression: false
      default: 1
    property "region"
      type: "list<number>"
      description: "归一化 [x,y,w,h]。"
      required: true
      expression: false
  schema #s_overlay "overlay"
    summary: "精确合成层。"
    primary: null
    identity: "optional"
    children:
      - "overlay.text"
      - "overlay.image"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
  schema #s_overlay_text "overlay.text"
    summary: "确定性排版的文字图层。"
    primary: "value"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "value"
      type: "text"
      description: "要精确排版的文字。"
      required: true
      expression: false
    property "region"
      type: "list<number>"
      description: "归一化矩形。"
      required: true
      expression: false
    property "font"
      type: "text"
      description: "锁定字体绑定。"
      required: true
      expression: false
    property "font_px"
      type: "int"
      description: "字号。"
      required: true
      expression: false
    property "align"
      type: "text"
      description: "对齐方式。"
      required: false
      expression: false
      default: "left"
  schema #s_overlay_image "overlay.image"
    summary: "已存在图片合成层。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "src"
      type: "ref"
      description: "图片产物。"
      required: true
      expression: false
    property "region"
      type: "list<number>"
      description: "归一化矩形。"
      required: true
      expression: false
  schema #s_video "video"
    summary: "视频生成与合成规格。"
    primary: "label"
    identity: "required"
    children:
      - "track"
      - "require"
      - "review"
    unknown_properties: "reject"
    effects: []
    category: "spec"
    property "label"
      type: "text"
      description: "视频名称。"
      required: false
      expression: false
    property "size"
      type: "list<int>"
      description: "画幅。"
      required: true
      expression: false
    property "fps"
      type: "record<Ratio>"
      description: "帧率有理数。"
      required: true
      expression: false
    property "frames"
      type: "int"
      description: "总帧数。"
      required: true
      expression: false
  schema #s_track "track"
    summary: "视频/字幕/音轨。"
    primary: null
    identity: "required"
    children:
      - "shot"
      - "cue"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "kind"
      type: "text"
      description: "轨道类型。"
      required: true
      expression: false
      enum:
        - "video"
        - "subtitles"
        - "audio"
    property "overlap"
      type: "text"
      description: "同轨重叠处理。"
      required: false
      expression: false
      default: "forbid"
      enum:
        - "forbid"
        - "allow"
  schema #s_shot "shot"
    summary: "位于整数时间轴的镜头。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "start_frame"
      type: "int"
      description: "起始帧。"
      required: true
      expression: false
    property "frames"
      type: "int"
      description: "持续帧数。"
      required: true
      expression: false
    property "prompt"
      type: "text"
      description: "镜头意图。"
      required: true
      expression: false
    property "reference"
      type: "ref"
      description: "角色或产品参考。"
      required: false
      expression: false
  schema #s_cue "cue"
    summary: "字幕/音轨片段。"
    primary: "text"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "text"
      type: "text"
      description: "文字。"
      required: true
      expression: false
    property "start_frame"
      type: "int"
      description: "开始帧。"
      required: true
      expression: false
    property "frames"
      type: "int"
      description: "持续帧数。"
      required: true
      expression: false
  schema #s_audio "audio"
    summary: "音频规格。"
    primary: "label"
    identity: "required"
    children:
      - "require"
      - "review"
    unknown_properties: "reject"
    effects: []
    category: "spec"
    property "label"
      type: "text"
      description: "名称。"
      required: false
      expression: false
    property "text"
      type: "text"
      description: "朗读文字。"
      required: true
      expression: false
    property "voice_binding"
      type: "text"
      description: "合规声音绑定，不假定已获克隆许可。"
      required: true
      expression: false
    property "sample_rate"
      type: "int"
      description: "采样率。"
      required: true
      expression: false
    property "channels"
      type: "int"
      description: "声道数。"
      required: true
      expression: false
  schema #s_deck "deck"
    summary: "可编辑演示文稿规格。"
    primary: "label"
    identity: "required"
    children:
      - "slide"
      - "require"
      - "review"
    unknown_properties: "reject"
    effects: []
    category: "spec"
    property "label"
      type: "text"
      description: "演示名称。"
      required: false
      expression: false
    property "ratio"
      type: "text"
      description: "画幅比例。"
      required: true
      expression: false
    property "editable"
      type: "bool"
      description: "对象可编辑要求。"
      required: true
      expression: false
    property "design"
      type: "ref"
      description: "共享设计系统。"
      required: false
      expression: false
      targets:
        - "design"
  schema #s_slide "slide"
    summary: "一页幻灯片。"
    primary: "title"
    identity: "required"
    children:
      - "slide.text"
      - "slide.image"
      - "slide.chart"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "title"
      type: "text"
      description: "页面标题。"
      required: true
      expression: false
    property "layout"
      type: "text"
      description: "锁定布局名。"
      required: true
      expression: false
    property "notes"
      type: "text"
      description: "演讲备注。"
      required: false
      expression: false
  schema #s_slide_text "slide.text"
    summary: "幻灯片文字对象。"
    primary: "value"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "value"
      type: "text"
      description: "文字内容。"
      required: true
      expression: false
  schema #s_slide_image "slide.image"
    summary: "幻灯片图片。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "src"
      type: "ref"
      description: "实际图片或任务产物。"
      required: true
      expression: false
    property "alt"
      type: "text"
      description: "图片说明。"
      required: true
      expression: false
  schema #s_slide_chart "slide.chart"
    summary: "有真实数据的图表。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "kind"
      type: "text"
      description: "图表类型。"
      required: true
      expression: false
    property "data"
      type: "list<record>"
      description: "图表数据；缺失不能臆造。"
      required: true
      expression: false
    property "editable"
      type: "bool"
      description: "是否要求原生可编辑图表。"
      required: true
      expression: false
  schema #s_generate "generate"
    summary: "把规格转成实际产物的任务。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "model.generate"
    category: "declaration"
    property "from"
      type: "ref"
      description: "规格节点。"
      required: true
      expression: false
      targets:
        - "image"
        - "text"
        - "video"
        - "audio"
        - "deck"
        - "design.canvas"
        - "document.spec"
    property "phase"
      type: "text"
      description: "执行阶段。"
      required: true
      expression: false
      enum:
        - "build"
        - "explicit_runtime"
    property "output"
      type: "text"
      description: "输出媒体类型。"
      required: true
      expression: false
    property "binding"
      type: "text"
      description: "实际生成/合成适配器。"
      required: true
      expression: false
    property "limits"
      type: "record<CallLimits>"
      description: "时间、次数与费用预算。"
      required: true
      expression: false
    property "approval"
      type: "text"
      description: "外部生成授权。"
      required: true
      expression: false
      enum:
        - "required"
    port "output"
      type: "Artifact"
      phase: "execution"
  rule #rule_AIGC_CONTRACT "AIGC_CONTRACT"
    level: "MUST"
    statement: |
      Spec、Generator、Task、Artifact、Slot 不可隐式互换。@generate.output 仅建立依赖；读取文件、预览、检查或页面重绘不得自动触发生成或收费。
    verification: "type-effect-runtime"
    origin: "conversation-design"
  rule #rule_AIGC_GATES "AIGC_GATES"
    level: "MUST"
    statement: |
      require 为注册检查，prefer 为偏好，review 为评审。不能把硬要求悄悄降级成 prompt；适配器不支持时报告 UNSUPPORTED_CAPABILITY。生成结果必须本地验证且绑定证据。
    verification: "adapter-validation"
    origin: "conversation-design"
  rule #rule_AIGC_TIMELINE "AIGC_TIMELINE"
    level: "MUST"
    statement: |
      视频时间用整数帧及有理数帧率；检查边界与重叠。editable deck 的文字/图表不能用整页截图冒充。字体和输入资产必须锁定且有使用权。
    verification: "artifact-validation"
    origin: "conversation-design"
