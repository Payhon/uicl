uicl "1.0"

profile #profile_hybrid "推断、生成槽位与沙箱子应用"
  id: "uicl.hybrid"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    模型判断与确定性分派分离，动态区域有边界。
  requires:
    - "uicl.core@1.0.0"
    - "uicl.ui@1.0.0"
    - "uicl.backend@1.0.0"
    - "uicl.aigc@1.0.0"
    - "uicl.agent@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "dispatch"
    - "generator"
    - "infer"
    - "ui"
    - "wasm"
  schema #s_generator "generator"
    summary: "可复用的有类型生成能力。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "input"
      type: "record"
      description: "输入形状。"
      required: true
      expression: false
    property "output"
      type: "text|ref"
      description: "Artifact 或命名类型。"
      required: true
      expression: false
    property "binding"
      type: "text"
      description: "实现绑定。"
      required: true
      expression: false
    property "instructions"
      type: "text"
      description: "生成意图。"
      required: true
      expression: false
    property "limits"
      type: "record<CallLimits>"
      description: "预算。"
      required: true
      expression: false
    property "constraints"
      type: "record"
      description: "由输出 Profile 校验的约束记录。"
      required: true
      expression: false
    property "sandbox"
      type: "record"
      description: "需要代码执行时，完整隔离要求。"
      required: false
      expression: false
    port "output"
      type: "dynamic"
      phase: "execution"
  schema #s_ui_slot "ui.slot"
    summary: "可装入生成产物的动态区域。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "generator"
      type: "ref"
      description: "生成器。"
      required: true
      expression: false
      targets:
        - "generator"
    property "args"
      type: "record"
      description: "输入。"
      required: true
      expression: true
    property "trigger"
      type: "text"
      description: "显式或用户事件触发。"
      required: true
      expression: false
      enum:
        - "explicit"
    property "fallback"
      type: "ref"
      description: "普通阅读时可用的既有资源。"
      required: true
      expression: false
    property "response_policy"
      type: "text"
      description: "响应版本策略。"
      required: false
      expression: false
      default: "latest_wins"
      enum:
        - "latest_wins"
  schema #s_infer "infer"
    summary: "模型推断节点，只把结果作为数据。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "model.infer"
    category: "declaration"
    property "using"
      type: "ref"
      description: "有类型能力/Agent/生成器。"
      required: true
      expression: false
      targets:
        - "capability"
        - "agent"
        - "generator"
    property "args"
      type: "record"
      description: "输入。"
      required: true
      expression: true
    property "on_error"
      type: "ref"
      description: "固定失败动作。"
      required: true
      expression: false
      targets:
        - "action"
    port "result"
      type: "dynamic"
      phase: "execution"
  schema #s_dispatch "dispatch"
    summary: "固定白名单分派。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "value"
      type: "value"
      description: "枚举推断值。"
      required: true
      expression: true
    property "routes"
      type: "record"
      description: "枚举文字到已声明动作的映射。"
      required: true
      expression: false
    property "on_unknown"
      type: "ref"
      description: "未识别值/非法输出路径。"
      required: true
      expression: false
      targets:
        - "action"
  schema #s_wasm_sandbox "wasm.sandbox"
    summary: "Wasm 实例化契约，不是任意源码的安全保证。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "sandbox.execute"
    category: "declaration"
    property "artifact"
      type: "ref"
      description: "已编译验证的 Wasm 产物。"
      required: true
      expression: false
    property "interface"
      type: "text"
      description: "宿主接口版本。"
      required: true
      expression: false
    property "imports"
      type: "list<text>"
      description: "允许导入白名单。"
      required: true
      expression: false
    property "network"
      type: "text"
      description: "网络权限。"
      required: true
      expression: false
      enum:
        - "deny"
    property "filesystem"
      type: "text"
      description: "文件权限。"
      required: true
      expression: false
      enum:
        - "deny"
    property "memory_mib"
      type: "int"
      description: "内存上限。"
      required: true
      expression: false
    property "fuel"
      type: "int"
      description: "执行步数预算。"
      required: true
      expression: false
    property "timeout_ms"
      type: "int"
      description: "墙钟超时。"
      required: true
      expression: false
    property "max_nesting"
      type: "int"
      description: "嵌套深度。"
      required: true
      expression: false
    property "approval"
      type: "text"
      description: "实例化外部授权。"
      required: true
      expression: false
      enum:
        - "required"
  rule #rule_HYBRID_INFER "HYBRID_INFER"
    level: "MUST"
    statement: |
      模型只提供通过本地类型检查的数据。dispatch 映射固定且必须覆盖枚举或显式 unknown；不得接受模型给出的任意函数/命令。timeout/refusal/非法值进入错误路径。
    verification: "type-runtime"
    origin: "conversation-design"
  rule #rule_HYBRID_UI "HYBRID_UI"
    level: "MUST"
    statement: |
      动态 UI 限定允许组件、最大节点/深度、可绑定数据与动作。Wasm 必须经过编译、类型、导入与测试检查；宿主仍负责权限和资源限制。
    verification: "adapter-runtime"
    origin: "conversation-design"
