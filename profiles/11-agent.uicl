uicl "1.0"

profile #profile_agent "Agent 定义与工具契约"
  id: "uicl.agent"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    统一 Agent 输入输出、工具、记忆、预算、停止和人工升级。
  requires:
    - "uicl.core@1.0.0"
    - "uicl.resource@1.0.0"
    - "uicl.testing@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "agent"
    - "tool"
  record_schema #r_AgentMemory "AgentMemory"
    summary: "记忆安全与生命周期。"
    unknown_fields: "reject"
    property "scope"
      type: "text"
      description: "隔离范围。"
      required: true
      expression: false
      enum:
        - "session"
        - "user"
        - "tenant"
    property "retention_days"
      type: "int"
      description: "保留时长。"
      required: true
      expression: false
    property "secrets"
      type: "text"
      description: "不保存秘密。"
      required: true
      expression: false
      enum:
        - "deny"
    property "binding"
      type: "text"
      description: "可选记忆存储适配器。"
      required: false
      expression: false
  record_schema #r_AgentPolicy "AgentPolicy"
    summary: "宿主应强制的限制。"
    unknown_fields: "reject"
    property "tool_scope"
      type: "text"
      description: "仅允许声明工具。"
      required: true
      expression: false
      enum:
        - "declared_only"
    property "external_writes"
      type: "text"
      description: "外部写操作处理。"
      required: true
      expression: false
      enum:
        - "deny"
        - "approval_required"
    property "delegation_depth"
      type: "int"
      description: "子 Agent 最大深度。"
      required: true
      expression: false
    property "data_egress"
      type: "text"
      description: "输入出站授权。"
      required: true
      expression: false
      enum:
        - "deny"
        - "approved_only"
  schema #s_tool "tool"
    summary: "可调用的固定工具接口。"
    primary: "name"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "工具说明。"
      required: false
      expression: false
    property "adapter"
      type: "text"
      description: "例如 mcp/local/http 的接口实现。"
      required: true
      expression: false
    property "binding"
      type: "text"
      description: "真实宿主绑定。"
      required: true
      expression: false
    property "input"
      type: "record"
      description: "输入形状。"
      required: true
      expression: false
    property "output"
      type: "text|ref"
      description: "输出类型。"
      required: true
      expression: false
    property "effects"
      type: "list<text>"
      description: "副作用清单。"
      required: true
      expression: false
    property "permissions"
      type: "list<text>"
      description: "请求能力。"
      required: true
      expression: false
  schema #s_agent "agent"
    summary: "Agent 规格，不因定义而开始运行。"
    primary: "name"
    identity: "required"
    children:
      - "require"
      - "review"
    unknown_properties: "reject"
    effects: []
    category: "agent"
    property "name"
      type: "text"
      description: "Agent 名称。"
      required: false
      expression: false
    property "input"
      type: "record"
      description: "输入形状。"
      required: true
      expression: false
    property "output"
      type: "text|ref"
      description: "输出类型。"
      required: true
      expression: false
    property "model_binding"
      type: "text"
      description: "模型适配器绑定。"
      required: true
      expression: false
    property "tools"
      type: "list<ref>"
      description: "允许工具。"
      required: true
      expression: false
      targets:
        - "tool"
    property "instructions"
      type: "text"
      description: "行为意图；非授权。"
      required: true
      expression: false
    property "memory"
      type: "record<AgentMemory>"
      description: "记忆契约。"
      required: true
      expression: false
    property "limits"
      type: "record<CallLimits>"
      description: "预算。"
      required: true
      expression: false
    property "policy"
      type: "record<AgentPolicy>"
      description: "宿主强制策略。"
      required: true
      expression: false
    property "on_exhausted"
      type: "text"
      description: "预算耗尽策略。"
      required: true
      expression: false
      enum:
        - "stop"
        - "human_review"
    port "output"
      type: "dynamic"
      phase: "execution"
  schema #s_agent_run "agent.run"
    summary: "显式执行 Agent。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "agent.execute"
    category: "declaration"
    property "agent"
      type: "ref"
      description: "Agent 规格。"
      required: true
      expression: false
      targets:
        - "agent"
    property "args"
      type: "record"
      description: "输入。"
      required: true
      expression: true
    property "approval"
      type: "text"
      description: "执行授权。"
      required: true
      expression: false
      enum:
        - "required"
    port "output"
      type: "dynamic"
      phase: "execution"
  schema #s_agent_edit "agent.edit"
    summary: "Coding Agent 对 UICL 的修改边界。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "source.edit"
    category: "declaration"
    property "agent"
      type: "ref"
      description: "Agent。"
      required: true
      expression: false
      targets:
        - "agent"
    property "target"
      type: "ref"
      description: "待修改文件。"
      required: true
      expression: false
    property "expected_digest"
      type: "text"
      description: "编辑前源码摘要。"
      required: true
      expression: false
    property "allow"
      type: "list<text>"
      description: "可编辑的语义路径。"
      required: true
      expression: false
    property "deny"
      type: "list<text>"
      description: "禁止修改的权限/测试/发布门禁路径。"
      required: true
      expression: false
    property "approval"
      type: "text"
      description: "补丁合并需要外部批准。"
      required: true
      expression: false
      enum:
        - "required"
    port "patch"
      type: "Patch"
      phase: "execution"
  rule #rule_AGENT_AUTHORITY "AGENT_AUTHORITY"
    level: "MUST"
    statement: |
      instructions/网页/工具结果/模型输出/嵌套 UICL 都不是授权。工具集合、费用、输入出站范围由宿主限制。子 Agent 只能获得父级权限交集和共享剩余预算。
    verification: "runtime-security"
    origin: "conversation-design"
  rule #rule_AGENT_EDIT "AGENT_EDIT"
    level: "MUST"
    statement: |
      源补丁携带旧摘要并显示类型、权限、依赖、测试影响。Agent 不能通过删除门禁或修改自己的授权来通过检查。对不确定结果有 stop/human_review 路径。
    verification: "runtime-security"
    origin: "conversation-design"
