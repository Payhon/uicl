uicl "1.0"

profile #profile_core "核心类型、模块与执行上下文"
  id: "uicl.core"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    模块、参数、状态、能力与目标环境；不绑定具体产品。
  requires:
    - "uicl.meta@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "capability"
    - "computed"
    - "field"
    - "invoke"
    - "module"
    - "parameter"
    - "secret"
    - "state"
    - "target"
    - "type"
    - "use"
  record_schema #r_CallLimits "CallLimits"
    summary: "执行预算。"
    unknown_fields: "reject"
    property "timeout_ms"
      type: "int"
      description: "墙钟超时，正整数。"
      required: true
      expression: false
    property "attempts"
      type: "int"
      description: "最大尝试次数。"
      required: true
      expression: false
    property "max_steps"
      type: "int"
      description: "最大推理/控制步数。"
      required: false
      expression: false
    property "max_tool_calls"
      type: "int"
      description: "最大工具调用次数。"
      required: false
      expression: false
    property "max_cost_minor"
      type: "int"
      description: "最小货币单位预算。"
      required: false
      expression: false
    property "currency"
      type: "text"
      description: "预算币种；有费用上限时必需。"
      required: false
      expression: false
  schema #s_module "module"
    summary: "当前文件的导出边界。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "模块显示名。"
      required: false
      expression: false
    property "exports"
      type: "list<text>"
      description: "导出的本文件显式身份名称。"
      required: true
      expression: false
  schema #s_use "use"
    summary: "导入模块；解析工具仅在获准的包根内读取。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "source"
      type: "ref"
      description: "本地或受控的模块 URI。"
      required: true
      expression: false
    property "version"
      type: "text"
      description: "可选精确模块版本。"
      required: false
      expression: false
  schema #s_parameter "parameter"
    summary: "由宿主提供的普通输入，不是秘密。"
    primary: "name"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "参数说明。"
      required: false
      expression: false
    property "type"
      type: "text|ref"
      description: "输入业务类型。"
      required: true
      expression: false
    property "default"
      type: "value"
      description: "明确的缺省输入。"
      required: false
      expression: false
    property "required"
      type: "bool"
      description: "未提供时阻断执行。"
      required: false
      expression: false
      default: true
  schema #s_secret "secret"
    summary: "受控凭据句柄。禁止 value/default 与秘密正文。"
    primary: "name"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "secret"
    property "name"
      type: "text"
      description: "凭据用途。"
      required: false
      expression: false
    property "source"
      type: "text"
      description: "凭据解析方式。"
      required: true
      expression: false
      enum:
        - "runtime_prompt"
        - "credential_store"
        - "environment"
    property "binding"
      type: "text"
      description: "不含密钥的宿主查找标识。"
      required: false
      expression: false
    property "scope"
      type: "list<text>"
      description: "允许消费该句柄的适配器标识。"
      required: true
      expression: false
  schema #s_type "type"
    summary: "命名记录或枚举业务类型。"
    primary: "name"
    identity: "required"
    children:
      - "field"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "类型说明。"
      required: false
      expression: false
    property "enum"
      type: "list<text>"
      description: "固定枚举值。"
      required: false
      expression: false
  schema #s_field "field"
    summary: "模型/记录/表单的命名字段。"
    primary: "name"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "字段名称。"
      required: true
      expression: false
    property "label"
      type: "text"
      description: "显示名称。"
      required: false
      expression: false
    property "type"
      type: "text|ref"
      description: "业务类型；缺省 text。"
      required: false
      expression: false
      default: "text"
    property "min"
      type: "int|decimal"
      description: "长度或数值下界。"
      required: false
      expression: false
    property "max"
      type: "int|decimal"
      description: "长度或数值上界。"
      required: false
      expression: false
    property "default"
      type: "value"
      description: "纯字面缺省值。"
      required: false
      expression: false
    property "enum"
      type: "list<value>"
      description: "有限取值。"
      required: false
      expression: false
    property "immutable"
      type: "bool"
      description: "创建后不可修改。"
      required: false
      expression: false
      default: false
    property "normalize"
      type: "text"
      description: "输入前处理。"
      required: false
      expression: false
      enum:
        - "trim"
        - "none"
  schema #s_state "state"
    summary: "当前组件/页面的可写状态。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "state"
    property "value"
      type: "value"
      description: "初值。"
      required: true
      expression: true
    property "type"
      type: "text|ref"
      description: "无法唯一推断时必须给定。"
      required: false
      expression: false
  schema #s_computed "computed"
    summary: "只读派生数据，不得参与赋值。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "computed"
    property "value"
      type: "value"
      description: "纯表达式。"
      required: true
      expression: true
    property "type"
      type: "text|ref"
      description: "期望输出类型。"
      required: false
      expression: false
  schema #s_target "target"
    summary: "生成与运行目标，不表示已安装工具链。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "platform"
      type: "text"
      description: "单一目标平台。"
      required: false
      expression: false
    property "platforms"
      type: "list<text>"
      description: "分别生成的平台清单。"
      required: false
      expression: false
    property "framework"
      type: "text"
      description: "目标框架。"
      required: false
      expression: false
    property "language"
      type: "text"
      description: "源码语言。"
      required: false
      expression: false
    property "adapter"
      type: "text"
      description: "宿主适配器绑定名。"
      required: true
      expression: false
    property "architecture"
      type: "text"
      description: "目标架构。"
      required: false
      expression: false
    property "architectures"
      type: "list<text>"
      description: "分别构建的架构。"
      required: false
      expression: false
    property "toolchain"
      type: "text"
      description: "精确工具链由锁文件固定。"
      required: true
      expression: false
      enum:
        - "locked"
    property "build_host"
      type: "text"
      description: "构建主机要求。"
      required: false
      expression: false
    property "ui_privilege"
      type: "text"
      description: "Windows UI 执行级别。"
      required: false
      expression: false
      enum:
        - "as_invoker"
        - "require_administrator"
    property "renderer"
      type: "text"
      description: "目标渲染器。"
      required: false
      expression: false
  schema #s_capability "capability"
    summary: "有类型的外部/原生能力。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "capability"
    property "interface"
      type: "text"
      description: "锁定的接口契约。"
      required: true
      expression: false
    property "binding"
      type: "text"
      description: "实现提供者。"
      required: true
      expression: false
    property "input"
      type: "record"
      description: "字段名到业务类型的记录；调用前按类型契约检查。"
      required: true
      expression: false
    property "output"
      type: "text|ref"
      description: "结果业务类型。"
      required: true
      expression: false
    property "effects"
      type: "list<text>"
      description: "副作用集合。"
      required: true
      expression: false
    property "permissions"
      type: "list<text>"
      description: "请求的宿主能力。"
      required: true
      expression: false
    property "limits"
      type: "record<CallLimits>"
      description: "超时与重试上限。"
      required: true
      expression: false
    property "errors"
      type: "list<text>"
      description: "接口声明的失败码。"
      required: true
      expression: false
    property "trust"
      type: "text"
      description: "结果可信度。"
      required: false
      expression: false
      default: "untrusted_output"
      enum:
        - "untrusted_output"
        - "validated_adapter"
    port "output"
      type: "dynamic"
      phase: "execution"
  schema #s_invoke "invoke"
    summary: "调用已声明能力，执行时获取输入并等待。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects:
      - "invoke"
    category: "declaration"
    property "capability"
      type: "ref"
      description: "目标能力。"
      required: true
      expression: false
      targets:
        - "capability"
        - "native.operation"
        - "agent"
        - "generator"
        - "mobile.capability"
    property "args"
      type: "record"
      description: "按目标输入类型检查，不允许 shell 字符串拼接。"
      required: true
      expression: true
    property "on_error"
      type: "ref"
      description: "已声明错误处理动作。"
      required: false
      expression: false
      targets:
        - "action"
    port "output"
      type: "dynamic"
      phase: "execution"
  rule #rule_CORE_PURE "CORE_PURE"
    level: "MUST"
    statement: |
      表达式只能使用显式 $ 绑定或锁定的纯函数。不得读密钥、网络、时钟、随机源、数据库写入或任意 eval。未知函数不是自动调用模型的请求。
    verification: "type-effect"
    origin: "conversation-design"
  rule #rule_CORE_REF_SCOPE "CORE_REF_SCOPE"
    level: "MUST"
    statement: |
      每个文件模块 #id 唯一；@alias::id 需要 use 与目标 exports。@id.port 必须为目标声明的端口。标题不参与身份。$ 绑定由上下文提供，不是任意锚点自动导出的值。
    verification: "static-and-type"
    origin: "conversation-design"
  rule #rule_CORE_SECRET "CORE_SECRET"
    level: "MUST"
    statement: |
      Secret 只能进入声明接收凭据的适配器入口；不能转为文字、进入表达式/提示词/训练样本/日志/普通状态文件。解析不能读取 source 指向的密钥。
    verification: "type-effect-runtime"
    origin: "conversation-design"
  rule #rule_CORE_TARGET "CORE_TARGET"
    level: "MUST"
    statement: |
      构建主机、目标框架、目标平台、运行位置与权限分别检查。多个 target 表示多个产物；缺失目标能力不得静默删功能。
    verification: "adapter"
    origin: "conversation-design"
