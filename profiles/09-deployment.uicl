uicl "1.0"

profile #profile_deployment "构建、受管资源与部署计划"
  id: "uicl.deployment"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    不可变产物、受管状态、计划、外部授权及执行回执。
  requires:
    - "uicl.core@1.0.0"
    - "uicl.resource@1.0.0"
    - "uicl.testing@1.0.0"
  origin: "scenario-review-and-1.0-completion"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "build"
    - "deployment"
    - "execution"
    - "managed"
    - "plan"
  record_schema #r_PlanState "PlanState"
    summary: "持久受管状态。"
    unknown_fields: "reject"
    property "binding"
      type: "text"
      description: "状态存储绑定名，不含秘密。"
      required: true
      expression: false
    property "locking"
      type: "text"
      description: "并发应用锁。"
      required: true
      expression: false
      enum:
        - "required"
    property "encryption"
      type: "text"
      description: "状态加密要求。"
      required: false
      expression: false
      default: "required"
  schema #s_build "build"
    summary: "由源契约生成不可变产物的任务声明。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "build.execute"
    category: "declaration"
    property "source"
      type: "ref"
      description: "源契约或源码。"
      required: true
      expression: false
    property "target"
      type: "ref"
      description: "目标工具链。"
      required: true
      expression: false
      targets:
        - "target"
    property "artifact_type"
      type: "text"
      description: "产物类型。"
      required: true
      expression: false
    property "embed"
      type: "list<ref>"
      description: "明确嵌入的其他构建输出。"
      required: false
      expression: false
    property "toolchain_binding"
      type: "text"
      description: "执行时解析的工具链锁。"
      required: true
      expression: false
    property "depends_on"
      type: "list<ref>"
      description: "显式计划前置依赖；兄弟声明顺序不代表部署顺序。"
      required: false
      expression: false
    property "entrypoint"
      type: "text"
      description: "输出包内应用入口，由目标适配器验证。"
      required: false
      expression: false
    property "static_mount"
      type: "text"
      description: "嵌入静态产物的应用 URL 前缀，由锁定适配器实现。"
      required: false
      expression: false
    port "output"
      type: "Artifact"
      phase: "execution"
  schema #s_managed_resource "managed.resource"
    summary: "通用受管资源抽象的标准入口；提供方扩展需给 schema。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "managed-resource"
    property "provider"
      type: "text"
      description: "适配器。"
      required: true
      expression: false
    property "external_id"
      type: "text"
      description: "接管已有资源时的真实 ID。"
      required: false
      expression: false
    property "desired"
      type: "record"
      description: "提供方验证的期望状态。"
      required: true
      expression: false
    property "managed_fields"
      type: "list<text>"
      description: "明确管理的字段。"
      required: true
      expression: false
    property "on_remove"
      type: "text"
      description: "删除策略。"
      required: true
      expression: false
      enum:
        - "retain"
        - "approval_required"
    property "import_policy"
      type: "text"
      description: "已有资源接管规则。"
      required: true
      expression: false
      enum:
        - "require_import"
    property "depends_on"
      type: "list<ref>"
      description: "显式计划前置依赖；兄弟声明顺序不代表部署顺序。"
      required: false
      expression: false
  schema #s_deployment "deployment"
    summary: "将期望状态解析成计划，不自动 apply。"
    primary: "name"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "deploy.apply"
    category: "declaration"
    property "name"
      type: "text"
      description: "环境名。"
      required: false
      expression: false
    property "resources"
      type: "list<ref>"
      description: "受管资源集合。"
      required: true
      expression: false
    property "state"
      type: "record<PlanState>"
      description: "状态与锁。"
      required: true
      expression: false
    property "existing_resources"
      type: "text"
      description: "碰到已有对象的规则。"
      required: true
      expression: false
      enum:
        - "require_import"
    property "approval"
      type: "text"
      description: "计划应用需外部批准。"
      required: true
      expression: false
      enum:
        - "required"
    property "gates"
      type: "list<ref>"
      description: "必需通过的测试/检查。"
      required: false
      expression: false
    port "plan"
      type: "Plan"
      phase: "execution"
    port "record"
      type: "ExecutionRecord"
      phase: "execution"
  schema #s_plan "plan"
    summary: "可审阅的执行计划元记录。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "subject"
      type: "ref"
      description: "部署/迁移/生成任务。"
      required: true
      expression: false
    property "expected_state"
      type: "text"
      description: "被观察状态版本摘要。"
      required: true
      expression: false
    property "steps"
      type: "list<record>"
      description: "有依赖、前置/后置与恢复分类的步骤。"
      required: true
      expression: false
    property "approval_binding"
      type: "text"
      description: "外部批准服务引用，不是批准本身。"
      required: true
      expression: false
  schema #s_execution_record "execution.record"
    summary: "持久执行回执。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "plan_digest"
      type: "text"
      description: "实际计划摘要。"
      required: true
      expression: false
    property "state"
      type: "text"
      description: "执行状态。"
      required: true
      expression: false
      enum:
        - "PENDING"
        - "RUNNING"
        - "SUCCEEDED"
        - "FAILED"
        - "INDETERMINATE"
        - "CANCELLED"
    property "steps"
      type: "list<record>"
      description: "逐步骤回执与观察到的外部 ID。"
      required: true
      expression: false
    property "secrets"
      type: "text"
      description: "只允许 redact。"
      required: true
      expression: false
      enum:
        - "redact"
  rule #rule_DEPLOY_PLAN "DEPLOY_PLAN"
    level: "MUST"
    statement: |
      observe/plan/apply 分开。仅管理显式接管的资源与字段，不因源码缺失而删除外部对象。应用计划时核对状态版本、锁和外部审批，漂移必须重新计划。
    verification: "planner-runtime"
    origin: "scenario-review-and-1.0-completion"
  rule #rule_DEPLOY_RECOVERY "DEPLOY_RECOVERY"
    level: "MUST"
    statement: |
      部分成功保留外部身份和回执。网络中断/超时可能 INDETERMINATE，先 observe/reconcile，不盲目重复副作用。应用、结构、数据恢复分别声明。
    verification: "runtime"
    origin: "scenario-review-and-1.0-completion"
  rule #rule_DEPLOY_SINGLE_OWNER "DEPLOY_SINGLE_OWNER"
    level: "MUST"
    statement: |
      同一资源或字段只有一个明确管理者；生成配置是派生文件，不与控制台/其他工具独立维护同一字段事实来源。批准与签名不是源码字段自我授予。
    verification: "planner-runtime"
    origin: "scenario-review-and-1.0-completion"
