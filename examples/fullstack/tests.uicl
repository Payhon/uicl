uicl "1.0"

module #tests_module
  exports: [create_visible, no_cross_user_update]
use #req
  source: @"./requirements.uicl"
use #ui
  source: @"./ui.uicl"
use #backend
  source: @"./backend.uicl"

test #create_visible "创建后看到新待办"
  kind: e2e
  verifies: [@req::create_note]
  isolation: ephemeral
  given
    test.reset
      resource: @backend::Task
    test.actor
      id: "user-a"
      roles: []
    test.open
      page: @ui::home
  when
    test.fill
      target: @ui::editor
      field: title
      value: "买咖啡"
    test.submit
      target: @ui::editor
  then
    expect
      target: @ui::entries
      contains: "买咖啡"
      count: 1

test #no_cross_user_update "用户 B 不能修改用户 A 的待办"
  kind: security
  verifies: [@req::private_notes]
  isolation: ephemeral
  given
    test.reset
      resource: @backend::Task
    test.fixture
      model: @backend::Task
      rows:
        - id: "00000000-0000-4000-8000-000000000001"
          title: "属于 A"
          done: false
          owner: "user-a"
          version: 1
          created_at: "2026-09-20T00:00:00Z"
          updated_at: "2026-09-20T00:00:00Z"
    test.actor
      id: "user-b"
      roles: []
  when
    test.execute #attempt
      action: @backend::complete_task
      args:
        id: "00000000-0000-4000-8000-000000000001"
        version: 1
  then
    expect
      target: @attempt.result
      error: "NOT_FOUND_OR_FORBIDDEN"
