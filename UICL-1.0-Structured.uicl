uicl "1.0"

// Generated structured edition. Edit canonical sources, then rebuild.

// source: meta/core-rules.uicl
document #core_rules "UICL Core 规范性条款"
  version: "1.0"
  status: "consolidated-specification"
  authority: "从 spec/UICL-1.0.uicl 派生的规则镜像，不替代完整领域验证。"

rule #core_IDENTITY "UICL_IDENTITY"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "最终命名与品牌分离讨论"
  statement: |
    名称、版本与地位
    
    语言名称为 **UICL**，英文全称 **Universal Intent and Contract Language**，中文为“通用意图与契约语言”，标准文件后缀为 `.uicl`。结构化版本头为 `uicl "1.0"`。Semaquil 是一种实现及工具品牌，不是语言、文件格式或唯一解析器。
    
    本文件是前述 AML 0.1/0.2/0.3/1.0、Semaquil 候选、原生文档方案、块式集合、品牌分离以及五类平台场景的 **1.0 整合规范基线**。文档定稿与运行时成熟度分离：本包的 Profile 版本为 `1.0.0`、编辑状态为 `consolidated-draft`，不表示已经完成独立实现互操作认证。
    
    语言、Profile、适配器、模型绑定、工具链和产品版本分别管理。不得因 Semaquil 升级而无条件要求用户修改 UICL 文件。

rule #core_SCOPE "UICL_SCOPE"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    目标与非目标
    
    UICL 统一描述：已有内容、期望结果、允许的处理、输入输出、依赖、验证方式、外部资源和执行回执。它面向内容生成、文件表示、应用开发、Agent、基础设施与训练数据交换。
    
    Core 不负责定义所有平台 API，也不是通用算法语言。无法用已注册领域契约直接描述的算法，可以通过有类型的源码、工具或沙箱组件接入；不能把未定义词汇交给模型临时解释后执行。
    
    “场景完备”指已声明范围内的输入、状态、错误、权限、副作用和恢复有明确处理，不表示模型结果一定正确、所有文件格式都可语义理解、任何平台都已获得支持。

rule #core_AUTHORITY "UICL_AUTHORITY"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "1.0 编辑细化"
  statement: |
    规范组成与解释顺序
    
    `spec/UICL-1.0.uicl` 是 Core 与整体语义的阅读规范；`meta/grammar.uicl` 与 `spec/Layout-1.uicl` 是结构语法与布局契约；`profiles/*.uicl` 是字段、主文本槽位、子节点、端口和领域规则的规范源。`guides/`、`.md` 副本、JSON 索引和 EBNF 是派生阅读材料。
    
    MUST=必须，MUST_NOT=禁止，SHOULD=建议，MAY=允许。Core 不可被 Profile 放宽。领域语义可以收紧已允许的行为，但不能改变标点和类型基础规则。同版规范源之间发现冲突须报告 `SPEC_CONFLICT`，不得任意选用有利于执行的一份。
    
    中文 `rule.statement` 是规范性正文，不会仅凭存在就自动编译为验证器。`schema/property/record_schema` 是可由工具读取的结构约束。未实现的领域检查必须报告 `NOT_EVALUATED`。

rule #core_ARCHITECTURE "UICL_ARCHITECTURE"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    四层结构与多入口
    
    表达层：结构化 UICL、Markdown 承载、HTML 承载、类型化 JSON/YAML 交换。契约层：身份、类型、表达式、引用、依赖、授权、效果和证据。领域层：版本化 Profile。适配层：源码生成、宿主 API、格式导出、数据库、模型和部署工具。
    
    所有受支持入口必须进入相同的类型、权限与效果规则。不能通过换用 JSON、Markdown 或某个适配器，绕过结构化入口禁止的操作。纯文档、纯数据库和纯服务无须包进 app。

rule #core_DOCUMENT_MODES "UICL_DOCUMENT_MODES"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    文件模式与检测
    
    结构化文档以 `uicl "1.0"` 开始，至少含一个节点。Markdown 文档以独立注释 `<!-- uicl:markdown 1.0 -->` 标识；HTML 在 head 中以真实注释 `<!-- uicl:html 1.0 -->` 标识。
    
    可信调用方可显式选择宿主模式，并与文档标记交叉检查。无标记旧文档只能被动导入，不自动激活契约。标记重复、版本不支持、模式冲突或 Core 解析失败必须报告错误，不得自动退回 Markdown。后缀是工具提示，不是执行授权。

rule #core_LEXICAL "UICL_LEXICAL"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    编码、缩进、标识符与注释
    
    文件采用 UTF-8，可带开头 BOM。读取 LF/CRLF；逻辑值换行按各文本规则处理，但编辑器保留原始字节。无效 Unicode、未配对代理项、NUL 和裸 CR 在结构化输入中拒绝。
    
    结构缩进每级两个空格，不接受 Tab 自动转换，也不允许跳级。原文块内部的 Tab 属于内容。空行和独立 `//` 注释不产生条目。不支持行末注释、分号或一行多个节点。
    
    标识符是 `[A-Za-z_][A-Za-z0-9_]*`，QName 为点连接的标识符。显示内容支持 Unicode。颜色写成双引号字符串；# 只定义身份。中文化编辑器可以使用锁定词典，不允许模型按同义词猜测字段。

rule #core_NODES "UICL_NODES"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    节点与渐进主文本
    
    完整形式：`种类 [#身份] [主文本] [(属性: 值, ...)]`，后接缩进的属性和子节点。初学者只需“种类、文字、属性、缩进”。行内属性是快捷形式，长配置优先展开。
    
    每个 schema 声明零个或一个 `primary` 槽位。位置主文本必须展开到该普通属性：app/page 为 title，ui.text 为 value，ui.button 为 label，field/input 为 name。image 的主文本是 label，不是 prompt。
    
    同一属性无论出现在块头还是块体，只能出现一次；主文本与其显式属性并存，即使值相同也报 `PRIMARY_CONFLICT`。未声明 primary 的种类不接受主文本。子节点顺序是语义的一部分。

rule #core_VALUE_CONTEXT "UICL_VALUE_CONTEXT"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    节点和值的边界
    
    `theme` 开始节点，`theme:` 开始属性值。Node 体允许属性与子节点；对象值体仅允许键值对；数组体仅允许列表项。首个非空非注释项决定块式值是列表还是记录，不允许混合。
    
    记录里的 `kind: button` 仅是数据，不创建按钮，不带任何执行能力。键名中的点是普通键的一部分，不像某些配置语言那样自动展开嵌套表。JSON/YAML 导入也必须保留这个区别。

rule #core_COLLECTIONS "UICL_COLLECTIONS"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    块式数组与对象
    
    数组既可以写成 `[read, create]`，也可以写成缩进的 `- read`、`- create`。二者产生相同的有序列表。记录可用 `{mode: system}` 或缩进键值对。重复对象键报错；数组元素可以重复。
    
    每个列表 `-` 必须后接空格或换行。`- -10` 表示负数元素。`- name: value` 开始紧凑记录，后续字段与 name 对齐；单独 `-` 后必须有一个更深的非空集合。`[]`、`{}`、`null` 分别表示空列表、空对象、空值；空的 `items:` 报错。
    
    行内 []、{}、() 和表达式均不跨物理行，不接受尾随逗号。长数据使用块式集合。`items: $tasks` 与 `items: [$tasks]` 不等价，后者不自动扁平化。

rule #core_SCALARS "UICL_SCALARS"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    标量、原文与围栏
    
    双引号字符串使用 JSON 风格转义；不提供单引号和模板字符串。简单裸词在值位置是文字，仅 true/false/null 为相应字面量。日期、URI、单位、颜色和币种不自动推断类型。
    
    `|` 文本块去掉固定内容缩进，逻辑换行用 LF；非空文本去掉多余尾部空行并保留一个末尾 LF。空文本使用 `""`。反引号围栏长度至少三，关闭长度与缩进必须匹配；内容含同长关闭符时选择更长围栏。
    
    原文中不解释 @、#、$、// 或节点。源码语言标签不授权运行。需要保留 BOM、非法字节、CRLF 或末尾字节差异时使用 bytes/原始文件资源，而不是依赖文本值。

rule #core_IDENTIFIERS "UICL_IDENTIFIERS"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    身份、作用域、导入与端口
    
    每个文件是一个模块身份域，所有显式 #id 在该文件内唯一，嵌套不自动产生新的同名模块。匿名节点可以有当前构建内的临时身份，但不能根据行号、内容或序号声称跨编辑稳定。
    
    `module #m` 的 exports 明确导出身份；`use #alias` 的 source 指向模块 URI；`@alias::id` 只能访问导出身份。`@id.port` 必须匹配 schema 声明的端口。相对模块 URI 以声明文件为基址；依赖版本与摘要进入锁文件。
    
    引用图、值依赖图与任务依赖图分别校验。实体关系可以有循环，构建/值求值不得形成无法终止的循环。包内原型保守拒绝循环导入；完整实现可对明确支持的非执行循环另行声明。

rule #core_BINDINGS "UICL_BINDINGS"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "既有语义及 1.0 绑定细化"
  statement: |
    @ 句柄与 $ 数据
    
    @count 是声明/可写句柄，$count 是当前值。只有被 Profile 明确规定的节点才导出运行绑定：state/computed 为页面数据；resource 为查询快照；let/create/update/call/invoke/infer 的有名结果仅在相应顺序作用域之后可见。
    
    动作输入使用 $input，身份使用 $actor，query 使用 $row，policy 使用 $row/$old/$new，组件使用 $props，事件使用 $event。标准 list 模板提供只读 $item；each/for 的 as 提供局部行名。query 行、props 和 actor 不能赋值。保留上下文不可被局部变量遮蔽。
    
    端口引用表示依赖或结果句柄，不自动触发任务，不意味着任务已经执行成功。值的可用阶段须经过检查。

rule #core_TYPE_SYSTEM "UICL_TYPE_SYSTEM"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    类型系统
    
    基础类型为 text、int、decimal、bool、null、unit；领域类型包括 id、date、instant、duration、bytes。组合包括可空类型 T?、list<T>、map<text,T>、记录、枚举和 @命名类型。
    
    int 为有符号 64 位整数；运算溢出必须报错。int 与 decimal 不隐式混算，字符串不自动变成数字/日期，真假值不自动转换。空列表或 null 无法唯一确定业务类型时，必须从属性契约取得类型或显式声明。
    
    形状层的 `value` 表示任意已解析 Core 值，不代表运行时 Any。`record` 表示仍需目标输入契约检查的记录。Profile 中 `dynamic` 输出端口必须根据具体 action/generator 等实例化为确定类型；实例化失败不能发布。
    
    Secret、Spec<T>、Artifact<T>、Generator<I,O>、Task<T>、Slot<T>、ManagedResource、Plan、Evidence 等语义对象不可因 JSON 形状相似而互换。

rule #core_NUMERIC "UICL_NUMERIC"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "1.0 编辑细化：此前未冻结的数值及跨端字符串细节"
  statement: |
    精确数值与文字处理
    
    十进制运行基线以有限值 c×10^e 表示，|c| 的十进制数字不超过 34 位，e 范围为 [-6176, 6111]。零统一为 0。求值结果必须能精确落在该集合，否则返回精度/范围错误，不得暗中转成二进制浮点。该系数/指数形式是对旧稿“decimal128 范围”方向的本次显式冻结，不表示本包已实现数值运行时。
    
    Core 不提供隐式舍入的 /。除法通过 round_div(a,b,scale,mode) 明确小数位和舍入方式，mode 为 half_even、half_up、toward_zero、floor 或 ceiling；零分母报错。% 仅作用于 int，商向零截断。NaN 和 Infinity 不属于 Core。
    
    text 长度以 Unicode 标量数量计，不以 UTF-16 代码单元、字节或可见字形数计。trim 的去除集合固定为 U+0009..000D、0020、0085、00A0、1680、2000..200A、2028、2029、202F、205F、3000，不依赖宿主库当前默认。text 不自动 Unicode 规范化。

rule #core_EXPRESSIONS "UICL_EXPRESSIONS"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    表达式、纯函数与优先级
    
    只有复合表达式使用 =，单独 $binding 是表达式简写。支持纯函数调用、成员/可空访问、索引、列表/记录构造、比较、布尔与空值合并。运算符从低到高：??、or、and、not、比较/in、+ -、* %、一元 -、访问/调用。?? 右结合，and/or/?? 短路；比较链禁止，必须显式 and。
    
    函数注册表的基线包括 len、trim、str、int、decimal、abs、min、max、sum、contains、starts_with、ends_with、round_div。签名和错误必须固定；无隐式时钟、随机、网络、密钥或 eval。添加纯函数需锁定版本与资源预算，不允许不可信 Profile 自称纯函数后获得副作用权限。
    
    表达式 AST 与源文分别保留。语法解析通过不代表 $ 绑定存在、类型匹配或函数已经实现；这三项是语义编译器的独立检查。

rule #core_RESOURCE_MODEL "UICL_RESOURCE_MODEL"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "资源讨论与五场景验证"
  statement: |
    资源、产物与受管状态
    
    Resource 包含身份、位置、媒体类型、版本、摘要和访问要求。Artifact 是实际存在、可通过摘要固定的不可变内容。ManagedResource 是外部环境中有稳定身份、可观察状态和管理范围的对象，例如表、云数据库、服务或主机配置。
    
    Spec 表达期望；Plan 描述从观察状态到期望状态的变更；ExecutionRecord 记录真实尝试和结果。文件缺少某个外部对象不表示可以删除它。资源 URI 说明位置，不授予访问权限，哈希说明完整性而非作者身份。
    
    @"./asset.png"、@"file:///C:/Reports/a.pdf"、@"https://example.org/a" 保持统一 URI 入口。appres/artifact 等宿主代理 URI 仅为本项目约定，需要真实 resolver；不声称已注册公共协议。

rule #core_FILE_FORMS "UICL_FILE_FORMS"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    任意文件的三种表示
    
    原生文本承载保留 Python、Go、PHP、TypeScript、JSON、XML、TOML、YAML、Markdown 等源码及其原有语言含义。原始字节承载能够精确表示任何有限文件，包括可执行文件、库、专有二进制和媒体，但不包含文件系统外部元数据。
    
    语义投影由指定适配器产生，声明覆盖范围、已知损失、源摘要和编辑事实来源。没有适配器只报告不透明资源。修改投影必须生成新产物；只有实际字节往返验证才能声称 byte_exact。
    
    不因加载文件定义而加载 DLL、运行源码、连接数据库或向模型发送文件。

rule #core_HEXL "UICL_HEXL"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    HEXL/1 分行字节协议
    
    HEXL 保持独立版本 1。首行为 !hexl 1 encoding chunk_bytes；数据行为 16 位小写十六进制原始偏移:载荷；尾行为 !end total_bytes line_count sha256:原始字节摘要。支持 hex、base64、base64url、base32。
    
    先按固定原始字节数分块，再逐块独立编码/解码。推荐块长 48，基线上限 1 MiB。非末块必须满长，末块非空，空文件无数据行。偏移从零连续；拒绝重复、缺失、乱序、非法字符、非规范 pad bits、长度或摘要不符、尾部额外非空数据。
    
    base64 使用规范填充；base64url/base32 在本协议使用无填充形式；hex 小写。最终验证前的字节不可信，应写临时文件；验证完成后原子发布。摘要不替代签名。协议不是压缩，也不承诺随机块独立认证。

rule #core_MD_HOST "UICL_MD_HOST"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    Markdown 文档承载
    
    Markdown 基线固定为 CommonMark 0.31.2，其他方言/扩展须明确锁定。标记之后正文按宿主语言阅读；将 .uicl 改为 .md 不修改字节。兼容目标是指定方言的正文静态格式，而不是所有阅读器或字体环境的像素一致。
    
    独立的 <!-- uicl 换行… --> 注解岛保存 Core 节点片段，继承版本和文档模块作用域。只在文档级列 0 的独立块边界启用。Markdown 的 #、-、@、$ 和反引号保持正文意义。普通 aml/uicl 代码围栏只是示例，绝不因此执行。
    
    无标记旧 Markdown 只能经显式 host=markdown 被动导入；不能用任意文本都可为 Markdown 的特点掩盖损坏的结构化源码。

rule #core_HTML_HOST "UICL_HTML_HOST"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    HTML 与编码载体
    
    HTML 标记位于真实 head 注释中，保留 doctype、charset、原始 HTML/CSS。通过 doc.block target:{html_id:...} 精确绑定已有 ID；缺失或重复 ID 报错。长契约可用 <script type="text/plain" data-uicl>，其载荷是完整结构化文档，不作为 JavaScript。
    
    HTML 注释和 script 都有自己的结束边界。需要时使用 <!-- uicl:base64url ... --> 或 script data-uicl-encoding="base64url"，对完整 UTF-8 载荷一次编码再折行。此算法与 HEXL 的逐块编码不同；必须严格验证字母表、pad bits、大小和 UTF-8。
    
    不可见不是秘密，编码不是加密。原生 HTML 预览和禁脚本的安全预览分别声明；任意脚本可能观察新增节点，服务器 MIME、自身 URL 或第三方清理也可能影响行为，不能承诺绝对透明。

rule #core_DOC_EDITING "UICL_DOC_EDITING"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    正文绑定与无损编辑
    
    next 绑定注解后第一个同级内容块，忽略空白与已识别注解，不进行相似度搜索。正文位置变化导致绑定变化必须显示给作者。HTML ID 按宿主原始字符串匹配，不强行改为 UICL 标识符。
    
    正文是当前发布内容唯一事实源。契约保存意图、约束、资源和变更计划，不保存第二份可独立编辑正文。生成先输出候选与证据，再经批准替换正文。普通阅读器始终显示当前已发布内容。
    
    工具保存原始字节、宿主 CST/AST、Core AST 和双向源码映射。无操作保存字节一致，补丁外保持原样；格式化必须显式选择范围。机器补丁带预期摘要，冲突时重新规划，不覆盖他人修改。

rule #core_PROFILE_PROTOCOL "UICL_PROFILE_PROTOCOL"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    Profile 定义协议
    
    每个 Profile 必须有 id、version、core、status、summary、requires、origin、implementation、namespaces。每个节点 schema 定义 kind、primary、identity、允许子项、unknown_properties=reject、category、effects、属性与端口。
    
    property 定义形状类型、required、default、expression、enum、targets 与明确语义。record_schema 定义封闭的记录字段。对安全敏感配置不得仅使用未定义对象然后让 Agent 猜规则。generic record/value 的最终契约要由适用业务或适配器补齐，缺失时执行计划不可批准。
    
    Profile 版本精确锁定，依赖无冲突；新增破坏性 primary、默认值、字段含义或执行效果必须升级并迁移。同名标准节点不能被扩展重新解释。扩展不存在不影响被动保存源文，但使用该扩展的主动目标不能执行。

rule #core_PROFILE_CATALOG "UICL_PROFILE_CATALOG"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    标准领域目录与渐进加载
    
    本版目录包含 Meta、Core、Resource、Design、UI、Backend、Application、PostgreSQL、Testing、Deployment、AIGC、Agent、Hybrid、Document、Dataset、Native、Mobile、Cloudflare、Host、Lifecycle 共 20 个 Profile。
    
    标准目录版本固定后，普通作者不需要手写所有 import。工具必须报告实际上启用的 Profile 及适配器能力。目录中出现一个字段不意味着每个实现已经支持它；未知必需能力不能静默忽略。
    
    目录定义了跨领域内容槽位，例如 then 可在测试中包含 expect、UI 容器可包含 if。安装的完整组合必须满足所有实际使用的 schema；不能借助宽泛的子项模式加载未注册节点。平台 .akml/.svml 是兼容 Profile 组合，不另改 Core。

rule #core_APPLICATION "UICL_APPLICATION"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    渐进应用与组合规则
    
    L0 静态展示，L1 状态事件，L2 collection/form/list，L3 model/query/action/policy/workflow/capability。它们是学习层级，不是四种文件格式。
    
    只有隐式 UI 子项而无 page 的 app 按基础 recipe 生成 home 和 /；显式 page 与隐式首页混用需先展开。collection 必须明确 storage=device/server，默认仅 read/create，不默认 update/delete。server 需要 owner 或完整 policy，以及真实可信身份绑定。
    
    form 自动生成输入、校验、提交状态和去重，list 提供加载、错误、空态和有界分页。默认行为须可展开审查。设备存储改云端存储属于有隐私与迁移影响的显式变更，禁止自动上传旧数据。

rule #core_DESIGN_UI "UICL_DESIGN_UI"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    设计、UI 与跨端一致性
    
    Design 包含 token、主题、样式、断点、语言与可访问性目标。视觉配置不得改变权限、数据类型或业务动作。editable 设计稿需保留指定图层/文字，不能用截图冒充。
    
    UI 是有序声明树。组件 props 为只读、有类型的输入；插槽是结构组合，不是代码注入。ui.input 仅绑定可写 state；on 内动作按顺序等待。表单成功后仅清空仍等于提交快照的输入，刷新失败不能把已成功写入误报为写失败。
    
    跨端首先保证功能、输入输出、错误和交互语义；像素一致作为独立视觉约束。a11y 字段是目标，只有实际验证证据才能证明达标。

rule #core_BACKEND "UICL_BACKEND"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    模型、策略与查询
    
    model 含 id、version、created_at、updated_at 系统字段，作者不能与其重名。新版本默认 version=1，成功更新后原子递增；时间与身份由受信运行时产生，不在纯表达式中读时钟/随机。
    
    模型所有操作默认拒绝。create 检查 new，update 检查 old/new，read 检查 row，delete 检查 old；actor 来自可信服务端。查询先应用策略，再排序、分页、计数和聚合，不能把全量数据交客户端过滤。
    
    query 必须给 select、稳定 order 和 page_size。接口显式暴露，存在 model/action 不自动产生公网 CRUD。身份错误与不可见对象可按安全策略统一报告 NOT_FOUND_OR_FORBIDDEN，避免泄漏存在性。

rule #core_ACTIONS "UICL_ACTIONS"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    动作、幂等、工作流与异常
    
    action 声明输入、输出、allow、transaction 和 idempotency。非 unit 的所有正常控制路径必须返回匹配类型；run 顺序等待前一步。for 有明确 max_items，调用图不得隐式无界递归。
    
    更新/删除检查 expect_version。事务只包含受管理数据库状态、约束和 outbox，不涵盖外部网络效果。幂等键绑定主体、动作、输入摘要和有效期；相同键不同输入拒绝。外部调用超时可能为 INDETERMINATE，对账前不得无条件重试。
    
    workflow 的状态字段只能经合法 transition 原子更新，转换授权与模型策略同时成立。一般 update 不得绕开状态机。失败路径不能仅靠自然语言“自动恢复”代替明确协议。

rule #core_DATABASE "UICL_DATABASE"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "五场景验证及本次结构化细化"
  statement: |
    数据库物理结构与迁移
    
    PostgreSQL Profile 独立于 app/model。pg.table 定义物理列、主键、外键、检查、索引与 RLS；pg.mapping 明确业务字段与系统字段映射。id_conversion=uuid_string 在本示例仅规范行身份转换，主体 owner 以不透明文本保存；适配器必须验证双方语义，不能暗中缩小类型范围。
    
    sql/default_sql/where_sql 为显式方言表达式，default 为字面值，两者不能混用。类型、引用、SQL 标识符、列存在性及具体数据库版本由适配器检查。
    
    迁移声明前后版本、事务策略、步骤、锁与超时。并发索引操作与 atomic=required 冲突；拆分必须显式。rename 不按字段名相似度猜测。RLS 要同时检查运行角色、所有者、BYPASSRLS 与租户会话恢复。结构回退和数据恢复分开。

rule #core_CONTENT "UICL_CONTENT"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    AIGC 与内容产物
    
    text/image/video/audio/deck/document.spec 等表示 Spec，不是实际文件。generate 表示计划；output 端口仅在成功执行后提供 Artifact。binding/模型/字体/声音/参考素材都需要真实宿主授权与锁定。
    
    require/check 是注册硬检查，prefer 是优化偏好，review/criterion 是需要评审的要求。字段写了主体数量不代表实际满足。适配器报告 native/postprocess/prompt-only/unsupported 支持方式，必需硬条件不能静默降级。
    
    视频采用整数帧与有理数帧率，检查镜头/字幕的边界与重叠。图片精确文字宜作为独立合成层。PPT editable=true 不允许整页截图替代文字/图表可编辑性。无事实数据时不得凭生成器补造表格或图表数据。

rule #core_AGENTS "UICL_AGENTS"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    Agent 与工具
    
    Agent 声明输入输出、固定工具、模型绑定、instructions、记忆、预算、宿主策略和耗尽后的停止/人工升级。MCP/HTTP/本地接口只是工具接入方式，不替代 Agent 执行契约。
    
    instructions 不是权限。网页、工具返回、附件、引用文件、模型输出和嵌套 UICL 都是不可信内容，不能自授权限。子 Agent 取得父级授权交集与共享剩余预算；秘密不能写入长期记忆。
    
    agent.edit 仅输出带来源摘要的候选补丁，不能自行扩大 allow、删除 deny、去掉测试或替代外部审批。解析、预览与生成始终是不同操作。

rule #core_HYBRID "UICL_HYBRID"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "混合程序讨论及 1.0 分派细化"
  statement: |
    模型判断与动态 UI
    
    执行语义分为纯计算、模型推断和外部效果，不按 CPU/GPU 决定语言含义。infer 输出经过本地类型验证；dispatch 映射枚举到预定义动作，不接收模型返回的任意函数名。
    
    本版固定 dispatch 为所在 action 的终端分派，返回被选动作结果；on_unknown 也是同返回类型的固定动作。infer.on_error 是包含 action 的终端错误处理，必须匹配包含 action 的输出类型，不伪造一个正常分类值。该处理规则是对前稿未完全冻结部分的显式编辑细化。
    
    ui.slot 显式触发，提供 fallback、输入和响应版本。旧结果不能覆盖新输入，卸载后不能回写。动态 ui.tree 限定组件、节点数、深度、数据与动作；不直接注入任意 HTML/JS。

rule #core_WASM "UICL_WASM"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    嵌套子应用与沙箱
    
    Wasm 是可选产物/执行目标，不是自动安全证明。实例化前必须有编译、类型、导入、资源上限、测试和外部审批证据。明确 interface、imports、内存、fuel、墙钟时间、网络、文件与 max_nesting。
    
    宿主只暴露已授权的 UI/事件或计算接口，组件不自动拥有 DOM、文件系统、网络或提权能力。生成应用嵌套生成应用共享预算，不能无限递归。没有实际适配器时只能保存规格和计划。

rule #core_TARGET_NATIVE "UICL_TARGET_NATIVE"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "五场景验证"
  statement: |
    Windows 与原生 API
    
    Target 分开指定构建主机、目标 OS、架构、框架/语言、渲染器和工具链。native.operation 定义接口、源码入口、输入输出、效果、线程、错误、对象白名单和恢复策略。
    
    UI 默认普通用户权限；系统修改通过受控 broker 和真实 OS 授权。IPC 校验调用方与操作对象。原生代码声明 effects 不构成隔离证明。句柄、回调和取消的生命周期须由接口明确。
    
    compare_and_set 恢复仅在当前值仍等于本次写入值时恢复旧值；外部已修改则返回冲突。本包的 C# 夹具故意抛出 NotSupported，不实际改变系统。

rule #core_TARGET_MOBILE "UICL_TARGET_MOBILE"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "五场景验证"
  statement: |
    uni-app x 与 React Native
    
    同一业务契约可以投影到多个独立工程。每个 target 固定框架/渲染器、SDK、架构、构建主机、签名和插件。实际共同能力取交集；不支持目标时要求显式分支或失败，不删除功能后假称跨端成功。
    
    mobile.permission 与 mobile.capability 分开描述权限状态、用户手势、拒绝/不可用路径、平台实现和生命周期。声明摄像头/蓝牙等能力不代表用户已授权。后台任务、系统杀进程、页面卸载、取消和重连都应由目标适配器证明对应语义。
    
    本规范定义适配接口，不声称具体版本的 uni-app x/React Native 具有任意目标能力。例子的平台清单只是期望，不是本包实际构建矩阵。

rule #core_MANAGED_DEPLOY "UICL_MANAGED_DEPLOY"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "五场景验证及 1.0 编辑细化"
  statement: |
    受管资源、部署与持久计划
    
    Managed Resource 必须有期望状态、外部身份、管理字段范围、接管方式与移除策略。observe 读取状态；plan 计算差异；apply 在核对计划摘要、观察版本、锁和外部批准后执行。
    
    数据资源默认 retain 或 approval_required，不能因源文删掉节点就删除生产数据库。depends_on 与值/资源绑定形成计划依赖，数组或兄弟节点顺序不等价于串行部署。
    
    每一步记录操作 ID、输入摘要、前置状态、后置状态、失败类别与恢复方式。部分成功保留回执和真实外部 ID；INDETERMINATE 必须先 reconcile。一次运行成功不替代下一次的漂移检查。

rule #core_CLOUDFLARE "UICL_CLOUDFLARE"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "五场景验证；非本轮平台在线验证"
  statement: |
    Cloudflare 领域
    
    Provider 区分账号 ID、token 句柄和适配器；资源层分别描述 Worker、R2、D1 和 Hyperdrive。绑定关系形成依赖。兼容日期是作者/锁文件的明确选择，不默认执行当天；账号、配额、区域、套餐和运行时能力由适配器检查。
    
    D1 与 PostgreSQL 不作为同一物理方言互换；需要 PostgreSQL 时显式绑定已有数据库连接方案。Worker 产物不能被当成任意 Linux 进程。
    
    同一资源/字段只有一个管理者。UICL 可以生成 Wrangler/Terraform 等配置，但不能把派生文件和控制台同时作为独立事实来源。重复 apply 复用外部 ID，已有资源需 import；缺失凭据不执行。

rule #core_SSH "UICL_SSH"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "五场景验证"
  statement: |
    ECS 与通用 SSH 发布
    
    已有 Linux ECS 的机器内部署属于通用 Host Profile。SSH 账户授权与创建 ECS/修改安全组等云控制面权限分离。IP、用户、认证、主机指纹、OS/架构、服务管理器与 sudo 前置条件都要明确。
    
    密码通过 secret/runtime_prompt 或凭据存储供认证适配器使用，不进入命令行、日志、模型上下文或构建缓存。host_key 必须 pinned 并核验可信指纹；变化时报错。sudo 凭据不得默认与 SSH 密码相同。
    
    发布采用临时版本目录、摘要校验、受控切换、健康检查和回执。断线不等于远端失败；重连先对账。previous_binary 只恢复程序版本，数据库无自动回滚。单机重启不宣称零停机。

rule #core_TESTING "UICL_TESTING"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    测试、评估与证据
    
    test 使用显式 kind、isolation、given/when/then。test.actor/fixture/reset 仅作用于隔离环境。定位用稳定身份；表单字段由 target+field 标识，不因改显示文字而失效。
    
    结构校验、语义检查、真实行为测试、生成式评估和人工审核是不同证据。状态为 PASS/FAIL/ERROR/NOT_EVALUATED；缺失检查不能视为 PASS。证据绑定被测产物、契约、验证器版本与输入摘要。
    
    本包包含测试声明，但没有执行应用的 E2E/安全测试。tools/tests 的 Python 结果只验证已实现的语法、形状、有限链接和字节封装功能，不能冒充那些业务测试已通过。

rule #core_OBSERVABILITY "UICL_OBSERVABILITY"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    观测与数据集
    
    日志、指标和追踪声明接收端、保留时间和 payloads=deny；没有授权接收端不上传。凭据、请求正文、完整模型上下文和其他敏感数据不进入默认遥测。
    
    Dataset 记录任务规格、原文/字节/投影、产物、来源组、许可、同意、敏感性和证据。格式开放不表示文件内容可用于训练。unknown/unverified 的权利状态阻断公开训练或再分发。
    
    同源 PDF、截图、译文、Markdown 与投影共享拆分组以防评估泄漏。存档可以文本封装，训练加载应恢复原生模态；性能提升需要实验，不由格式统一直接推导。

rule #core_IR_EXCHANGE "UICL_IR_EXCHANGE"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    类型化交换与摘要
    
    规范化节点由 kind、可选 identity、类型化 properties、有序 children 组成。主文本展开为普通属性。每个值带 tag；普通文字 "@logo" 与引用 @logo、原文表达式与已解析 expression AST 都是不同值。
    
    int/decimal 通过无损十进制表示传输，date/instant/bytes/ref 等有独立标签。record 键唯一且不定义业务顺序；list 和 children 保序。JSON/YAML 是这些有类型对象的承载，不是任意文件自动具有执行语义。
    
    sourceDigest、contractDigest、planDigest、artifactDigest、evidenceDigest 分别计算，并包含相关版本域。可变资源在构建前固定真实摘要；模板中的全零/占位摘要不能作为真实证据。本包 SHA256SUMS 仅用于交付文件一致性，不是签名。

rule #core_COMPILER "UICL_COMPILER"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    编译器阶段与一致性类别
    
    处理链：源码字节与宿主模式 → CST/AST → Profile/模块链接 → 名称/类型/纯函数与效果检查 → 确定性 recipe 展开 → Contract Graph → Plan → 外部授权 → 适配器 → 验证/评审 → Artifact/Evidence。
    
    解析器、形状检查器、语义编译器、运行时、代码生成器、编辑器、Agent 适配器分别声明实现类别和 Profile 覆盖。语法合法不等于可构建，可构建不等于已授权，已授权不等于产物通过验收。
    
    解释执行和代码生成须通过同一行为一致性向量。编译/检查不依赖模型在线；Agent 只是契约作者与受控执行参与者。默认展开有版本与来源映射，不由模型临场猜测。

rule #core_DIAGNOSTICS "UICL_DIAGNOSTICS"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    错误与编辑协议
    
    诊断包含 code、phase、source span、node/property path、相关位置、说明和可选修复。关键错误包括 SYNTAX、LAYOUT、MISSING_VALUE、DUPLICATE_KEY、PRIMARY_CONFLICT、UNRESOLVED_REF、TYPE_MISMATCH、UNSUPPORTED_CAPABILITY、EFFECT_DENIED、CONFLICT、INDETERMINATE。
    
    编辑器可以建议修复，但不得自动放宽权限、删除测试、关闭主机校验或上传数据来消除错误。对不可信输入的诊断须避免泄漏其他主体资源是否存在。跨模块改名维护 exports/imports，不以简单文本替换作为迁移协议。

rule #core_GOVERNANCE "UICL_GOVERNANCE"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "品牌与开放政策讨论；不新增法律结论"
  statement: |
    开放格式、品牌与授权方向
    
    UICL 是厂商中立的格式与规范；Semaquil 是一种实现。任何第三方都可以独立实现并选择自己的产品品牌和代码许可，不需要依赖 Semaquil 账户、模型或云服务。兼容声明必须写明版本与 Profile 范围。
    
    此前讨论的发布方向为：项目有权许可的规范/原创示例采用 CC0-1.0，开源基础代码采用 Apache-2.0，商标、贡献者专利承诺、第三方资料和用户文件权利分别处理。本包记录此发布计划，不替所有贡献者完成权利转让，也不捏造已经建立专利承诺或完成商标注册。
    
    原始参考稿保留来源且不被本包自动重新许可。用户保存为 .uicl 不表示公开、允许训练或将内容归 Semaquil 所有。发布前应由权利人落实许可文本与贡献流程。

rule #core_MIGRATION "UICL_MIGRATION"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    旧稿迁移与本次新增
    
    历史 AML/Semaquil 文件仍按其原版本解释，不能直接替换头部后当作本版。迁移依次解析旧语法、绑定旧槽位/默认规则、建立旧契约、应用显式转换、生成新文件、比较类型/权限/效果与测试影响。
    
    本版统一 uicl 名称与三种宿主标记；采用 YAML 式块集合；把 provider/SSH/native/PostgreSQL 候选词汇整理为 Profile；正式补入 Managed Resource、Plan、Execution Record 和 Secret 边界。新增依赖边、块体字段形状、绑定范围和分派路径在来源表标注为编辑细化，不冒充前稿全部已有实现。
    
    旧文件与旧测试成绩留作来源证据，不继承为 UICL 新实现的通过结果。

rule #core_IMPLEMENTATION "UICL_IMPLEMENTATION"
  level: "MUST"
  verification: "see-compiler-conformance"
  origin: "历史讨论与候选规范"
  statement: |
    本包实现范围与下一步验证
    
    本包提供结构化 Core 语法原型、读取 Profile 的形状检查、主文本展开、包内模块导出与引用身份/端口存在性检查、部分静态反例、宿主示例提取和 HEXL 编解码。实际测试结果以 reports/ 为准。
    
    尚未实现完整运行绑定类型推导、泛型端口兼容性、效果/权限证明、完整规则驱动解析器生成、跨平台 UI/后端/SQL/AIGC/Agent/Wasm 运行时或真实部署器。完整文档无损编辑器也未实现；仅保留原始文件并验证部分字节副本。
    
    正式互操作稳定性应由独立实现与真实平台基准验证。生成模型的图像/文字不要求逐字节相同，但类型、权限、约束处理、证据和错误必须符合相同契约。

// source: meta/grammar.uicl
grammar #core_grammar "UICL Structural Grammar"
  start: @g_Document
  input: "LAYOUT-1 产生的 token 流；布局侧条件属于规范的一部分。"
  status: consolidated_draft
  g.rule #g_Document "Document"
    g.seq
      g.ref
        target: @g_Header
      g.repeat
        min: 1
        max: null
        g.ref
          target: @g_Node
      g.token
        name: "EOF"
  g.rule #g_Header "Header"
    g.seq
      g.literal
        text: "uicl"
      g.token
        name: "STRING"
      g.token
        name: "NL"
  g.rule #g_Node "Node"
    g.seq
      g.ref
        target: @g_QName
      g.repeat
        min: 0
        max: 1
        g.seq
          g.literal
            text: "#"
          g.token
            name: "IDENT"
      g.repeat
        min: 0
        max: 1
        g.ref
          target: @g_Primary
      g.repeat
        min: 0
        max: 1
        g.ref
          target: @g_InlineProps
      g.token
        name: "NL"
      g.repeat
        min: 0
        max: 1
        g.seq
          g.token
            name: "INDENT"
          g.repeat
            min: 1
            max: null
            g.ref
              target: @g_NodeEntry
          g.token
            name: "DEDENT"
  g.rule #g_NodeEntry "NodeEntry"
    g.choice
      g.ref
        target: @g_Property
      g.ref
        target: @g_Node
  g.rule #g_Primary "Primary"
    g.choice
      g.token
        name: "STRING"
      g.ref
        target: @g_QName
  g.rule #g_Key "Key"
    g.choice
      g.token
        name: "STRING"
      g.ref
        target: @g_QName
  g.rule #g_QName "QName"
    g.seq
      g.token
        name: "IDENT"
      g.repeat
        min: 0
        max: null
        g.seq
          g.literal
            text: "."
          g.token
            name: "IDENT"
  g.rule #g_InlineProps "InlineProps"
    g.seq
      g.literal
        text: "("
      g.repeat
        min: 0
        max: 1
        g.seq
          g.ref
            target: @g_Pair
          g.repeat
            min: 0
            max: null
            g.seq
              g.literal
                text: ","
              g.ref
                target: @g_Pair
      g.literal
        text: ")"
  g.rule #g_Pair "Pair"
    g.seq
      g.ref
        target: @g_Key
      g.literal
        text: ":"
      g.ref
        target: @g_InlineValue
  g.rule #g_Property "Property"
    g.seq
      g.ref
        target: @g_Key
      g.literal
        text: ":"
      g.choice
        g.seq
          g.ref
            target: @g_InlineValue
          g.token
            name: "NL"
        g.seq
          g.token
            name: "RAW"
          g.token
            name: "NL"
        g.seq
          g.token
            name: "NL"
          g.token
            name: "INDENT"
          g.ref
            target: @g_BlockValue
          g.token
            name: "DEDENT"
  g.rule #g_InlineValue "InlineValue"
    g.choice
      g.seq
        g.literal
          text: "="
        g.ref
          target: @g_Expression
      g.ref
        target: @g_Reference
      g.ref
        target: @g_Binding
      g.ref
        target: @g_Literal
      g.ref
        target: @g_InlineList
      g.ref
        target: @g_InlineRecord
      g.ref
        target: @g_QName
  g.rule #g_Literal "Literal"
    g.choice
      g.token
        name: "STRING"
      g.ref
        target: @g_SignedNumber
      g.literal
        text: "true"
      g.literal
        text: "false"
      g.literal
        text: "null"
  g.rule #g_SignedNumber "SignedNumber"
    g.seq
      g.repeat
        min: 0
        max: 1
        g.literal
          text: "-"
      g.token
        name: "NUMBER"
  g.rule #g_InlineList "InlineList"
    g.seq
      g.literal
        text: "["
      g.repeat
        min: 0
        max: 1
        g.seq
          g.ref
            target: @g_InlineValue
          g.repeat
            min: 0
            max: null
            g.seq
              g.literal
                text: ","
              g.ref
                target: @g_InlineValue
      g.literal
        text: "]"
  g.rule #g_InlineRecord "InlineRecord"
    g.seq
      g.literal
        text: "{"
      g.repeat
        min: 0
        max: 1
        g.seq
          g.ref
            target: @g_Pair
          g.repeat
            min: 0
            max: null
            g.seq
              g.literal
                text: ","
              g.ref
                target: @g_Pair
      g.literal
        text: "}"
  g.rule #g_BlockValue "BlockValue"
    g.choice
      g.ref
        target: @g_BlockList
      g.ref
        target: @g_BlockRecord
  g.rule #g_BlockRecord "BlockRecord"
    g.repeat
      min: 1
      max: null
      g.ref
        target: @g_Property
  g.rule #g_BlockList "BlockList"
    g.repeat
      min: 1
      max: null
      g.ref
        target: @g_ListItem
  g.rule #g_ListItem "ListItem"
    g.seq
      g.token
        name: "ITEM_BEGIN"
      g.choice
        g.ref
          target: @g_BlockRecord
        g.seq
          g.ref
            target: @g_InlineValue
          g.token
            name: "NL"
        g.seq
          g.token
            name: "RAW"
          g.token
            name: "NL"
        g.seq
          g.token
            name: "NL"
          g.token
            name: "INDENT"
          g.ref
            target: @g_BlockValue
          g.token
            name: "DEDENT"
      g.token
        name: "ITEM_END"
  g.rule #g_Reference "Reference"
    g.seq
      g.literal
        text: "@"
      g.choice
        g.token
          name: "STRING"
        g.seq
          g.token
            name: "IDENT"
          g.repeat
            min: 0
            max: 1
            g.seq
              g.literal
                text: "::"
              g.token
                name: "IDENT"
          g.repeat
            min: 0
            max: null
            g.seq
              g.literal
                text: "."
              g.token
                name: "IDENT"
  g.rule #g_Binding "Binding"
    g.seq
      g.literal
        text: "$"
      g.token
        name: "IDENT"
      g.repeat
        min: 0
        max: null
        g.ref
          target: @g_Accessor
  g.rule #g_Accessor "Accessor"
    g.choice
      g.seq
        g.choice
          g.literal
            text: "."
          g.literal
            text: "?."
        g.token
          name: "IDENT"
      g.seq
        g.literal
          text: "["
        g.ref
          target: @g_Expression
        g.literal
          text: "]"
  g.rule #g_Expression "Expression"
    g.ref
      target: @g_Coalesce
  g.rule #g_Coalesce "Coalesce"
    g.seq
      g.ref
        target: @g_Or
      g.repeat
        min: 0
        max: 1
        g.seq
          g.literal
            text: "??"
          g.ref
            target: @g_Coalesce
  g.rule #g_Or "Or"
    g.seq
      g.ref
        target: @g_And
      g.repeat
        min: 0
        max: null
        g.seq
          g.literal
            text: "or"
          g.ref
            target: @g_And
  g.rule #g_And "And"
    g.seq
      g.ref
        target: @g_Not
      g.repeat
        min: 0
        max: null
        g.seq
          g.literal
            text: "and"
          g.ref
            target: @g_Not
  g.rule #g_Not "Not"
    g.choice
      g.seq
        g.literal
          text: "not"
        g.ref
          target: @g_Not
      g.ref
        target: @g_Compare
  g.rule #g_Compare "Compare"
    g.seq
      g.ref
        target: @g_Add
      g.repeat
        min: 0
        max: 1
        g.seq
          g.choice
            g.literal
              text: "=="
            g.literal
              text: "!="
            g.literal
              text: "<"
            g.literal
              text: "<="
            g.literal
              text: ">"
            g.literal
              text: ">="
            g.literal
              text: "in"
          g.ref
            target: @g_Add
  g.rule #g_Add "Add"
    g.seq
      g.ref
        target: @g_Multiply
      g.repeat
        min: 0
        max: null
        g.seq
          g.choice
            g.literal
              text: "+"
            g.literal
              text: "-"
          g.ref
            target: @g_Multiply
  g.rule #g_Multiply "Multiply"
    g.seq
      g.ref
        target: @g_Unary
      g.repeat
        min: 0
        max: null
        g.seq
          g.choice
            g.literal
              text: "*"
            g.literal
              text: "%"
          g.ref
            target: @g_Unary
  g.rule #g_Unary "Unary"
    g.choice
      g.seq
        g.literal
          text: "-"
        g.ref
          target: @g_Unary
      g.ref
        target: @g_Postfix
  g.rule #g_Postfix "Postfix"
    g.seq
      g.ref
        target: @g_Atom
      g.repeat
        min: 0
        max: null
        g.ref
          target: @g_Accessor
  g.rule #g_Atom "Atom"
    g.choice
      g.ref
        target: @g_Call
      g.seq
        g.literal
          text: "$"
        g.token
          name: "IDENT"
      g.ref
        target: @g_Reference
      g.token
        name: "STRING"
      g.token
        name: "NUMBER"
      g.literal
        text: "true"
      g.literal
        text: "false"
      g.literal
        text: "null"
      g.ref
        target: @g_ExprList
      g.ref
        target: @g_ExprRecord
      g.seq
        g.literal
          text: "("
        g.ref
          target: @g_Expression
        g.literal
          text: ")"
  g.rule #g_Call "Call"
    g.seq
      g.ref
        target: @g_QName
      g.literal
        text: "("
      g.repeat
        min: 0
        max: 1
        g.seq
          g.ref
            target: @g_Expression
          g.repeat
            min: 0
            max: null
            g.seq
              g.literal
                text: ","
              g.ref
                target: @g_Expression
      g.literal
        text: ")"
  g.rule #g_ExprList "ExprList"
    g.seq
      g.literal
        text: "["
      g.repeat
        min: 0
        max: 1
        g.seq
          g.ref
            target: @g_Expression
          g.repeat
            min: 0
            max: null
            g.seq
              g.literal
                text: ","
              g.ref
                target: @g_Expression
      g.literal
        text: "]"
  g.rule #g_ExprRecord "ExprRecord"
    g.seq
      g.literal
        text: "{"
      g.repeat
        min: 0
        max: 1
        g.seq
          g.ref
            target: @g_ExprPair
          g.repeat
            min: 0
            max: null
            g.seq
              g.literal
                text: ","
              g.ref
                target: @g_ExprPair
      g.literal
        text: "}"
  g.rule #g_ExprPair "ExprPair"
    g.seq
      g.ref
        target: @g_Key
      g.literal
        text: ":"
      g.ref
        target: @g_Expression

// source: profiles/00-meta.uicl
profile #profile_meta "Profile 与语言自描述"
  id: "uicl.meta"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    定义 Profile、节点形状、记录形状、规则、文法与示例。自描述不是无需受信引导器。
  requires: []
  origin: "1.0-editorial-completion"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "document"
    - "example"
    - "g"
    - "grammar"
    - "port"
    - "profile"
    - "property"
    - "record_schema"
    - "rule"
    - "schema"
  schema #s_profile "profile"
    summary: "领域注册单元；版本、依赖及节点语义必须显式。"
    primary: "title"
    identity: "required"
    children:
      - "schema"
      - "record_schema"
      - "rule"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "id"
      type: "text"
      description: "可解析的唯一 Profile 标识，不代表已经注册域名。"
      required: true
      expression: false
    property "version"
      type: "text"
      description: "精确的领域版本。"
      required: true
      expression: false
    property "core"
      type: "text"
      description: "所需 Core 版本。"
      required: true
      expression: false
    property "status"
      type: "text"
      description: "规范编辑状态，不是运行时认证。"
      required: true
      expression: false
    property "title"
      type: "text"
      description: "显示名称。"
      required: true
      expression: false
    property "summary"
      type: "text"
      description: "领域的目标与排除范围。"
      required: true
      expression: false
    property "requires"
      type: "list<text>"
      description: "依赖的 Profile 精确标识与版本。"
      required: true
      expression: false
    property "origin"
      type: "text"
      description: "来源或本次细化标识。"
      required: true
      expression: false
    property "implementation"
      type: "text"
      description: "本包仅结构检查，执行适配器的实现状态。"
      required: true
      expression: false
    property "namespaces"
      type: "list<text>"
      description: "所占用的节点前缀；不能改变 Core。"
      required: true
      expression: false
  schema #s_schema "schema"
    summary: "一个节点的结构契约，未知属性默认拒绝。"
    primary: "kind"
    identity: "required"
    children:
      - "property"
      - "port"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "kind"
      type: "text"
      description: "被定义的 QName。"
      required: true
      expression: false
    property "summary"
      type: "text"
      description: "节点的含义。"
      required: true
      expression: false
    property "primary"
      type: "text|null"
      description: "唯一主文本槽位；null 表示不接受。"
      required: true
      expression: false
    property "identity"
      type: "text"
      description: "身份要求。"
      required: true
      expression: false
      enum:
        - "required"
        - "optional"
        - "forbidden"
    property "children"
      type: "list<text>"
      description: "允许的子节点种类或已注册的命名空间模式。"
      required: true
      expression: false
    property "unknown_properties"
      type: "text"
      description: "基线固定 reject。"
      required: true
      expression: false
      enum:
        - "reject"
    property "effects"
      type: "list<text>"
      description: "可能出现的副作用分类，不等于授权。"
      required: true
      expression: false
    property "category"
      type: "text"
      description: "领域对象类别。"
      required: true
      expression: false
  schema #s_record_schema "record_schema"
    summary: "具名记录值的结构约束，不创建节点或权限。"
    primary: "name"
    identity: "required"
    children:
      - "property"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "记录类型名。"
      required: true
      expression: false
    property "summary"
      type: "text"
      description: "字段集合语义。"
      required: true
      expression: false
    property "unknown_fields"
      type: "text"
      description: "禁止未知字段。"
      required: true
      expression: false
      enum:
        - "reject"
  schema #s_property "property"
    summary: "一个属性的类型、必需性、默认值与表达式边界。"
    primary: "name"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "属性键。"
      required: true
      expression: false
    property "type"
      type: "text"
      description: "形状类型表达式。"
      required: true
      expression: false
    property "description"
      type: "text"
      description: "字段语义与边界。"
      required: true
      expression: false
    property "required"
      type: "bool"
      description: "是否必须出现。"
      required: true
      expression: false
    property "expression"
      type: "bool"
      description: "允许延后到业务类型检查的纯表达式。"
      required: true
      expression: false
    property "default"
      type: "value"
      description: "缺失时采用的确定性默认值；校验工具不自行注入。"
      required: false
      expression: false
    property "enum"
      type: "list<value>"
      description: "可接受的字面量集合。"
      required: false
      expression: false
    property "targets"
      type: "list<text>"
      description: "引用允许的节点种类；端口另按端口类型检查。"
      required: false
      expression: false
  schema #s_port "port"
    summary: "节点可引用的输出端口声明。"
    primary: "name"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "端口名称。"
      required: true
      expression: false
    property "type"
      type: "text"
      description: "业务输出类型。"
      required: true
      expression: false
    property "phase"
      type: "text"
      description: "编译时或执行后可用。"
      required: true
      expression: false
  schema #s_rule "rule"
    summary: "规范性规则及验证类别；正文不会自动执行。"
    primary: "code"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "code"
      type: "text"
      description: "跨版本稳定的规则标识。"
      required: true
      expression: false
    property "level"
      type: "text"
      description: "规范强度。"
      required: true
      expression: false
      enum:
        - "MUST"
        - "MUST_NOT"
        - "SHOULD"
        - "MAY"
    property "statement"
      type: "text"
      description: "完整规范正文。"
      required: true
      expression: false
    property "verification"
      type: "text"
      description: "所需验证种类。"
      required: true
      expression: false
    property "origin"
      type: "text"
      description: "历史基线、场景讨论或本次编辑细化。"
      required: true
      expression: false
  schema #s_grammar "grammar"
    summary: "结构化文法入口。"
    primary: "title"
    identity: "required"
    children:
      - "g.rule"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "title"
      type: "text"
      description: "文法名称。"
      required: true
      expression: false
    property "start"
      type: "ref"
      description: "起始产生式。"
      required: true
      expression: false
      targets:
        - "g.rule"
    property "input"
      type: "text"
      description: "token/布局契约说明。"
      required: true
      expression: false
    property "status"
      type: "text"
      description: "规范状态。"
      required: true
      expression: false
  schema #s_g_rule "g.rule"
    summary: "命名产生式。"
    primary: "name"
    identity: "required"
    children:
      - "g.seq"
      - "g.choice"
      - "g.repeat"
      - "g.ref"
      - "g.token"
      - "g.literal"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "规则名。"
      required: true
      expression: false
  schema #s_g_seq "g.seq"
    summary: "按顺序匹配全部子项。"
    primary: null
    identity: "optional"
    children:
      - "g.seq"
      - "g.choice"
      - "g.repeat"
      - "g.ref"
      - "g.token"
      - "g.literal"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
  schema #s_g_choice "g.choice"
    summary: "按声明顺序尝试；不能吞掉已确认的语义错误。"
    primary: null
    identity: "optional"
    children:
      - "g.seq"
      - "g.choice"
      - "g.repeat"
      - "g.ref"
      - "g.token"
      - "g.literal"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
  schema #s_g_repeat "g.repeat"
    summary: "在指定上下界重复一个子模式。"
    primary: null
    identity: "optional"
    children:
      - "g.seq"
      - "g.choice"
      - "g.ref"
      - "g.token"
      - "g.literal"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "min"
      type: "int"
      description: "最少次数。"
      required: true
      expression: false
    property "max"
      type: "int|null"
      description: "最多次数，null 为未指定语法上界；仍受实现资源限制。"
      required: true
      expression: false
  schema #s_g_ref "g.ref"
    summary: "引用本模块的文法规则。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "target"
      type: "ref"
      description: "目标产生式。"
      required: true
      expression: false
      targets:
        - "g.rule"
  schema #s_g_token "g.token"
    summary: "匹配词法器提供的 token。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "token 种类。"
      required: true
      expression: false
  schema #s_g_literal "g.literal"
    summary: "匹配固定文法文本。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "text"
      type: "text"
      description: "固定字面量。"
      required: true
      expression: false
  schema #s_example "example"
    summary: "显式记录可提取示例，不在读取阶段运行。"
    primary: "title"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "title"
      type: "text"
      description: "用例说明。"
      required: true
      expression: false
    property "path"
      type: "text"
      description: "包内相对源码位置。"
      required: true
      expression: false
    property "profiles"
      type: "list<text>"
      description: "涉及领域。"
      required: true
      expression: false
    property "readiness"
      type: "text"
      description: "执行准备状态。"
      required: true
      expression: false
    property "body"
      type: "text"
      description: "可选内嵌原文，必须与独立文件一致。"
      required: false
      expression: false
  schema #s_document "document"
    summary: "阅读文档元数据，不创建运行应用。"
    primary: "title"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "title"
      type: "text"
      description: "文档标题。"
      required: true
      expression: false
    property "version"
      type: "text"
      description: "规范版本。"
      required: true
      expression: false
    property "status"
      type: "text"
      description: "发布状态。"
      required: true
      expression: false
    property "authority"
      type: "text"
      description: "权限或标准机构声明边界。"
      required: true
      expression: false
  rule #rule_PROFILE_SELF_DESCRIPTION "PROFILE_SELF_DESCRIPTION"
    level: "MUST"
    statement: |
      Profile 是惰性数据。schema 可以限定本 Profile 的词汇，不能覆盖宿主的授权、Core 运算符、密钥隔离或其他已锁定 Profile。同名 schema/记录/依赖版本冲突必须拒绝。
    verification: "static"
    origin: "1.0-editorial-completion"
  rule #rule_PROFILE_BOOTSTRAP "PROFILE_BOOTSTRAP"
    level: "MUST"
    statement: |
      元规范仍需受信的最小解析器；本包检查器读取 schema/property/record_schema，文法 g.* 是自描述与可派生数据，未作为完整解析器自动生成依据。
    verification: "tooling"
    origin: "1.0-editorial-completion"

// source: profiles/01-core.uicl
profile #profile_core "核心类型、模块与执行上下文"
  id: "uicl.core"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    模块、参数、状态、能力与目标环境；不绑定具体产品。
  requires:
    - "uicl.meta@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "capability"
    - "computed"
    - "field"
    - "invoke"
    - "module"
    - "parameter"
    - "secret"
    - "state"
    - "target"
    - "type"
    - "use"
  record_schema #r_CallLimits "CallLimits"
    summary: "执行预算。"
    unknown_fields: "reject"
    property "timeout_ms"
      type: "int"
      description: "墙钟超时，正整数。"
      required: true
      expression: false
    property "attempts"
      type: "int"
      description: "最大尝试次数。"
      required: true
      expression: false
    property "max_steps"
      type: "int"
      description: "最大推理/控制步数。"
      required: false
      expression: false
    property "max_tool_calls"
      type: "int"
      description: "最大工具调用次数。"
      required: false
      expression: false
    property "max_cost_minor"
      type: "int"
      description: "最小货币单位预算。"
      required: false
      expression: false
    property "currency"
      type: "text"
      description: "预算币种；有费用上限时必需。"
      required: false
      expression: false
  schema #s_module "module"
    summary: "当前文件的导出边界。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "模块显示名。"
      required: false
      expression: false
    property "exports"
      type: "list<text>"
      description: "导出的本文件显式身份名称。"
      required: true
      expression: false
  schema #s_use "use"
    summary: "导入模块；解析工具仅在获准的包根内读取。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "source"
      type: "ref"
      description: "本地或受控的模块 URI。"
      required: true
      expression: false
    property "version"
      type: "text"
      description: "可选精确模块版本。"
      required: false
      expression: false
  schema #s_parameter "parameter"
    summary: "由宿主提供的普通输入，不是秘密。"
    primary: "name"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "参数说明。"
      required: false
      expression: false
    property "type"
      type: "text|ref"
      description: "输入业务类型。"
      required: true
      expression: false
    property "default"
      type: "value"
      description: "明确的缺省输入。"
      required: false
      expression: false
    property "required"
      type: "bool"
      description: "未提供时阻断执行。"
      required: false
      expression: false
      default: true
  schema #s_secret "secret"
    summary: "受控凭据句柄。禁止 value/default 与秘密正文。"
    primary: "name"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "secret"
    property "name"
      type: "text"
      description: "凭据用途。"
      required: false
      expression: false
    property "source"
      type: "text"
      description: "凭据解析方式。"
      required: true
      expression: false
      enum:
        - "runtime_prompt"
        - "credential_store"
        - "environment"
    property "binding"
      type: "text"
      description: "不含密钥的宿主查找标识。"
      required: false
      expression: false
    property "scope"
      type: "list<text>"
      description: "允许消费该句柄的适配器标识。"
      required: true
      expression: false
  schema #s_type "type"
    summary: "命名记录或枚举业务类型。"
    primary: "name"
    identity: "required"
    children:
      - "field"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "类型说明。"
      required: false
      expression: false
    property "enum"
      type: "list<text>"
      description: "固定枚举值。"
      required: false
      expression: false
  schema #s_field "field"
    summary: "模型/记录/表单的命名字段。"
    primary: "name"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "字段名称。"
      required: true
      expression: false
    property "label"
      type: "text"
      description: "显示名称。"
      required: false
      expression: false
    property "type"
      type: "text|ref"
      description: "业务类型；缺省 text。"
      required: false
      expression: false
      default: "text"
    property "min"
      type: "int|decimal"
      description: "长度或数值下界。"
      required: false
      expression: false
    property "max"
      type: "int|decimal"
      description: "长度或数值上界。"
      required: false
      expression: false
    property "default"
      type: "value"
      description: "纯字面缺省值。"
      required: false
      expression: false
    property "enum"
      type: "list<value>"
      description: "有限取值。"
      required: false
      expression: false
    property "immutable"
      type: "bool"
      description: "创建后不可修改。"
      required: false
      expression: false
      default: false
    property "normalize"
      type: "text"
      description: "输入前处理。"
      required: false
      expression: false
      enum:
        - "trim"
        - "none"
  schema #s_state "state"
    summary: "当前组件/页面的可写状态。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "state"
    property "value"
      type: "value"
      description: "初值。"
      required: true
      expression: true
    property "type"
      type: "text|ref"
      description: "无法唯一推断时必须给定。"
      required: false
      expression: false
  schema #s_computed "computed"
    summary: "只读派生数据，不得参与赋值。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "computed"
    property "value"
      type: "value"
      description: "纯表达式。"
      required: true
      expression: true
    property "type"
      type: "text|ref"
      description: "期望输出类型。"
      required: false
      expression: false
  schema #s_target "target"
    summary: "生成与运行目标，不表示已安装工具链。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "platform"
      type: "text"
      description: "单一目标平台。"
      required: false
      expression: false
    property "platforms"
      type: "list<text>"
      description: "分别生成的平台清单。"
      required: false
      expression: false
    property "framework"
      type: "text"
      description: "目标框架。"
      required: false
      expression: false
    property "language"
      type: "text"
      description: "源码语言。"
      required: false
      expression: false
    property "adapter"
      type: "text"
      description: "宿主适配器绑定名。"
      required: true
      expression: false
    property "architecture"
      type: "text"
      description: "目标架构。"
      required: false
      expression: false
    property "architectures"
      type: "list<text>"
      description: "分别构建的架构。"
      required: false
      expression: false
    property "toolchain"
      type: "text"
      description: "精确工具链由锁文件固定。"
      required: true
      expression: false
      enum:
        - "locked"
    property "build_host"
      type: "text"
      description: "构建主机要求。"
      required: false
      expression: false
    property "ui_privilege"
      type: "text"
      description: "Windows UI 执行级别。"
      required: false
      expression: false
      enum:
        - "as_invoker"
        - "require_administrator"
    property "renderer"
      type: "text"
      description: "目标渲染器。"
      required: false
      expression: false
  schema #s_capability "capability"
    summary: "有类型的外部/原生能力。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "capability"
    property "interface"
      type: "text"
      description: "锁定的接口契约。"
      required: true
      expression: false
    property "binding"
      type: "text"
      description: "实现提供者。"
      required: true
      expression: false
    property "input"
      type: "record"
      description: "字段名到业务类型的记录；调用前按类型契约检查。"
      required: true
      expression: false
    property "output"
      type: "text|ref"
      description: "结果业务类型。"
      required: true
      expression: false
    property "effects"
      type: "list<text>"
      description: "副作用集合。"
      required: true
      expression: false
    property "permissions"
      type: "list<text>"
      description: "请求的宿主能力。"
      required: true
      expression: false
    property "limits"
      type: "record<CallLimits>"
      description: "超时与重试上限。"
      required: true
      expression: false
    property "errors"
      type: "list<text>"
      description: "接口声明的失败码。"
      required: true
      expression: false
    property "trust"
      type: "text"
      description: "结果可信度。"
      required: false
      expression: false
      default: "untrusted_output"
      enum:
        - "untrusted_output"
        - "validated_adapter"
    port "output"
      type: "dynamic"
      phase: "execution"
  schema #s_invoke "invoke"
    summary: "调用已声明能力，执行时获取输入并等待。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects:
      - "invoke"
    category: "declaration"
    property "capability"
      type: "ref"
      description: "目标能力。"
      required: true
      expression: false
      targets:
        - "capability"
        - "native.operation"
        - "agent"
        - "generator"
        - "mobile.capability"
    property "args"
      type: "record"
      description: "按目标输入类型检查，不允许 shell 字符串拼接。"
      required: true
      expression: true
    property "on_error"
      type: "ref"
      description: "已声明错误处理动作。"
      required: false
      expression: false
      targets:
        - "action"
    port "output"
      type: "dynamic"
      phase: "execution"
  rule #rule_CORE_PURE "CORE_PURE"
    level: "MUST"
    statement: |
      表达式只能使用显式 $ 绑定或锁定的纯函数。不得读密钥、网络、时钟、随机源、数据库写入或任意 eval。未知函数不是自动调用模型的请求。
    verification: "type-effect"
    origin: "conversation-design"
  rule #rule_CORE_REF_SCOPE "CORE_REF_SCOPE"
    level: "MUST"
    statement: |
      每个文件模块 #id 唯一；@alias::id 需要 use 与目标 exports。@id.port 必须为目标声明的端口。标题不参与身份。$ 绑定由上下文提供，不是任意锚点自动导出的值。
    verification: "static-and-type"
    origin: "conversation-design"
  rule #rule_CORE_SECRET "CORE_SECRET"
    level: "MUST"
    statement: |
      Secret 只能进入声明接收凭据的适配器入口；不能转为文字、进入表达式/提示词/训练样本/日志/普通状态文件。解析不能读取 source 指向的密钥。
    verification: "type-effect-runtime"
    origin: "conversation-design"
  rule #rule_CORE_TARGET "CORE_TARGET"
    level: "MUST"
    statement: |
      构建主机、目标框架、目标平台、运行位置与权限分别检查。多个 target 表示多个产物；缺失目标能力不得静默删功能。
    verification: "adapter"
    origin: "conversation-design"

// source: profiles/02-resource.uicl
profile #profile_resource "文件、产物与任意字节"
  id: "uicl.resource"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    原文、字节与语义投影分别建模，引用不隐式执行。
  requires:
    - "uicl.core@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "artifact"
    - "bytes"
    - "file"
    - "projection"
  schema #s_file "file"
    summary: "现有文件的受控引用或内嵌原文。"
    primary: "label"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "resource"
    property "label"
      type: "text"
      description: "可读名称。"
      required: false
      expression: false
    property "source"
      type: "ref"
      description: "源 URI。"
      required: false
      expression: false
    property "media"
      type: "text"
      description: "媒体类型。"
      required: true
      expression: false
    property "body"
      type: "text"
      description: "内嵌原文，与 source 互斥。"
      required: false
      expression: false
    property "digest"
      type: "text"
      description: "原始字节摘要；实际值不能伪造。"
      required: false
      expression: false
    property "verification"
      type: "text"
      description: "需由构建锁固定真实摘要。"
      required: false
      expression: false
      enum:
        - "locked_digest"
    property "encoding"
      type: "text"
      description: "文本编码说明，不隐式转码。"
      required: false
      expression: false
  schema #s_bytes "bytes"
    summary: "内嵌 HEXL 或已有字节资源。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "resource"
    property "media"
      type: "text"
      description: "媒体类型。"
      required: true
      expression: false
    property "transport"
      type: "text"
      description: "独立字节封装协议。"
      required: true
      expression: false
      enum:
        - "hexl1"
    property "body"
      type: "text"
      description: "HEXL 原文。"
      required: true
      expression: false
  schema #s_projection "projection"
    summary: "绑定原始字节的语义投影。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "source"
      type: "ref"
      description: "来源文件。"
      required: true
      expression: false
      targets:
        - "file"
        - "bytes"
    property "adapter"
      type: "text"
      description: "投影适配器。"
      required: true
      expression: false
    property "fidelity"
      type: "text"
      description: "保真声明。"
      required: true
      expression: false
      enum:
        - "byte_exact"
        - "semantic"
        - "lossy"
    property "editable"
      type: "bool"
      description: "是否允许修改投影。"
      required: true
      expression: false
    property "known_loss"
      type: "list<text>"
      description: "已知损失，未知不能写无损。"
      required: true
      expression: false
    property "source_digest"
      type: "text"
      description: "执行时核验的来源摘要。"
      required: false
      expression: false
    port "output"
      type: "Projection"
      phase: "execution"
  schema #s_artifact "artifact"
    summary: "已经存在或外部交付的不可变产物。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "artifact"
    property "media"
      type: "text"
      description: "产物媒体类型。"
      required: true
      expression: false
    property "source"
      type: "ref"
      description: "产物 URI。"
      required: true
      expression: false
    property "digest"
      type: "text"
      description: "真实摘要或执行绑定前置条件。"
      required: false
      expression: false
    property "producer"
      type: "text"
      description: "来源执行回执标识。"
      required: false
      expression: false
  rule #rule_RESOURCE_BYTES "RESOURCE_BYTES"
    level: "MUST"
    statement: |
      原始字节可以承载任何有限文件，但不包括权限、目录关系、扩展属性等文件系统元数据。没有格式适配器只报告不透明资源；不能声称理解内部结构。
    verification: "codec-adapter"
    origin: "conversation-design"
  rule #rule_RESOURCE_URI "RESOURCE_URI"
    level: "MUST"
    statement: |
      相对 URI 以声明模块为基准。解析/编辑不打开任意资源；受控解析限制路径、协议、重定向、大小和递归。内容摘要不等于来源签名。
    verification: "resolver"
    origin: "conversation-design"
  rule #rule_RESOURCE_PROJECTION "RESOURCE_PROJECTION"
    level: "MUST"
    statement: |
      投影记录源摘要、适配器版本、损失和编辑事实来源。修改投影生成新产物；byte_exact 只能由字节往返验证证明。
    verification: "adapter"
    origin: "conversation-design"

// source: profiles/03-design.uicl
profile #profile_design "设计系统与设计稿"
  id: "uicl.design"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    设计 token、主题、样式、响应式、多语言与可编辑画布。
  requires:
    - "uicl.resource@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "a11y"
    - "design"
    - "style"
    - "theme"
  record_schema #r_Breakpoint "Breakpoint"
    summary: "响应式断点。"
    unknown_fields: "reject"
    property "name"
      type: "text"
      description: "断点名。"
      required: true
      expression: false
    property "min_width"
      type: "int"
      description: "最小逻辑宽度。"
      required: true
      expression: false
    property "columns"
      type: "int"
      description: "布局列数。"
      required: true
      expression: false
  schema #s_design "design"
    summary: "可复用设计系统。"
    primary: "label"
    identity: "required"
    children:
      - "theme"
      - "style"
      - "a11y"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "label"
      type: "text"
      description: "系统名称。"
      required: false
      expression: false
    property "preset"
      type: "text"
      description: "可选锁定预设。"
      required: false
      expression: false
    property "mode"
      type: "text"
      description: "主题模式。"
      required: false
      expression: false
      default: "system"
      enum:
        - "light"
        - "dark"
        - "system"
    property "tokens"
      type: "record"
      description: "分类的 token 值；类型由设计适配器校验。"
      required: true
      expression: false
    property "locales"
      type: "list<text>"
      description: "支持语言。"
      required: false
      expression: false
    property "breakpoints"
      type: "list<record<Breakpoint>>"
      description: "有序响应式规则。"
      required: false
      expression: false
    port "tokens"
      type: "DesignTokens"
      phase: "compile"
  schema #s_theme "theme"
    summary: "对基础 token 的主题覆盖。"
    primary: "name"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "主题名。"
      required: true
      expression: false
    property "tokens"
      type: "record"
      description: "覆盖相同 token 类型，不改变权限。"
      required: true
      expression: false
  schema #s_style "style"
    summary: "可复用视觉属性集合。"
    primary: "name"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "样式名。"
      required: true
      expression: false
    property "values"
      type: "record"
      description: "布局与视觉属性，禁止业务副作用。"
      required: true
      expression: true
  schema #s_a11y "a11y"
    summary: "可访问性目标，不自动构成达标证据。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "target"
      type: "text"
      description: "验收基线名称。"
      required: true
      expression: false
    property "reduce_motion"
      type: "text"
      description: "减少动画偏好。"
      required: false
      expression: false
      default: "respect_system"
    property "keyboard"
      type: "bool"
      description: "要求键盘可操作。"
      required: false
      expression: false
      default: true
  schema #s_design_canvas "design.canvas"
    summary: "可编辑设计画布。"
    primary: "label"
    identity: "required"
    children:
      - "design.layer"
    unknown_properties: "reject"
    effects: []
    category: "spec"
    property "label"
      type: "text"
      description: "设计稿标题。"
      required: false
      expression: false
    property "size"
      type: "list<int>"
      description: "二维尺寸，必须两个正整数。"
      required: true
      expression: false
    property "editable"
      type: "bool"
      description: "要求对象可编辑。"
      required: true
      expression: false
  schema #s_design_layer "design.layer"
    summary: "带几何和语义的独立图层。"
    primary: "label"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "label"
      type: "text"
      description: "图层说明。"
      required: false
      expression: false
    property "kind"
      type: "text"
      description: "图层种类。"
      required: true
      expression: false
      enum:
        - "text"
        - "shape"
        - "image"
    property "bounds"
      type: "list<number>"
      description: "[x,y,w,h]，单位由画布固定。"
      required: true
      expression: false
    property "text"
      type: "text"
      description: "文字层正文。"
      required: false
      expression: false
    property "source"
      type: "ref"
      description: "图片层资源。"
      required: false
      expression: false
    property "fill"
      type: "text"
      description: "颜色或 token 名。"
      required: false
      expression: false
  rule #rule_DESIGN_NO_BUSINESS_EFFECT "DESIGN_NO_BUSINESS_EFFECT"
    level: "MUST"
    statement: |
      主题、断点和样式只能改变布局或视觉；不得改变动作授权、字段类型或后端行为。token 类型冲突报错。
    verification: "type-effect"
    origin: "conversation-design"
  rule #rule_DESIGN_EDITABILITY "DESIGN_EDITABILITY"
    level: "MUST"
    statement: |
      editable 要求输出保留指定的文字/对象/图层。截图不能冒充可编辑设计稿；a11y 目标必须经独立检查或评审。
    verification: "artifact-validation"
    origin: "conversation-design"

// source: profiles/04-ui.uicl
profile #profile_ui "界面与交互"
  id: "uicl.ui"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    有序界面树、状态绑定、事件、查询资源、表单列表与组件。
  requires:
    - "uicl.core@1.0.0"
    - "uicl.design@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "component"
    - "fill_slot"
    - "form"
    - "list"
    - "navigate"
    - "notify"
    - "on"
    - "refresh"
    - "resource"
    - "set"
    - "slot"
    - "ui"
  schema #s_ui_column "ui.column"
    summary: "有序布局容器，顺序保留。"
    primary: null
    identity: "optional"
    children:
      - "ui.*"
      - "if"
      - "each"
      - "form"
      - "list"
      - "component.use"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
      expression: true
    property "style"
      type: "ref"
      description: "视觉样式引用。"
      required: false
      expression: false
      targets:
        - "style"
    property "test_id"
      type: "text"
      description: "可选稳定测试辅助标识。"
      required: false
      expression: false
    property "gap"
      type: "number"
      description: "逻辑间距。"
      required: false
      expression: false
    property "columns"
      type: "int"
      description: "grid 的列数。"
      required: false
      expression: false
    property "padding"
      type: "number"
      description: "内边距。"
      required: false
      expression: false
  schema #s_ui_row "ui.row"
    summary: "有序布局容器，顺序保留。"
    primary: null
    identity: "optional"
    children:
      - "ui.*"
      - "if"
      - "each"
      - "form"
      - "list"
      - "component.use"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
      expression: true
    property "style"
      type: "ref"
      description: "视觉样式引用。"
      required: false
      expression: false
      targets:
        - "style"
    property "test_id"
      type: "text"
      description: "可选稳定测试辅助标识。"
      required: false
      expression: false
    property "gap"
      type: "number"
      description: "逻辑间距。"
      required: false
      expression: false
    property "columns"
      type: "int"
      description: "grid 的列数。"
      required: false
      expression: false
    property "padding"
      type: "number"
      description: "内边距。"
      required: false
      expression: false
  schema #s_ui_stack "ui.stack"
    summary: "有序布局容器，顺序保留。"
    primary: null
    identity: "optional"
    children:
      - "ui.*"
      - "if"
      - "each"
      - "form"
      - "list"
      - "component.use"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
      expression: true
    property "style"
      type: "ref"
      description: "视觉样式引用。"
      required: false
      expression: false
      targets:
        - "style"
    property "test_id"
      type: "text"
      description: "可选稳定测试辅助标识。"
      required: false
      expression: false
    property "gap"
      type: "number"
      description: "逻辑间距。"
      required: false
      expression: false
    property "columns"
      type: "int"
      description: "grid 的列数。"
      required: false
      expression: false
    property "padding"
      type: "number"
      description: "内边距。"
      required: false
      expression: false
  schema #s_ui_scroll "ui.scroll"
    summary: "有序布局容器，顺序保留。"
    primary: null
    identity: "optional"
    children:
      - "ui.*"
      - "if"
      - "each"
      - "form"
      - "list"
      - "component.use"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
      expression: true
    property "style"
      type: "ref"
      description: "视觉样式引用。"
      required: false
      expression: false
      targets:
        - "style"
    property "test_id"
      type: "text"
      description: "可选稳定测试辅助标识。"
      required: false
      expression: false
    property "gap"
      type: "number"
      description: "逻辑间距。"
      required: false
      expression: false
    property "columns"
      type: "int"
      description: "grid 的列数。"
      required: false
      expression: false
    property "padding"
      type: "number"
      description: "内边距。"
      required: false
      expression: false
  schema #s_ui_card "ui.card"
    summary: "有序布局容器，顺序保留。"
    primary: null
    identity: "optional"
    children:
      - "ui.*"
      - "if"
      - "each"
      - "form"
      - "list"
      - "component.use"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
      expression: true
    property "style"
      type: "ref"
      description: "视觉样式引用。"
      required: false
      expression: false
      targets:
        - "style"
    property "test_id"
      type: "text"
      description: "可选稳定测试辅助标识。"
      required: false
      expression: false
    property "gap"
      type: "number"
      description: "逻辑间距。"
      required: false
      expression: false
    property "columns"
      type: "int"
      description: "grid 的列数。"
      required: false
      expression: false
    property "padding"
      type: "number"
      description: "内边距。"
      required: false
      expression: false
  schema #s_ui_grid "ui.grid"
    summary: "有序布局容器，顺序保留。"
    primary: null
    identity: "optional"
    children:
      - "ui.*"
      - "if"
      - "each"
      - "form"
      - "list"
      - "component.use"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
      expression: true
    property "style"
      type: "ref"
      description: "视觉样式引用。"
      required: false
      expression: false
      targets:
        - "style"
    property "test_id"
      type: "text"
      description: "可选稳定测试辅助标识。"
      required: false
      expression: false
    property "gap"
      type: "number"
      description: "逻辑间距。"
      required: false
      expression: false
    property "columns"
      type: "int"
      description: "grid 的列数。"
      required: false
      expression: false
    property "padding"
      type: "number"
      description: "内边距。"
      required: false
      expression: false
  schema #s_ui_text "ui.text"
    summary: "显示文字或显式可格式化标量。"
    primary: "value"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
      expression: true
    property "style"
      type: "ref"
      description: "视觉样式引用。"
      required: false
      expression: false
      targets:
        - "style"
    property "test_id"
      type: "text"
      description: "可选稳定测试辅助标识。"
      required: false
      expression: false
    property "value"
      type: "value"
      description: "显示值，不是执行代码。"
      required: true
      expression: true
    property "size"
      type: "number"
      description: "字号。"
      required: false
      expression: false
  schema #s_ui_heading "ui.heading"
    summary: "具有标题语义的文字。"
    primary: "value"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
      expression: true
    property "style"
      type: "ref"
      description: "视觉样式引用。"
      required: false
      expression: false
      targets:
        - "style"
    property "test_id"
      type: "text"
      description: "可选稳定测试辅助标识。"
      required: false
      expression: false
    property "value"
      type: "text"
      description: "标题文字。"
      required: true
      expression: true
    property "level"
      type: "int"
      description: "标题层级。"
      required: false
      expression: false
      default: 1
  schema #s_ui_button "ui.button"
    summary: "用户手势触发的按钮。"
    primary: "label"
    identity: "optional"
    children:
      - "on"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
      expression: true
    property "style"
      type: "ref"
      description: "视觉样式引用。"
      required: false
      expression: false
      targets:
        - "style"
    property "test_id"
      type: "text"
      description: "可选稳定测试辅助标识。"
      required: false
      expression: false
    property "label"
      type: "text"
      description: "按钮文案。"
      required: true
      expression: false
    property "disabled"
      type: "bool"
      description: "是否可操作。"
      required: false
      expression: true
      default: false
  schema #s_ui_input "ui.input"
    summary: "绑定可写 state 的输入框。"
    primary: "label"
    identity: "optional"
    children:
      - "on"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
      expression: true
    property "style"
      type: "ref"
      description: "视觉样式引用。"
      required: false
      expression: false
      targets:
        - "style"
    property "test_id"
      type: "text"
      description: "可选稳定测试辅助标识。"
      required: false
      expression: false
    property "label"
      type: "text"
      description: "无障碍标签。"
      required: true
      expression: false
    property "bind"
      type: "ref"
      description: "可写状态句柄。"
      required: true
      expression: false
      targets:
        - "state"
    property "max_length"
      type: "int"
      description: "客户端字符数限制，不替代服务端校验。"
      required: false
      expression: false
    property "input_type"
      type: "text"
      description: "text/password/email 等输入提示。"
      required: false
      expression: false
  schema #s_ui_image "ui.image"
    summary: "显示已有图片产物，不接受图片 Spec 本身。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "ui"
    property "visible"
      type: "bool"
      description: "是否显示，不代表权限。"
      required: false
      expression: true
    property "style"
      type: "ref"
      description: "视觉样式引用。"
      required: false
      expression: false
      targets:
        - "style"
    property "test_id"
      type: "text"
      description: "可选稳定测试辅助标识。"
      required: false
      expression: false
    property "src"
      type: "ref"
      description: "图片资源或已验证图片产物端口。"
      required: true
      expression: false
    property "alt"
      type: "text"
      description: "替代文字。"
      required: true
      expression: false
  schema #s_on "on"
    summary: "事件顺序处理器，默认等待每一步。"
    primary: "event"
    identity: "optional"
    children:
      - "set"
      - "call"
      - "invoke"
      - "refresh"
      - "navigate"
      - "notify"
      - "let"
      - "if"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "event"
      type: "text"
      description: "按组件注册表定义的事件。"
      required: true
      expression: false
  schema #s_set "set"
    summary: "更新可写客户端状态。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects:
      - "state.write"
    category: "declaration"
    property "target"
      type: "ref"
      description: "state 句柄。"
      required: true
      expression: false
      targets:
        - "state"
    property "value"
      type: "value"
      description: "赋值表达式或字面值。"
      required: true
      expression: true
  schema #s_navigate "navigate"
    summary: "按已声明页面跳转。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "page"
      type: "ref"
      description: "目标页面。"
      required: true
      expression: false
      targets:
        - "page"
    property "args"
      type: "record"
      description: "路由参数。"
      required: false
      expression: true
  schema #s_notify "notify"
    summary: "用户可见反馈。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "message"
      type: "text"
      description: "提示内容，不得含秘密。"
      required: true
      expression: true
  schema #s_refresh "refresh"
    summary: "显式刷新查询或动态槽位。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects:
      - "resource.refresh"
    category: "declaration"
    property "target"
      type: "ref"
      description: "已声明的 resource 或 ui.slot。"
      required: true
      expression: false
      targets:
        - "resource"
        - "ui.slot"
  schema #s_resource "resource"
    summary: "客户端查询资源及 loading/error/items/cursor 状态。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "query"
      type: "ref"
      description: "只读后端 query。"
      required: true
      expression: false
      targets:
        - "query"
    property "args"
      type: "record"
      description: "查询输入。"
      required: false
      expression: true
      default: {}
    port "snapshot"
      type: "QuerySnapshot"
      phase: "execution"
  schema #s_form "form"
    summary: "标准组合表单。"
    primary: "title"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "title"
      type: "text"
      description: "表单标题。"
      required: false
      expression: false
    property "create"
      type: "ref"
      description: "collection 或 create action。"
      required: true
      expression: false
      targets:
        - "collection"
        - "action"
    property "on_success_refresh"
      type: "list<ref>"
      description: "仅写成功后显式刷新；刷新失败不撤销写成功。"
      required: false
      expression: false
      targets:
        - "resource"
    property "fields"
      type: "list<text>"
      description: "白名单表单字段，禁止 owner/version 等服务端字段。"
      required: false
      expression: false
  schema #s_list "list"
    summary: "具有加载、空态、错误和有界分页的组合列表。"
    primary: null
    identity: "required"
    children:
      - "ui.*"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "source"
      type: "ref"
      description: "collection 或客户端 resource。"
      required: true
      expression: false
      targets:
        - "collection"
        - "resource"
    property "empty_text"
      type: "text"
      description: "空态文案。"
      required: false
      expression: false
    property "key"
      type: "text"
      description: "稳定行身份字段。"
      required: false
      expression: false
      default: "id"
  schema #s_component "component"
    summary: "类型化复用界面组件。"
    primary: "name"
    identity: "required"
    children:
      - "ui.*"
      - "slot"
      - "state"
      - "computed"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "组件说明。"
      required: false
      expression: false
    property "props"
      type: "record"
      description: "属性名到业务类型。"
      required: true
      expression: false
    property "events"
      type: "record"
      description: "事件名到事件载荷类型。"
      required: false
      expression: false
      default: {}
  schema #s_slot "slot"
    summary: "组件内容插槽，不是动态生成槽位。"
    primary: "name"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "插槽名。"
      required: true
      expression: false
  schema #s_component_use "component.use"
    summary: "组件实例，属性按组件契约检查。"
    primary: null
    identity: "optional"
    children:
      - "ui.*"
      - "fill_slot"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "component"
      type: "ref"
      description: "组件声明。"
      required: true
      expression: false
      targets:
        - "component"
    property "props"
      type: "record"
      description: "输入参数。"
      required: true
      expression: true
  schema #s_fill_slot "fill_slot"
    summary: "填充已声明插槽。"
    primary: "name"
    identity: "optional"
    children:
      - "ui.*"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "插槽名。"
      required: true
      expression: false
  rule #rule_UI_LIFECYCLE "UI_LIFECYCLE"
    level: "MUST"
    statement: |
      页面卸载后不得回写已销毁状态。资源刷新与生成采用请求版本/latest-wins，取消不等于回滚已提交服务端效果。表单提交保存输入快照，成功后只清空仍等于快照的输入。
    verification: "runtime"
    origin: "conversation-design"
  rule #rule_UI_BINDINGS "UI_BINDINGS"
    level: "MUST"
    statement: |
      ui.input.bind/set.target 只能引用可写 state；props、actor、query 行和产物不可写。@ 与 $ 的区别不可通过框架映射抹去。
    verification: "type-effect"
    origin: "conversation-design"
  rule #rule_UI_LIST_FORMS "UI_LIST_FORMS"
    level: "MUST"
    statement: |
      form/list 按锁定 recipe 展开，提供校验、加载、错误、分页和请求去重。控件出现或隐藏不得隐式开放或撤销后端权限。
    verification: "recipe-runtime"
    origin: "conversation-design"

// source: profiles/05-backend.uicl
profile #profile_backend "后端业务与 API"
  id: "uicl.backend"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    模型、访问策略、查询、动作、并发、幂等和工作流。
  requires:
    - "uicl.core@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "action"
    - "assert"
    - "call"
    - "create"
    - "delete"
    - "each"
    - "else"
    - "emit"
    - "endpoint"
    - "for"
    - "if"
    - "input"
    - "let"
    - "model"
    - "policy"
    - "query"
    - "return"
    - "run"
    - "service"
    - "then"
    - "throw"
    - "transition"
    - "update"
    - "workflow"
  schema #s_model "model"
    summary: "服务端实体；保留 id/version/created_at/updated_at 系统字段。"
    primary: "name"
    identity: "required"
    children:
      - "field"
      - "policy"
    unknown_properties: "reject"
    effects: []
    category: "model"
    property "name"
      type: "text"
      description: "实体显示名。"
      required: false
      expression: false
  schema #s_policy "policy"
    summary: "服务端行级访问策略。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "read"
      type: "bool"
      description: "row 上的读取授权。"
      required: false
      expression: true
      default: false
    property "create"
      type: "bool"
      description: "new 上的创建授权。"
      required: false
      expression: true
      default: false
    property "update"
      type: "bool"
      description: "old/new 上的更新授权。"
      required: false
      expression: true
      default: false
    property "delete"
      type: "bool"
      description: "old 上的删除授权。"
      required: false
      expression: true
      default: false
  schema #s_query "query"
    summary: "有界只读查询。"
    primary: null
    identity: "required"
    children:
      - "input"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "model"
      type: "ref"
      description: "实体模型。"
      required: true
      expression: false
      targets:
        - "model"
        - "collection"
    property "allow"
      type: "bool"
      description: "调用授权。"
      required: true
      expression: true
    property "where"
      type: "bool"
      description: "额外行过滤。"
      required: false
      expression: true
    property "select"
      type: "list<text>"
      description: "明确输出字段。"
      required: true
      expression: false
    property "order"
      type: "list<text>"
      description: "稳定排序，分页必须包含唯一 tiebreaker。"
      required: true
      expression: false
    property "page_size"
      type: "int"
      description: "单页大小上限。"
      required: true
      expression: false
    port "result"
      type: "QueryPage"
      phase: "execution"
  schema #s_input "input"
    summary: "动作或查询的命名输入。"
    primary: "name"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "输入名。"
      required: true
      expression: false
    property "type"
      type: "text|ref"
      description: "业务类型。"
      required: true
      expression: false
    property "normalize"
      type: "text"
      description: "trim 或 none。"
      required: false
      expression: false
      enum:
        - "trim"
        - "none"
    property "min"
      type: "int"
      description: "长度/数值下界。"
      required: false
      expression: false
    property "max"
      type: "int"
      description: "上界。"
      required: false
      expression: false
  schema #s_action "action"
    summary: "确定性业务控制流；模型推断须显式节点。"
    primary: "name"
    identity: "required"
    children:
      - "input"
      - "run"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "动作说明。"
      required: false
      expression: false
    property "returns"
      type: "text|ref"
      description: "输出业务类型。"
      required: true
      expression: false
    property "allow"
      type: "bool"
      description: "服务端调用授权。"
      required: true
      expression: true
    property "transaction"
      type: "text"
      description: "数据事务要求。"
      required: true
      expression: false
      enum:
        - "required"
        - "none"
    property "idempotency"
      type: "text"
      description: "服务端去重约定。"
      required: true
      expression: false
      enum:
        - "required"
        - "none"
    port "result"
      type: "dynamic"
      phase: "execution"
  schema #s_run "run"
    summary: "顺序执行块。"
    primary: null
    identity: "optional"
    children:
      - "let"
      - "create"
      - "update"
      - "delete"
      - "return"
      - "throw"
      - "assert"
      - "if"
      - "for"
      - "call"
      - "invoke"
      - "emit"
      - "infer"
      - "dispatch"
      - "transition.apply"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
  schema #s_let "let"
    summary: "局部不可变绑定，只在当前 run/事件之后可见。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "value"
      type: "value"
      description: "表达式。"
      required: true
      expression: true
  schema #s_create "create"
    summary: "通过模型策略及约束的原子数据create"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "data.write"
    category: "declaration"
    property "model"
      type: "ref"
      description: "模型。"
      required: true
      expression: false
      targets:
        - "model"
    property "values"
      type: "record"
      description: "写入字段，系统字段由宿主管理。"
      required: true
      expression: true
    port "result"
      type: "dynamic"
      phase: "execution"
  schema #s_update "update"
    summary: "通过模型策略及约束的原子数据update"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "data.write"
    category: "declaration"
    property "model"
      type: "ref"
      description: "模型。"
      required: true
      expression: false
      targets:
        - "model"
    property "values"
      type: "record"
      description: "写入字段，系统字段由宿主管理。"
      required: false
      expression: true
    property "id"
      type: "value"
      description: "记录身份。"
      required: true
      expression: true
    property "expect_version"
      type: "int"
      description: "乐观锁版本。"
      required: true
      expression: true
    port "result"
      type: "dynamic"
      phase: "execution"
  schema #s_delete "delete"
    summary: "通过模型策略及约束的原子数据delete"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "data.write"
    category: "declaration"
    property "model"
      type: "ref"
      description: "模型。"
      required: true
      expression: false
      targets:
        - "model"
    property "values"
      type: "record"
      description: "写入字段，系统字段由宿主管理。"
      required: false
      expression: true
    property "id"
      type: "value"
      description: "记录身份。"
      required: true
      expression: true
    property "expect_version"
      type: "int"
      description: "乐观锁版本。"
      required: true
      expression: true
    port "result"
      type: "dynamic"
      phase: "execution"
  schema #s_return "return"
    summary: "从动作返回有类型结果。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "value"
      type: "value"
      description: "结果。"
      required: true
      expression: true
  schema #s_throw "throw"
    summary: "显式业务错误。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "code"
      type: "text"
      description: "稳定错误码。"
      required: true
      expression: false
    property "message"
      type: "text"
      description: "脱敏错误说明。"
      required: false
      expression: false
  schema #s_assert "assert"
    summary: "违反前置条件时中止，不能替代身份授权。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "test"
      type: "bool"
      description: "布尔条件。"
      required: true
      expression: true
    property "code"
      type: "text"
      description: "失败码。"
      required: true
      expression: false
  schema #s_if "if"
    summary: "二分条件，条件必须 bool。"
    primary: null
    identity: "optional"
    children:
      - "then"
      - "else"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "test"
      type: "bool"
      description: "纯表达式。"
      required: true
      expression: true
  schema #s_then "then"
    summary: "条件分支。"
    primary: null
    identity: "optional"
    children:
      - "ui.*"
      - "let"
      - "set"
      - "call"
      - "invoke"
      - "create"
      - "update"
      - "delete"
      - "return"
      - "throw"
      - "assert"
      - "if"
      - "for"
      - "refresh"
      - "notify"
      - "expect"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
  schema #s_else "else"
    summary: "条件分支。"
    primary: null
    identity: "optional"
    children:
      - "ui.*"
      - "let"
      - "set"
      - "call"
      - "invoke"
      - "create"
      - "update"
      - "delete"
      - "return"
      - "throw"
      - "assert"
      - "if"
      - "for"
      - "refresh"
      - "notify"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
  schema #s_for "for"
    summary: "有界服务端循环。"
    primary: null
    identity: "optional"
    children:
      - "run"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "items"
      type: "list<value>"
      description: "输入列表。"
      required: true
      expression: true
    property "as"
      type: "text"
      description: "循环绑定名。"
      required: true
      expression: false
    property "max_items"
      type: "int"
      description: "强制迭代上限。"
      required: true
      expression: false
  schema #s_each "each"
    summary: "有稳定 key 的 UI 列表循环。"
    primary: null
    identity: "optional"
    children:
      - "ui.*"
      - "if"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "items"
      type: "list<value>"
      description: "输入集合。"
      required: true
      expression: true
    property "as"
      type: "text"
      description: "行绑定名。"
      required: true
      expression: false
    property "key"
      type: "value"
      description: "每项稳定唯一 key。"
      required: true
      expression: true
  schema #s_call "call"
    summary: "调用固定动作，不接受模型生成的函数名。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects:
      - "action.call"
    category: "declaration"
    property "action"
      type: "ref"
      description: "动作声明。"
      required: true
      expression: false
      targets:
        - "action"
    property "args"
      type: "record"
      description: "输入参数。"
      required: true
      expression: true
    port "result"
      type: "dynamic"
      phase: "execution"
  schema #s_emit "emit"
    summary: "事务 outbox 事件；不在事务内直接调用网络。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects:
      - "outbox.write"
    category: "declaration"
    property "event"
      type: "text"
      description: "版本化事件类型。"
      required: true
      expression: false
    property "payload"
      type: "record"
      description: "无秘密的事件数据。"
      required: true
      expression: true
  schema #s_endpoint "endpoint"
    summary: "显式 HTTP 接口映射。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "method"
      type: "text"
      description: "HTTP 方法。"
      required: true
      expression: false
    property "path"
      type: "text"
      description: "相对 API 路径。"
      required: true
      expression: false
    property "action"
      type: "ref"
      description: "处理动作。"
      required: false
      expression: false
      targets:
        - "action"
    property "query"
      type: "ref"
      description: "读取查询。"
      required: false
      expression: false
      targets:
        - "query"
    property "auth"
      type: "text"
      description: "公共或身份验证。"
      required: true
      expression: false
      enum:
        - "public"
        - "authenticated"
    property "body"
      type: "text"
      description: "请求体编码。"
      required: false
      expression: false
      default: "json"
    property "rate_limit"
      type: "record"
      description: "由 HTTP 适配器验证的限流参数。"
      required: false
      expression: false
  schema #s_service "service"
    summary: "后端服务聚合入口。"
    primary: "name"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "名称。"
      required: false
      expression: false
    property "target"
      type: "ref"
      description: "编译目标。"
      required: true
      expression: false
      targets:
        - "target"
    property "models"
      type: "list<ref>"
      description: "包含的模型。"
      required: true
      expression: false
      targets:
        - "model"
    property "endpoints"
      type: "list<ref>"
      description: "显式暴露接口。"
      required: true
      expression: false
      targets:
        - "endpoint"
    property "identity_binding"
      type: "text"
      description: "外部可信身份实现。"
      required: true
      expression: false
    property "health_path"
      type: "text"
      description: "无敏感内容健康检查端点。"
      required: false
      expression: false
      default: "/health"
  schema #s_workflow "workflow"
    summary: "持久有限状态机。"
    primary: null
    identity: "required"
    children:
      - "transition"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "model"
      type: "ref"
      description: "关联模型。"
      required: true
      expression: false
      targets:
        - "model"
    property "state_field"
      type: "text"
      description: "被保护的状态字段。"
      required: true
      expression: false
    property "initial"
      type: "text"
      description: "初始状态。"
      required: true
      expression: false
    property "terminal"
      type: "list<text>"
      description: "终态。"
      required: true
      expression: false
  schema #s_transition "transition"
    summary: "只能在已授权且版本吻合时改变状态。"
    primary: "name"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "迁移名。"
      required: true
      expression: false
    property "from"
      type: "text"
      description: "源状态。"
      required: true
      expression: false
    property "to"
      type: "text"
      description: "目标状态。"
      required: true
      expression: false
    property "allow"
      type: "bool"
      description: "转换授权，与模型策略同时成立。"
      required: true
      expression: true
  schema #s_transition_apply "transition.apply"
    summary: "原子应用工作流转换。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects:
      - "data.write"
    category: "declaration"
    property "transition"
      type: "ref"
      description: "已声明转换。"
      required: true
      expression: false
      targets:
        - "transition"
    property "id"
      type: "value"
      description: "记录身份。"
      required: true
      expression: true
    property "expect_version"
      type: "int"
      description: "期望版本。"
      required: true
      expression: true
  rule #rule_BACKEND_AUTH "BACKEND_AUTH"
    level: "MUST"
    statement: |
      服务端权限默认拒绝。模型策略在分页/计数/聚合前应用；API 或按钮存在不自动授予权限。actor 来自可信身份适配器，不能从请求体声明。
    verification: "runtime"
    origin: "conversation-design"
  rule #rule_BACKEND_ATOMICITY "BACKEND_ATOMICITY"
    level: "MUST"
    statement: |
      事务只涵盖受管理数据、并发约束与 outbox。事务内禁止直接网络副作用。system fields 由运行时生成，id 为不透明身份，version 初始 1 且每次成功更新递增。
    verification: "runtime"
    origin: "conversation-design"
  rule #rule_BACKEND_IDEMPOTENCY "BACKEND_IDEMPOTENCY"
    level: "MUST"
    statement: |
      去重键绑定主体、动作、有效期和输入摘要。相同键不同输入报错。外部调用结果不确定必须进入 INDETERMINATE，对账前不得重复执行。
    verification: "runtime"
    origin: "conversation-design"
  rule #rule_BACKEND_FLOW "BACKEND_FLOW"
    level: "MUST"
    statement: |
      动作非 unit 的每个正常路径必须返回匹配类型；调用图不得隐式无界递归。有界循环、if、return/throw 语义固定。普通 update 不能绕过 workflow 改变状态字段。
    verification: "type-effect-runtime"
    origin: "conversation-design"

// source: profiles/06-application.uicl
profile #profile_application "应用组合与渐进默认"
  id: "uicl.application"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    连接设计、界面、数据和目标平台，简写不隐藏业务决定。
  requires:
    - "uicl.ui@1.0.0"
    - "uicl.backend@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "app"
    - "collection"
    - "page"
  schema #s_app "app"
    summary: "应用根；直接 UI 子项可展开为默认 home 页面。"
    primary: "title"
    identity: "optional"
    children:
      - "page"
      - "state"
      - "computed"
      - "collection"
      - "ui.*"
      - "form"
      - "list"
      - "resource"
      - "component.use"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "title"
      type: "text"
      description: "应用名称。"
      required: true
      expression: false
    property "target"
      type: "ref"
      description: "单一目标。"
      required: false
      expression: false
      targets:
        - "target"
    property "targets"
      type: "list<ref>"
      description: "多个独立构建目标，与 target 互斥。"
      required: false
      expression: false
      targets:
        - "target"
    property "design"
      type: "ref"
      description: "设计系统。"
      required: false
      expression: false
      targets:
        - "design"
    property "identity"
      type: "text"
      description: "身份由宿主绑定。"
      required: false
      expression: false
      enum:
        - "host"
    property "locale"
      type: "text"
      description: "默认语言。"
      required: false
      expression: false
      default: "zh-CN"
  schema #s_page "page"
    summary: "页面与路由。"
    primary: "title"
    identity: "required"
    children:
      - "state"
      - "computed"
      - "resource"
      - "ui.*"
      - "form"
      - "list"
      - "if"
      - "each"
      - "component.use"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "title"
      type: "text"
      description: "页面标题。"
      required: true
      expression: false
    property "route"
      type: "text"
      description: "路由。"
      required: true
      expression: false
    property "access"
      type: "text"
      description: "客户端进入要求，不替代后端授权。"
      required: false
      expression: false
      default: "public"
      enum:
        - "public"
        - "authenticated"
  schema #s_collection "collection"
    summary: "渐进数据组合；只默认 read/create。"
    primary: null
    identity: "required"
    children:
      - "field"
      - "policy"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "storage"
      type: "text"
      description: "必须显式选择数据位置。"
      required: true
      expression: false
      enum:
        - "device"
        - "server"
    property "access"
      type: "text"
      description: "server 必需的固定授权 recipe。"
      required: false
      expression: false
      enum:
        - "owner"
    property "operations"
      type: "list<text>"
      description: "显式操作集。"
      required: false
      expression: false
      default:
        - "read"
        - "create"
  rule #rule_APP_PROGRESSIVE "APP_PROGRESSIVE"
    level: "MUST"
    statement: |
      无 page 的 app 中 UI 子项按基础 recipe 生成 home /，不生成服务器或账号。出现显式 page 时不得再隐式混入另一首页。collection 缺失 storage 不能猜测。
    verification: "recipe"
    origin: "conversation-design"
  rule #rule_APP_STORAGE "APP_STORAGE"
    level: "MUST"
    statement: |
      server collection 需要可信 identity 和 owner/显式 policy。device 改 server 必须独立取得数据迁移和上传许可。update/delete 绝不因控件出现而自动开放。
    verification: "recipe-runtime"
    origin: "conversation-design"

// source: profiles/07-postgresql.uicl
profile #profile_postgresql "PostgreSQL 关系结构与迁移"
  id: "uicl.postgresql"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    物理关系模式独立于业务模型；不把 SQL 当 Core 表达式。
  requires:
    - "uicl.core@1.0.0"
    - "uicl.backend@1.0.0"
  origin: "scenario-review-and-1.0-completion"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "pg"
  record_schema #r_PgColumn "PgColumn"
    summary: "物理字段。"
    unknown_fields: "reject"
    property "name"
      type: "text"
      description: "列名。"
      required: true
      expression: false
    property "type"
      type: "text"
      description: "PostgreSQL 方言类型。"
      required: true
      expression: false
    property "nullable"
      type: "bool"
      description: "可空。"
      required: true
      expression: false
    property "default"
      type: "value"
      description: "SQL 字面默认值，不是 SQL 代码。"
      required: false
      expression: false
    property "default_sql"
      type: "text"
      description: "显式 SQL 默认表达式，与 default 互斥。"
      required: false
      expression: false
  record_schema #r_PgFK "PgFK"
    summary: "外键。"
    unknown_fields: "reject"
    property "columns"
      type: "list<text>"
      description: "本表列。"
      required: true
      expression: false
    property "target"
      type: "ref"
      description: "目标表。"
      required: true
      expression: false
      targets:
        - "pg.table"
    property "target_columns"
      type: "list<text>"
      description: "目标列。"
      required: true
      expression: false
    property "on_delete"
      type: "text"
      description: "删除策略。"
      required: true
      expression: false
      enum:
        - "restrict"
        - "cascade"
        - "set_null"
        - "no_action"
  record_schema #r_PgIndex "PgIndex"
    summary: "索引。"
    unknown_fields: "reject"
    property "name"
      type: "text"
      description: "索引名。"
      required: true
      expression: false
    property "columns"
      type: "list<text>"
      description: "列名。"
      required: true
      expression: false
    property "method"
      type: "text"
      description: "访问方法。"
      required: false
      expression: false
      default: "btree"
    property "unique"
      type: "bool"
      description: "唯一索引。"
      required: false
      expression: false
      default: false
    property "where_sql"
      type: "text"
      description: "显式条件表达式。"
      required: false
      expression: false
    property "build"
      type: "text"
      description: "构建方式。"
      required: false
      expression: false
      default: "normal"
      enum:
        - "normal"
        - "concurrently"
  record_schema #r_PgCheck "PgCheck"
    summary: "数据库约束。"
    unknown_fields: "reject"
    property "name"
      type: "text"
      description: "约束名。"
      required: true
      expression: false
    property "sql"
      type: "text"
      description: "显式 SQL 表达式；由 PG 适配器解析。"
      required: true
      expression: false
  record_schema #r_PgUnique "PgUnique"
    summary: "唯一键。"
    unknown_fields: "reject"
    property "columns"
      type: "list<text>"
      description: "联合唯一列。"
      required: true
      expression: false
  schema #s_pg_database "pg.database"
    summary: "受管数据库定义；不包含连接密钥。"
    primary: null
    identity: "required"
    children:
      - "pg.table"
      - "pg.role"
      - "pg.policy"
      - "pg.migration"
      - "pg.mapping"
    unknown_properties: "reject"
    effects: []
    category: "managed-resource"
    property "name"
      type: "text"
      description: "数据库名称。"
      required: true
      expression: false
    property "engine_major"
      type: "int"
      description: "目标数据库主版本。"
      required: true
      expression: false
    property "schema"
      type: "text"
      description: "默认 SQL schema。"
      required: false
      expression: false
      default: "public"
    property "connection"
      type: "ref"
      description: "宿主提供的凭据句柄。"
      required: false
      expression: false
      targets:
        - "secret"
    property "depends_on"
      type: "list<ref>"
      description: "显式计划前置依赖；兄弟声明顺序不代表部署顺序。"
      required: false
      expression: false
  schema #s_pg_table "pg.table"
    summary: "物理表，稳定身份与 SQL 名称分离。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "managed-resource"
    property "name"
      type: "text"
      description: "物理表名。"
      required: true
      expression: false
    property "columns"
      type: "list<record<PgColumn>>"
      description: "列声明。"
      required: true
      expression: false
    property "primary_key"
      type: "list<text>"
      description: "联合主键。"
      required: true
      expression: false
    property "unique"
      type: "list<record<PgUnique>>"
      description: "唯一约束。"
      required: false
      expression: false
    property "foreign_keys"
      type: "list<record<PgFK>>"
      description: "外键。"
      required: false
      expression: false
    property "checks"
      type: "list<record<PgCheck>>"
      description: "检查约束。"
      required: false
      expression: false
    property "indexes"
      type: "list<record<PgIndex>>"
      description: "索引。"
      required: false
      expression: false
    property "rls"
      type: "bool"
      description: "启用行级安全。"
      required: false
      expression: false
      default: false
    property "force_rls"
      type: "bool"
      description: "要求表所有者也受相应策略约束。"
      required: false
      expression: false
      default: false
    property "depends_on"
      type: "list<ref>"
      description: "显式计划前置依赖；兄弟声明顺序不代表部署顺序。"
      required: false
      expression: false
  schema #s_pg_role "pg.role"
    summary: "数据库角色和执行权限边界。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "角色名。"
      required: true
      expression: false
    property "login"
      type: "bool"
      description: "是否允许连接。"
      required: true
      expression: false
    property "bypass_rls"
      type: "bool"
      description: "是否绕过 RLS，应用角色必须 false。"
      required: true
      expression: false
    property "owner"
      type: "bool"
      description: "是否承担对象所有权。"
      required: false
      expression: false
      default: false
  schema #s_pg_policy "pg.policy"
    summary: "物理行安全策略。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "table"
      type: "ref"
      description: "目标表。"
      required: true
      expression: false
      targets:
        - "pg.table"
    property "role"
      type: "ref"
      description: "应用角色。"
      required: true
      expression: false
      targets:
        - "pg.role"
    property "command"
      type: "text"
      description: "SQL 操作集合。"
      required: true
      expression: false
    property "using_sql"
      type: "text"
      description: "可见旧行表达式。"
      required: false
      expression: false
    property "check_sql"
      type: "text"
      description: "新行合法性表达式。"
      required: false
      expression: false
  schema #s_pg_mapping "pg.mapping"
    summary: "业务模型到物理表的显式映射。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "model"
      type: "ref"
      description: "模型。"
      required: true
      expression: false
      targets:
        - "model"
    property "table"
      type: "ref"
      description: "物理表。"
      required: true
      expression: false
      targets:
        - "pg.table"
    property "fields"
      type: "record"
      description: "逻辑字段到物理列的映射；包含系统字段。"
      required: true
      expression: false
    property "id_conversion"
      type: "text"
      description: "不透明 id 与数据库具体身份类型的转换。"
      required: true
      expression: false
  schema #s_pg_migration "pg.migration"
    summary: "有前置版本和显式意图的迁移计划。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "database.ddl"
    category: "declaration"
    property "database"
      type: "ref"
      description: "数据库。"
      required: true
      expression: false
      targets:
        - "pg.database"
    property "from_version"
      type: "text"
      description: "原版本。"
      required: true
      expression: false
    property "to_version"
      type: "text"
      description: "目标版本。"
      required: true
      expression: false
    property "atomic"
      type: "text"
      description: "事务策略。"
      required: true
      expression: false
      enum:
        - "required"
        - "split_allowed"
        - "none"
    property "destructive"
      type: "text"
      description: "破坏性操作门禁。"
      required: true
      expression: false
      enum:
        - "deny"
        - "approval_required"
    property "steps"
      type: "list<record>"
      description: "按注册操作类型解析的迁移步骤；不能直接作为 shell。"
      required: true
      expression: false
    property "lock_timeout_ms"
      type: "int"
      description: "锁等待上限。"
      required: true
      expression: false
    property "statement_timeout_ms"
      type: "int"
      description: "语句超时。"
      required: true
      expression: false
    port "plan"
      type: "MigrationPlan"
      phase: "execution"
  rule #rule_PG_TYPED_SQL "PG_TYPED_SQL"
    level: "MUST"
    statement: |
      pg.* 字段类型与 UICL 通用类型分离。sql/default_sql/where_sql 是受方言检查的 SQL，不是 Core = 表达式；SQL 标识符必须正确引用，不拼接不可信文字。
    verification: "adapter"
    origin: "scenario-review-and-1.0-completion"
  rule #rule_PG_TRANSACTION_CONFLICT "PG_TRANSACTION_CONFLICT"
    level: "MUST"
    statement: |
      包含 concurrent 索引步骤的迁移与 atomic=required 冲突，必须拒绝或取得显式 split_allowed 修订；不能承诺事务外操作自动随事务回滚。
    verification: "planner"
    origin: "scenario-review-and-1.0-completion"
  rule #rule_PG_IDENTITY_AND_RLS "PG_IDENTITY_AND_RLS"
    level: "MUST"
    statement: |
      model 策略不自动等同于 RLS。角色、表所有者、BYPASSRLS、会话租户上下文及连接复用必须明确。列改名必须显式步骤，不按相似名称猜测删除重建。
    verification: "adapter-runtime"
    origin: "scenario-review-and-1.0-completion"

// source: profiles/08-testing.uicl
profile #profile_testing "测试与验收证据"
  id: "uicl.testing"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    测试声明、夹具、断言和验证记录；不会在读取时执行。
  requires:
    - "uicl.ui@1.0.0"
    - "uicl.backend@1.0.0"
    - "uicl.resource@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "check"
    - "criterion"
    - "evidence"
    - "expect"
    - "given"
    - "require"
    - "review"
    - "test"
    - "when"
  schema #s_test "test"
    summary: "有隔离级别与目标的测试。"
    primary: "title"
    identity: "required"
    children:
      - "given"
      - "when"
      - "then"
      - "expect"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "title"
      type: "text"
      description: "测试意图。"
      required: true
      expression: false
    property "kind"
      type: "text"
      description: "测试种类。"
      required: true
      expression: false
      enum:
        - "unit"
        - "integration"
        - "e2e"
        - "visual"
        - "a11y"
        - "adapter"
        - "security"
    property "verifies"
      type: "list<ref>"
      description: "关联的需求或规则。"
      required: false
      expression: false
    property "isolation"
      type: "text"
      description: "测试实例隔离。"
      required: true
      expression: false
      enum:
        - "ephemeral"
        - "sandbox"
    property "timeout_ms"
      type: "int"
      description: "测试超时。"
      required: false
      expression: false
      default: 30000
    port "evidence"
      type: "Evidence"
      phase: "execution"
  schema #s_given "given"
    summary: "测试阶段，动作仅作用于隔离环境。"
    primary: null
    identity: "optional"
    children:
      - "test.reset"
      - "test.open"
      - "test.fill"
      - "test.submit"
      - "test.click"
      - "test.execute"
      - "test.fixture"
      - "test.actor"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
  schema #s_when "when"
    summary: "测试阶段，动作仅作用于隔离环境。"
    primary: null
    identity: "optional"
    children:
      - "test.reset"
      - "test.open"
      - "test.fill"
      - "test.submit"
      - "test.click"
      - "test.execute"
      - "test.fixture"
      - "test.actor"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
  schema #s_test_reset "test.reset"
    summary: "清空隔离测试数据，禁止生产实例。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "resource"
      type: "ref"
      description: "测试数据源。"
      required: true
      expression: false
  schema #s_test_open "test.open"
    summary: "打开指定页面。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "page"
      type: "ref"
      description: "目标页面。"
      required: true
      expression: false
      targets:
        - "page"
  schema #s_test_fill "test.fill"
    summary: "向指定表单字段输入。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "target"
      type: "ref"
      description: "input/form。"
      required: true
      expression: false
      targets:
        - "ui.input"
        - "form"
    property "field"
      type: "text"
      description: "form 字段名。"
      required: false
      expression: false
    property "value"
      type: "value"
      description: "输入值。"
      required: true
      expression: false
  schema #s_test_submit "test.submit"
    summary: "提交指定表单。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "target"
      type: "ref"
      description: "表单。"
      required: true
      expression: false
      targets:
        - "form"
  schema #s_test_click "test.click"
    summary: "点击交互对象。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "target"
      type: "ref"
      description: "按钮。"
      required: true
      expression: false
      targets:
        - "ui.button"
  schema #s_test_execute "test.execute"
    summary: "调用动作并捕获结果或错误。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "action"
      type: "ref"
      description: "后端动作。"
      required: true
      expression: false
      targets:
        - "action"
    property "args"
      type: "record"
      description: "输入。"
      required: true
      expression: false
    port "result"
      type: "TestResult"
      phase: "execution"
  schema #s_test_fixture "test.fixture"
    summary: "隔离数据夹具；不绕过被测业务授权路径。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "model"
      type: "ref"
      description: "模型。"
      required: true
      expression: false
      targets:
        - "model"
        - "collection"
    property "rows"
      type: "list<record>"
      description: "初始记录。"
      required: true
      expression: false
  schema #s_test_actor "test.actor"
    summary: "注入测试身份，生产禁用。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "id"
      type: "text"
      description: "测试用户 ID。"
      required: true
      expression: false
    property "roles"
      type: "list<text>"
      description: "角色集合。"
      required: false
      expression: false
      default: []
  schema #s_expect "expect"
    summary: "测试断言；未评估不是通过。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "target"
      type: "ref"
      description: "目标对象或测试结果。"
      required: false
      expression: false
    property "contains"
      type: "text"
      description: "包含的可见文本。"
      required: false
      expression: false
    property "count"
      type: "int"
      description: "数量。"
      required: false
      expression: false
    property "equals"
      type: "value"
      description: "结构/标量期望值。"
      required: false
      expression: false
    property "error"
      type: "text"
      description: "预期错误码。"
      required: false
      expression: false
    property "test"
      type: "bool"
      description: "布尔表达式。"
      required: false
      expression: true
  schema #s_check "check"
    summary: "登记验证器的硬检查。"
    primary: "rule"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "rule"
      type: "text"
      description: "验证器标识。"
      required: true
      expression: false
    property "target"
      type: "ref"
      description: "待验证对象；缺省为外层产物。"
      required: false
      expression: false
    property "equals"
      type: "value"
      description: "期望值。"
      required: false
      expression: false
    property "min"
      type: "number"
      description: "下界。"
      required: false
      expression: false
    property "max"
      type: "number"
      description: "上界。"
      required: false
      expression: false
    property "required"
      type: "bool"
      description: "是否阻断发布。"
      required: false
      expression: false
      default: true
    port "evidence"
      type: "Evidence"
      phase: "execution"
  schema #s_require "require"
    summary: "所有必需检查必须 PASS 才满足。"
    primary: null
    identity: "optional"
    children:
      - "check"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
  schema #s_review "review"
    summary: "自然语言评审，必须记录评估者及证据。"
    primary: null
    identity: "optional"
    children:
      - "criterion"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "evaluator"
      type: "text"
      description: "评估器绑定或 human。"
      required: false
      expression: false
      default: "human"
  schema #s_criterion "criterion"
    summary: "自然语言评价维度。"
    primary: "text"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "text"
      type: "text"
      description: "评审标准，不会直接编译为确定性检查。"
      required: true
      expression: false
  schema #s_evidence "evidence"
    summary: "绑定真实检查输入和结果的记录。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "subject_digest"
      type: "text"
      description: "被测产物摘要。"
      required: true
      expression: false
    property "contract_digest"
      type: "text"
      description: "规格摘要。"
      required: true
      expression: false
    property "validator"
      type: "text"
      description: "验证器与版本。"
      required: true
      expression: false
    property "status"
      type: "text"
      description: "实际状态。"
      required: true
      expression: false
      enum:
        - "PASS"
        - "FAIL"
        - "ERROR"
        - "NOT_EVALUATED"
    property "report"
      type: "ref"
      description: "具体报告。"
      required: false
      expression: false
  rule #rule_TEST_ISOLATION "TEST_ISOLATION"
    level: "MUST"
    statement: |
      reset/fixture/actor 注入只能作用于隔离测试实例。测试文件不能授予生产权限；自动生成的测试不代替独立业务验收。
    verification: "runtime"
    origin: "conversation-design"
  rule #rule_TEST_EVIDENCE "TEST_EVIDENCE"
    level: "MUST"
    statement: |
      证据绑定实际产物、契约、验证器版本及输入摘要。旧产物的通过记录不能用于新产物。NOT_EVALUATED/ERROR 不满足 require；被测 Agent 不能自行删除门禁。
    verification: "runtime"
    origin: "conversation-design"

// source: profiles/09-deployment.uicl
profile #profile_deployment "构建、受管资源与部署计划"
  id: "uicl.deployment"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    不可变产物、受管状态、计划、外部授权及执行回执。
  requires:
    - "uicl.core@1.0.0"
    - "uicl.resource@1.0.0"
    - "uicl.testing@1.0.0"
  origin: "scenario-review-and-1.0-completion"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "build"
    - "deployment"
    - "execution"
    - "managed"
    - "plan"
  record_schema #r_PlanState "PlanState"
    summary: "持久受管状态。"
    unknown_fields: "reject"
    property "binding"
      type: "text"
      description: "状态存储绑定名，不含秘密。"
      required: true
      expression: false
    property "locking"
      type: "text"
      description: "并发应用锁。"
      required: true
      expression: false
      enum:
        - "required"
    property "encryption"
      type: "text"
      description: "状态加密要求。"
      required: false
      expression: false
      default: "required"
  schema #s_build "build"
    summary: "由源契约生成不可变产物的任务声明。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "build.execute"
    category: "declaration"
    property "source"
      type: "ref"
      description: "源契约或源码。"
      required: true
      expression: false
    property "target"
      type: "ref"
      description: "目标工具链。"
      required: true
      expression: false
      targets:
        - "target"
    property "artifact_type"
      type: "text"
      description: "产物类型。"
      required: true
      expression: false
    property "embed"
      type: "list<ref>"
      description: "明确嵌入的其他构建输出。"
      required: false
      expression: false
    property "toolchain_binding"
      type: "text"
      description: "执行时解析的工具链锁。"
      required: true
      expression: false
    property "depends_on"
      type: "list<ref>"
      description: "显式计划前置依赖；兄弟声明顺序不代表部署顺序。"
      required: false
      expression: false
    property "entrypoint"
      type: "text"
      description: "输出包内应用入口，由目标适配器验证。"
      required: false
      expression: false
    property "static_mount"
      type: "text"
      description: "嵌入静态产物的应用 URL 前缀，由锁定适配器实现。"
      required: false
      expression: false
    port "output"
      type: "Artifact"
      phase: "execution"
  schema #s_managed_resource "managed.resource"
    summary: "通用受管资源抽象的标准入口；提供方扩展需给 schema。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "managed-resource"
    property "provider"
      type: "text"
      description: "适配器。"
      required: true
      expression: false
    property "external_id"
      type: "text"
      description: "接管已有资源时的真实 ID。"
      required: false
      expression: false
    property "desired"
      type: "record"
      description: "提供方验证的期望状态。"
      required: true
      expression: false
    property "managed_fields"
      type: "list<text>"
      description: "明确管理的字段。"
      required: true
      expression: false
    property "on_remove"
      type: "text"
      description: "删除策略。"
      required: true
      expression: false
      enum:
        - "retain"
        - "approval_required"
    property "import_policy"
      type: "text"
      description: "已有资源接管规则。"
      required: true
      expression: false
      enum:
        - "require_import"
    property "depends_on"
      type: "list<ref>"
      description: "显式计划前置依赖；兄弟声明顺序不代表部署顺序。"
      required: false
      expression: false
  schema #s_deployment "deployment"
    summary: "将期望状态解析成计划，不自动 apply。"
    primary: "name"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "deploy.apply"
    category: "declaration"
    property "name"
      type: "text"
      description: "环境名。"
      required: false
      expression: false
    property "resources"
      type: "list<ref>"
      description: "受管资源集合。"
      required: true
      expression: false
    property "state"
      type: "record<PlanState>"
      description: "状态与锁。"
      required: true
      expression: false
    property "existing_resources"
      type: "text"
      description: "碰到已有对象的规则。"
      required: true
      expression: false
      enum:
        - "require_import"
    property "approval"
      type: "text"
      description: "计划应用需外部批准。"
      required: true
      expression: false
      enum:
        - "required"
    property "gates"
      type: "list<ref>"
      description: "必需通过的测试/检查。"
      required: false
      expression: false
    port "plan"
      type: "Plan"
      phase: "execution"
    port "record"
      type: "ExecutionRecord"
      phase: "execution"
  schema #s_plan "plan"
    summary: "可审阅的执行计划元记录。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "subject"
      type: "ref"
      description: "部署/迁移/生成任务。"
      required: true
      expression: false
    property "expected_state"
      type: "text"
      description: "被观察状态版本摘要。"
      required: true
      expression: false
    property "steps"
      type: "list<record>"
      description: "有依赖、前置/后置与恢复分类的步骤。"
      required: true
      expression: false
    property "approval_binding"
      type: "text"
      description: "外部批准服务引用，不是批准本身。"
      required: true
      expression: false
  schema #s_execution_record "execution.record"
    summary: "持久执行回执。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "plan_digest"
      type: "text"
      description: "实际计划摘要。"
      required: true
      expression: false
    property "state"
      type: "text"
      description: "执行状态。"
      required: true
      expression: false
      enum:
        - "PENDING"
        - "RUNNING"
        - "SUCCEEDED"
        - "FAILED"
        - "INDETERMINATE"
        - "CANCELLED"
    property "steps"
      type: "list<record>"
      description: "逐步骤回执与观察到的外部 ID。"
      required: true
      expression: false
    property "secrets"
      type: "text"
      description: "只允许 redact。"
      required: true
      expression: false
      enum:
        - "redact"
  rule #rule_DEPLOY_PLAN "DEPLOY_PLAN"
    level: "MUST"
    statement: |
      observe/plan/apply 分开。仅管理显式接管的资源与字段，不因源码缺失而删除外部对象。应用计划时核对状态版本、锁和外部审批，漂移必须重新计划。
    verification: "planner-runtime"
    origin: "scenario-review-and-1.0-completion"
  rule #rule_DEPLOY_RECOVERY "DEPLOY_RECOVERY"
    level: "MUST"
    statement: |
      部分成功保留外部身份和回执。网络中断/超时可能 INDETERMINATE，先 observe/reconcile，不盲目重复副作用。应用、结构、数据恢复分别声明。
    verification: "runtime"
    origin: "scenario-review-and-1.0-completion"
  rule #rule_DEPLOY_SINGLE_OWNER "DEPLOY_SINGLE_OWNER"
    level: "MUST"
    statement: |
      同一资源或字段只有一个明确管理者；生成配置是派生文件，不与控制台/其他工具独立维护同一字段事实来源。批准与签名不是源码字段自我授予。
    verification: "planner-runtime"
    origin: "scenario-review-and-1.0-completion"

// source: profiles/10-aigc.uicl
profile #profile_aigc "生成内容规格与任务"
  id: "uicl.aigc"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    文本、图片、视频、音频、演示文稿；规格与产物分离。
  requires:
    - "uicl.resource@1.0.0"
    - "uicl.design@1.0.0"
    - "uicl.testing@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "audio"
    - "cue"
    - "deck"
    - "generate"
    - "image"
    - "overlay"
    - "scene"
    - "shot"
    - "slide"
    - "subject"
    - "text"
    - "track"
    - "video"
  record_schema #r_Ratio "Ratio"
    summary: "有理数比率。"
    unknown_fields: "reject"
    property "num"
      type: "int"
      description: "分子。"
      required: true
      expression: false
    property "den"
      type: "int"
      description: "正分母。"
      required: true
      expression: false
  schema #s_text "text"
    summary: "文本生成规格，与 ui.text 不同。"
    primary: "label"
    identity: "required"
    children:
      - "require"
      - "review"
    unknown_properties: "reject"
    effects: []
    category: "spec"
    property "label"
      type: "text"
      description: "规格名称。"
      required: false
      expression: false
    property "prompt"
      type: "text"
      description: "生成意图。"
      required: true
      expression: true
    property "language"
      type: "text"
      description: "输出语言。"
      required: true
      expression: false
    property "sources"
      type: "list<ref>"
      description: "显式输入资料。"
      required: false
      expression: false
    property "prefer"
      type: "record"
      description: "语气、结构等偏好，不作硬保证。"
      required: false
      expression: false
  schema #s_image "image"
    summary: "图像生成规格，不是已有文件。"
    primary: "label"
    identity: "required"
    children:
      - "scene"
      - "overlay"
      - "require"
      - "review"
    unknown_properties: "reject"
    effects: []
    category: "spec"
    property "label"
      type: "text"
      description: "规格名称。"
      required: false
      expression: false
    property "prompt"
      type: "text"
      description: "画面意图。"
      required: true
      expression: true
    property "size"
      type: "list<int>"
      description: "[width,height]。"
      required: true
      expression: false
    property "color_space"
      type: "text"
      description: "色彩空间。"
      required: false
      expression: false
      default: "srgb"
    property "references"
      type: "list<ref>"
      description: "参考产物。"
      required: false
      expression: false
    property "prefer"
      type: "record"
      description: "视觉偏好，适配器报告支持程度。"
      required: false
      expression: false
  schema #s_scene "scene"
    summary: "图像场景层。"
    primary: null
    identity: "optional"
    children:
      - "subject"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "background"
      type: "text"
      description: "背景意图。"
      required: false
      expression: false
  schema #s_subject "subject"
    summary: "一个主要对象的期望描述。"
    primary: "label"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "label"
      type: "text"
      description: "主体说明。"
      required: true
      expression: false
    property "count"
      type: "int"
      description: "期望数量，须检查或评审。"
      required: false
      expression: false
      default: 1
    property "region"
      type: "list<number>"
      description: "归一化 [x,y,w,h]。"
      required: true
      expression: false
  schema #s_overlay "overlay"
    summary: "精确合成层。"
    primary: null
    identity: "optional"
    children:
      - "overlay.text"
      - "overlay.image"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
  schema #s_overlay_text "overlay.text"
    summary: "确定性排版的文字图层。"
    primary: "value"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "value"
      type: "text"
      description: "要精确排版的文字。"
      required: true
      expression: false
    property "region"
      type: "list<number>"
      description: "归一化矩形。"
      required: true
      expression: false
    property "font"
      type: "text"
      description: "锁定字体绑定。"
      required: true
      expression: false
    property "font_px"
      type: "int"
      description: "字号。"
      required: true
      expression: false
    property "align"
      type: "text"
      description: "对齐方式。"
      required: false
      expression: false
      default: "left"
  schema #s_overlay_image "overlay.image"
    summary: "已存在图片合成层。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "src"
      type: "ref"
      description: "图片产物。"
      required: true
      expression: false
    property "region"
      type: "list<number>"
      description: "归一化矩形。"
      required: true
      expression: false
  schema #s_video "video"
    summary: "视频生成与合成规格。"
    primary: "label"
    identity: "required"
    children:
      - "track"
      - "require"
      - "review"
    unknown_properties: "reject"
    effects: []
    category: "spec"
    property "label"
      type: "text"
      description: "视频名称。"
      required: false
      expression: false
    property "size"
      type: "list<int>"
      description: "画幅。"
      required: true
      expression: false
    property "fps"
      type: "record<Ratio>"
      description: "帧率有理数。"
      required: true
      expression: false
    property "frames"
      type: "int"
      description: "总帧数。"
      required: true
      expression: false
  schema #s_track "track"
    summary: "视频/字幕/音轨。"
    primary: null
    identity: "required"
    children:
      - "shot"
      - "cue"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "kind"
      type: "text"
      description: "轨道类型。"
      required: true
      expression: false
      enum:
        - "video"
        - "subtitles"
        - "audio"
    property "overlap"
      type: "text"
      description: "同轨重叠处理。"
      required: false
      expression: false
      default: "forbid"
      enum:
        - "forbid"
        - "allow"
  schema #s_shot "shot"
    summary: "位于整数时间轴的镜头。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "start_frame"
      type: "int"
      description: "起始帧。"
      required: true
      expression: false
    property "frames"
      type: "int"
      description: "持续帧数。"
      required: true
      expression: false
    property "prompt"
      type: "text"
      description: "镜头意图。"
      required: true
      expression: false
    property "reference"
      type: "ref"
      description: "角色或产品参考。"
      required: false
      expression: false
  schema #s_cue "cue"
    summary: "字幕/音轨片段。"
    primary: "text"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "text"
      type: "text"
      description: "文字。"
      required: true
      expression: false
    property "start_frame"
      type: "int"
      description: "开始帧。"
      required: true
      expression: false
    property "frames"
      type: "int"
      description: "持续帧数。"
      required: true
      expression: false
  schema #s_audio "audio"
    summary: "音频规格。"
    primary: "label"
    identity: "required"
    children:
      - "require"
      - "review"
    unknown_properties: "reject"
    effects: []
    category: "spec"
    property "label"
      type: "text"
      description: "名称。"
      required: false
      expression: false
    property "text"
      type: "text"
      description: "朗读文字。"
      required: true
      expression: false
    property "voice_binding"
      type: "text"
      description: "合规声音绑定，不假定已获克隆许可。"
      required: true
      expression: false
    property "sample_rate"
      type: "int"
      description: "采样率。"
      required: true
      expression: false
    property "channels"
      type: "int"
      description: "声道数。"
      required: true
      expression: false
  schema #s_deck "deck"
    summary: "可编辑演示文稿规格。"
    primary: "label"
    identity: "required"
    children:
      - "slide"
      - "require"
      - "review"
    unknown_properties: "reject"
    effects: []
    category: "spec"
    property "label"
      type: "text"
      description: "演示名称。"
      required: false
      expression: false
    property "ratio"
      type: "text"
      description: "画幅比例。"
      required: true
      expression: false
    property "editable"
      type: "bool"
      description: "对象可编辑要求。"
      required: true
      expression: false
    property "design"
      type: "ref"
      description: "共享设计系统。"
      required: false
      expression: false
      targets:
        - "design"
  schema #s_slide "slide"
    summary: "一页幻灯片。"
    primary: "title"
    identity: "required"
    children:
      - "slide.text"
      - "slide.image"
      - "slide.chart"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "title"
      type: "text"
      description: "页面标题。"
      required: true
      expression: false
    property "layout"
      type: "text"
      description: "锁定布局名。"
      required: true
      expression: false
    property "notes"
      type: "text"
      description: "演讲备注。"
      required: false
      expression: false
  schema #s_slide_text "slide.text"
    summary: "幻灯片文字对象。"
    primary: "value"
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "value"
      type: "text"
      description: "文字内容。"
      required: true
      expression: false
  schema #s_slide_image "slide.image"
    summary: "幻灯片图片。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "src"
      type: "ref"
      description: "实际图片或任务产物。"
      required: true
      expression: false
    property "alt"
      type: "text"
      description: "图片说明。"
      required: true
      expression: false
  schema #s_slide_chart "slide.chart"
    summary: "有真实数据的图表。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "kind"
      type: "text"
      description: "图表类型。"
      required: true
      expression: false
    property "data"
      type: "list<record>"
      description: "图表数据；缺失不能臆造。"
      required: true
      expression: false
    property "editable"
      type: "bool"
      description: "是否要求原生可编辑图表。"
      required: true
      expression: false
  schema #s_generate "generate"
    summary: "把规格转成实际产物的任务。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "model.generate"
    category: "declaration"
    property "from"
      type: "ref"
      description: "规格节点。"
      required: true
      expression: false
      targets:
        - "image"
        - "text"
        - "video"
        - "audio"
        - "deck"
        - "design.canvas"
        - "document.spec"
    property "phase"
      type: "text"
      description: "执行阶段。"
      required: true
      expression: false
      enum:
        - "build"
        - "explicit_runtime"
    property "output"
      type: "text"
      description: "输出媒体类型。"
      required: true
      expression: false
    property "binding"
      type: "text"
      description: "实际生成/合成适配器。"
      required: true
      expression: false
    property "limits"
      type: "record<CallLimits>"
      description: "时间、次数与费用预算。"
      required: true
      expression: false
    property "approval"
      type: "text"
      description: "外部生成授权。"
      required: true
      expression: false
      enum:
        - "required"
    port "output"
      type: "Artifact"
      phase: "execution"
  rule #rule_AIGC_CONTRACT "AIGC_CONTRACT"
    level: "MUST"
    statement: |
      Spec、Generator、Task、Artifact、Slot 不可隐式互换。@generate.output 仅建立依赖；读取文件、预览、检查或页面重绘不得自动触发生成或收费。
    verification: "type-effect-runtime"
    origin: "conversation-design"
  rule #rule_AIGC_GATES "AIGC_GATES"
    level: "MUST"
    statement: |
      require 为注册检查，prefer 为偏好，review 为评审。不能把硬要求悄悄降级成 prompt；适配器不支持时报告 UNSUPPORTED_CAPABILITY。生成结果必须本地验证且绑定证据。
    verification: "adapter-validation"
    origin: "conversation-design"
  rule #rule_AIGC_TIMELINE "AIGC_TIMELINE"
    level: "MUST"
    statement: |
      视频时间用整数帧及有理数帧率；检查边界与重叠。editable deck 的文字/图表不能用整页截图冒充。字体和输入资产必须锁定且有使用权。
    verification: "artifact-validation"
    origin: "conversation-design"

// source: profiles/11-agent.uicl
profile #profile_agent "Agent 定义与工具契约"
  id: "uicl.agent"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    统一 Agent 输入输出、工具、记忆、预算、停止和人工升级。
  requires:
    - "uicl.core@1.0.0"
    - "uicl.resource@1.0.0"
    - "uicl.testing@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "agent"
    - "tool"
  record_schema #r_AgentMemory "AgentMemory"
    summary: "记忆安全与生命周期。"
    unknown_fields: "reject"
    property "scope"
      type: "text"
      description: "隔离范围。"
      required: true
      expression: false
      enum:
        - "session"
        - "user"
        - "tenant"
    property "retention_days"
      type: "int"
      description: "保留时长。"
      required: true
      expression: false
    property "secrets"
      type: "text"
      description: "不保存秘密。"
      required: true
      expression: false
      enum:
        - "deny"
    property "binding"
      type: "text"
      description: "可选记忆存储适配器。"
      required: false
      expression: false
  record_schema #r_AgentPolicy "AgentPolicy"
    summary: "宿主应强制的限制。"
    unknown_fields: "reject"
    property "tool_scope"
      type: "text"
      description: "仅允许声明工具。"
      required: true
      expression: false
      enum:
        - "declared_only"
    property "external_writes"
      type: "text"
      description: "外部写操作处理。"
      required: true
      expression: false
      enum:
        - "deny"
        - "approval_required"
    property "delegation_depth"
      type: "int"
      description: "子 Agent 最大深度。"
      required: true
      expression: false
    property "data_egress"
      type: "text"
      description: "输入出站授权。"
      required: true
      expression: false
      enum:
        - "deny"
        - "approved_only"
  schema #s_tool "tool"
    summary: "可调用的固定工具接口。"
    primary: "name"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "工具说明。"
      required: false
      expression: false
    property "adapter"
      type: "text"
      description: "例如 mcp/local/http 的接口实现。"
      required: true
      expression: false
    property "binding"
      type: "text"
      description: "真实宿主绑定。"
      required: true
      expression: false
    property "input"
      type: "record"
      description: "输入形状。"
      required: true
      expression: false
    property "output"
      type: "text|ref"
      description: "输出类型。"
      required: true
      expression: false
    property "effects"
      type: "list<text>"
      description: "副作用清单。"
      required: true
      expression: false
    property "permissions"
      type: "list<text>"
      description: "请求能力。"
      required: true
      expression: false
  schema #s_agent "agent"
    summary: "Agent 规格，不因定义而开始运行。"
    primary: "name"
    identity: "required"
    children:
      - "require"
      - "review"
    unknown_properties: "reject"
    effects: []
    category: "agent"
    property "name"
      type: "text"
      description: "Agent 名称。"
      required: false
      expression: false
    property "input"
      type: "record"
      description: "输入形状。"
      required: true
      expression: false
    property "output"
      type: "text|ref"
      description: "输出类型。"
      required: true
      expression: false
    property "model_binding"
      type: "text"
      description: "模型适配器绑定。"
      required: true
      expression: false
    property "tools"
      type: "list<ref>"
      description: "允许工具。"
      required: true
      expression: false
      targets:
        - "tool"
    property "instructions"
      type: "text"
      description: "行为意图；非授权。"
      required: true
      expression: false
    property "memory"
      type: "record<AgentMemory>"
      description: "记忆契约。"
      required: true
      expression: false
    property "limits"
      type: "record<CallLimits>"
      description: "预算。"
      required: true
      expression: false
    property "policy"
      type: "record<AgentPolicy>"
      description: "宿主强制策略。"
      required: true
      expression: false
    property "on_exhausted"
      type: "text"
      description: "预算耗尽策略。"
      required: true
      expression: false
      enum:
        - "stop"
        - "human_review"
    port "output"
      type: "dynamic"
      phase: "execution"
  schema #s_agent_run "agent.run"
    summary: "显式执行 Agent。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "agent.execute"
    category: "declaration"
    property "agent"
      type: "ref"
      description: "Agent 规格。"
      required: true
      expression: false
      targets:
        - "agent"
    property "args"
      type: "record"
      description: "输入。"
      required: true
      expression: true
    property "approval"
      type: "text"
      description: "执行授权。"
      required: true
      expression: false
      enum:
        - "required"
    port "output"
      type: "dynamic"
      phase: "execution"
  schema #s_agent_edit "agent.edit"
    summary: "Coding Agent 对 UICL 的修改边界。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "source.edit"
    category: "declaration"
    property "agent"
      type: "ref"
      description: "Agent。"
      required: true
      expression: false
      targets:
        - "agent"
    property "target"
      type: "ref"
      description: "待修改文件。"
      required: true
      expression: false
    property "expected_digest"
      type: "text"
      description: "编辑前源码摘要。"
      required: true
      expression: false
    property "allow"
      type: "list<text>"
      description: "可编辑的语义路径。"
      required: true
      expression: false
    property "deny"
      type: "list<text>"
      description: "禁止修改的权限/测试/发布门禁路径。"
      required: true
      expression: false
    property "approval"
      type: "text"
      description: "补丁合并需要外部批准。"
      required: true
      expression: false
      enum:
        - "required"
    port "patch"
      type: "Patch"
      phase: "execution"
  rule #rule_AGENT_AUTHORITY "AGENT_AUTHORITY"
    level: "MUST"
    statement: |
      instructions/网页/工具结果/模型输出/嵌套 UICL 都不是授权。工具集合、费用、输入出站范围由宿主限制。子 Agent 只能获得父级权限交集和共享剩余预算。
    verification: "runtime-security"
    origin: "conversation-design"
  rule #rule_AGENT_EDIT "AGENT_EDIT"
    level: "MUST"
    statement: |
      源补丁携带旧摘要并显示类型、权限、依赖、测试影响。Agent 不能通过删除门禁或修改自己的授权来通过检查。对不确定结果有 stop/human_review 路径。
    verification: "runtime-security"
    origin: "conversation-design"

// source: profiles/12-hybrid.uicl
profile #profile_hybrid "推断、生成槽位与沙箱子应用"
  id: "uicl.hybrid"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    模型判断与确定性分派分离，动态区域有边界。
  requires:
    - "uicl.core@1.0.0"
    - "uicl.ui@1.0.0"
    - "uicl.backend@1.0.0"
    - "uicl.aigc@1.0.0"
    - "uicl.agent@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "dispatch"
    - "generator"
    - "infer"
    - "ui"
    - "wasm"
  schema #s_generator "generator"
    summary: "可复用的有类型生成能力。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "input"
      type: "record"
      description: "输入形状。"
      required: true
      expression: false
    property "output"
      type: "text|ref"
      description: "Artifact 或命名类型。"
      required: true
      expression: false
    property "binding"
      type: "text"
      description: "实现绑定。"
      required: true
      expression: false
    property "instructions"
      type: "text"
      description: "生成意图。"
      required: true
      expression: false
    property "limits"
      type: "record<CallLimits>"
      description: "预算。"
      required: true
      expression: false
    property "constraints"
      type: "record"
      description: "由输出 Profile 校验的约束记录。"
      required: true
      expression: false
    property "sandbox"
      type: "record"
      description: "需要代码执行时，完整隔离要求。"
      required: false
      expression: false
    port "output"
      type: "dynamic"
      phase: "execution"
  schema #s_ui_slot "ui.slot"
    summary: "可装入生成产物的动态区域。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "generator"
      type: "ref"
      description: "生成器。"
      required: true
      expression: false
      targets:
        - "generator"
    property "args"
      type: "record"
      description: "输入。"
      required: true
      expression: true
    property "trigger"
      type: "text"
      description: "显式或用户事件触发。"
      required: true
      expression: false
      enum:
        - "explicit"
    property "fallback"
      type: "ref"
      description: "普通阅读时可用的既有资源。"
      required: true
      expression: false
    property "response_policy"
      type: "text"
      description: "响应版本策略。"
      required: false
      expression: false
      default: "latest_wins"
      enum:
        - "latest_wins"
  schema #s_infer "infer"
    summary: "模型推断节点，只把结果作为数据。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "model.infer"
    category: "declaration"
    property "using"
      type: "ref"
      description: "有类型能力/Agent/生成器。"
      required: true
      expression: false
      targets:
        - "capability"
        - "agent"
        - "generator"
    property "args"
      type: "record"
      description: "输入。"
      required: true
      expression: true
    property "on_error"
      type: "ref"
      description: "固定失败动作。"
      required: true
      expression: false
      targets:
        - "action"
    port "result"
      type: "dynamic"
      phase: "execution"
  schema #s_dispatch "dispatch"
    summary: "固定白名单分派。"
    primary: null
    identity: "optional"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "value"
      type: "value"
      description: "枚举推断值。"
      required: true
      expression: true
    property "routes"
      type: "record"
      description: "枚举文字到已声明动作的映射。"
      required: true
      expression: false
    property "on_unknown"
      type: "ref"
      description: "未识别值/非法输出路径。"
      required: true
      expression: false
      targets:
        - "action"
  schema #s_wasm_sandbox "wasm.sandbox"
    summary: "Wasm 实例化契约，不是任意源码的安全保证。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "sandbox.execute"
    category: "declaration"
    property "artifact"
      type: "ref"
      description: "已编译验证的 Wasm 产物。"
      required: true
      expression: false
    property "interface"
      type: "text"
      description: "宿主接口版本。"
      required: true
      expression: false
    property "imports"
      type: "list<text>"
      description: "允许导入白名单。"
      required: true
      expression: false
    property "network"
      type: "text"
      description: "网络权限。"
      required: true
      expression: false
      enum:
        - "deny"
    property "filesystem"
      type: "text"
      description: "文件权限。"
      required: true
      expression: false
      enum:
        - "deny"
    property "memory_mib"
      type: "int"
      description: "内存上限。"
      required: true
      expression: false
    property "fuel"
      type: "int"
      description: "执行步数预算。"
      required: true
      expression: false
    property "timeout_ms"
      type: "int"
      description: "墙钟超时。"
      required: true
      expression: false
    property "max_nesting"
      type: "int"
      description: "嵌套深度。"
      required: true
      expression: false
    property "approval"
      type: "text"
      description: "实例化外部授权。"
      required: true
      expression: false
      enum:
        - "required"
  rule #rule_HYBRID_INFER "HYBRID_INFER"
    level: "MUST"
    statement: |
      模型只提供通过本地类型检查的数据。dispatch 映射固定且必须覆盖枚举或显式 unknown；不得接受模型给出的任意函数/命令。timeout/refusal/非法值进入错误路径。
    verification: "type-runtime"
    origin: "conversation-design"
  rule #rule_HYBRID_UI "HYBRID_UI"
    level: "MUST"
    statement: |
      动态 UI 限定允许组件、最大节点/深度、可绑定数据与动作。Wasm 必须经过编译、类型、导入与测试检查；宿主仍负责权限和资源限制。
    verification: "adapter-runtime"
    origin: "conversation-design"

// source: profiles/13-document.uicl
profile #profile_document "原生文档与结构化文档规格"
  id: "uicl.document"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    Markdown/HTML 正文是发布内容事实源，注解附加契约。
  requires:
    - "uicl.core@1.0.0"
    - "uicl.resource@1.0.0"
    - "uicl.testing@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "doc"
    - "document"
  schema #s_doc_block "doc.block"
    summary: "绑定原生正文，不复制第二份正文。"
    primary: null
    identity: "required"
    children:
      - "require"
      - "review"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "target"
      type: "text|record"
      description: "next 或 {html_id:...}，由宿主解析。"
      required: true
      expression: false
    property "intent"
      type: "text"
      description: "编辑/内容意图，不当作硬规则。"
      required: false
      expression: false
    property "spec"
      type: "ref"
      description: "可选关联的生成规格。"
      required: false
      expression: false
    property "expected_digest"
      type: "text"
      description: "补丁前正文版本。"
      required: false
      expression: false
  schema #s_document_spec "document.spec"
    summary: "文档生成规格，可要求导出可编辑文档。"
    primary: "label"
    identity: "required"
    children:
      - "doc.section"
      - "require"
      - "review"
    unknown_properties: "reject"
    effects: []
    category: "spec"
    property "label"
      type: "text"
      description: "标题。"
      required: false
      expression: false
    property "language"
      type: "text"
      description: "语言。"
      required: true
      expression: false
    property "output"
      type: "text"
      description: "媒体类型。"
      required: true
      expression: false
    property "editable"
      type: "bool"
      description: "保留语义结构的要求。"
      required: true
      expression: false
  schema #s_doc_section "doc.section"
    summary: "具有标题和原生正文的文档部分。"
    primary: "title"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "title"
      type: "text"
      description: "章节名。"
      required: true
      expression: false
    property "body"
      type: "text"
      description: "Markdown 或纯文正文。"
      required: true
      expression: false
    property "format"
      type: "text"
      description: "正文方言。"
      required: false
      expression: false
      default: "markdown"
  rule #rule_HOST_PARSE_FIRST "HOST_PARSE_FIRST"
    level: "MUST"
    statement: |
      先由宿主解析真实注释/数据块；代码围栏、script/style/textarea/template 或转义文本中的标记不激活。Markdown 注解仅文档级列零独立块。错误不能静默降级为 Markdown。
    verification: "host-parser"
    origin: "conversation-design"
  rule #rule_HOST_PRESERVATION "HOST_PRESERVATION"
    level: "MUST"
    statement: |
      无操作保存必须字节不变，补丁外字节保持。正文为唯一可编辑事实源；注解只存规格/检查/来源。改后缀承诺锁定宿主下静态可读，不承诺所有渲染器像素或任意脚本行为不变。
    verification: "host-editor"
    origin: "conversation-design"
  rule #rule_HOST_BOUNDARY "HOST_BOUNDARY"
    level: "MUST"
    statement: |
      注释/script 的终止边界不能靠 UICL 字符串引号保护；复杂载荷使用严格 Base64url 编码。编码不是加密。next 绑定不到对象时报错；机器编辑检查旧摘要。
    verification: "host-parser"
    origin: "conversation-design"

// source: profiles/14-dataset.uicl
profile #profile_dataset "训练样本与来源血缘"
  id: "uicl.dataset"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    记录规格、产物、来源、许可、评估及拆分分组。
  requires:
    - "uicl.resource@1.0.0"
    - "uicl.testing@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "dataset"
    - "sample"
  schema #s_dataset "dataset"
    summary: "样本集合与拆分原则。"
    primary: "name"
    identity: "required"
    children:
      - "sample"
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "数据集名。"
      required: false
      expression: false
    property "purpose"
      type: "text"
      description: "明确用途。"
      required: true
      expression: false
    property "split_policy"
      type: "text"
      description: "以共同来源分组防泄漏。"
      required: true
      expression: false
      enum:
        - "source_group"
    property "permission"
      type: "text"
      description: "许可核验状态。"
      required: true
      expression: false
      enum:
        - "verified"
        - "unverified"
    property "loader"
      type: "text"
      description: "还原原生模态的加载方式。"
      required: true
      expression: false
  schema #s_sample "sample"
    summary: "有可追踪输入输出的一条样本。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "source_group"
      type: "text"
      description: "同源文档/图像/投影共享的分组。"
      required: true
      expression: false
    property "input"
      type: "ref"
      description: "任务规格或原文资源。"
      required: true
      expression: false
    property "output"
      type: "ref"
      description: "实际产物，不能引用未执行生成任务假装存在。"
      required: true
      expression: false
    property "license"
      type: "text"
      description: "内容权利/许可，unknown 不允许训练。"
      required: true
      expression: false
    property "consent"
      type: "text"
      description: "必要同意证据或核验状态。"
      required: true
      expression: false
    property "sensitivity"
      type: "text"
      description: "敏感性。"
      required: true
      expression: false
    property "evidence"
      type: "list<ref>"
      description: "验证记录。"
      required: false
      expression: false
  rule #rule_DATASET_RIGHTS "DATASET_RIGHTS"
    level: "MUST"
    statement: |
      采用 .uicl 或 HEXL 不改变用户内容权利，不表示允许训练、公开或转让。许可、同意未知时必须阻断数据发布/训练。原始来源同组拆分。
    verification: "governance-runtime"
    origin: "conversation-design"
  rule #rule_DATASET_MODALITY "DATASET_MODALITY"
    level: "MUST"
    statement: |
      交换层可以文本封装；训练层根据模态解码，不将 Base64 当作视觉语义。统一格式提升模型能力属于待实验假设。
    verification: "loader-evaluation"
    origin: "conversation-design"

// source: profiles/15-native.uicl
profile #profile_native "桌面原生 API 与系统操作"
  id: "uicl.native"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    原生 API 通过受限类型边界、进程、ABI 和恢复契约接入。
  requires:
    - "uicl.core@1.0.0"
    - "uicl.resource@1.0.0"
  origin: "scenario-review-and-1.0-completion"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "native"
  record_schema #r_NativePolicy "NativePolicy"
    summary: "允许系统对象与权限。"
    unknown_fields: "reject"
    property "allowed_objects"
      type: "list<text>"
      description: "允许操作的对象白名单。"
      required: true
      expression: false
    property "execution"
      type: "text"
      description: "执行进程位置。"
      required: true
      expression: false
      enum:
        - "user_process"
        - "elevated_broker"
    property "approval"
      type: "text"
      description: "每次系统写操作须外部批准。"
      required: true
      expression: false
      enum:
        - "each_invocation"
  record_schema #r_NativeRecovery "NativeRecovery"
    summary: "系统修改恢复条件。"
    unknown_fields: "reject"
    property "capture_before"
      type: "bool"
      description: "先保存旧值。"
      required: true
      expression: false
    property "restore"
      type: "text"
      description: "仅当前值仍为本次写入值时恢复。"
      required: true
      expression: false
      enum:
        - "compare_and_set"
        - "not_supported"
  schema #s_native_operation "native.operation"
    summary: "有 ABI/权限边界的原生能力。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "native.invoke"
    category: "declaration"
    property "interface"
      type: "text"
      description: "版本化系统操作接口。"
      required: true
      expression: false
    property "implementation"
      type: "ref"
      description: "源码文件。"
      required: true
      expression: false
      targets:
        - "file"
    property "entry"
      type: "text"
      description: "已知入口。"
      required: true
      expression: false
    property "input"
      type: "record"
      description: "输入类型。"
      required: true
      expression: false
    property "output"
      type: "text|ref"
      description: "结果类型。"
      required: true
      expression: false
    property "effects"
      type: "list<text>"
      description: "系统副作用。"
      required: true
      expression: false
    property "policy"
      type: "record<NativePolicy>"
      description: "白名单与执行权限。"
      required: true
      expression: false
    property "recovery"
      type: "record<NativeRecovery>"
      description: "恢复。"
      required: true
      expression: false
    property "threading"
      type: "text"
      description: "线程/单元模型要求。"
      required: true
      expression: false
    property "errors"
      type: "list<text>"
      description: "失败分类。"
      required: true
      expression: false
    port "output"
      type: "dynamic"
      phase: "execution"
  rule #rule_NATIVE_BROKER "NATIVE_BROKER"
    level: "MUST"
    statement: |
      界面按普通权限运行；提权由受控 broker 和操作系统授权完成。IPC 验证调用方和输入白名单。effects 是声明，不是任意原生代码的隔离证明。
    verification: "os-adapter"
    origin: "scenario-review-and-1.0-completion"
  rule #rule_NATIVE_LIFETIME "NATIVE_LIFETIME"
    level: "MUST"
    statement: |
      ABI、架构、线程、句柄所有权、回调、取消与错误映射必须在接口中固定。恢复 compare-and-set，外部已修改时返回 CONFLICT，不盲目覆盖。
    verification: "os-adapter"
    origin: "scenario-review-and-1.0-completion"

// source: profiles/16-mobile.uicl
profile #profile_mobile "移动端目标和设备能力"
  id: "uicl.mobile"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    统一业务契约映射多个工程，权限和生命周期显式。
  requires:
    - "uicl.core@1.0.0"
    - "uicl.application@1.0.0"
  origin: "scenario-review-and-1.0-completion"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "mobile"
  record_schema #r_MobileBinding "MobileBinding"
    summary: "平台能力实现。"
    unknown_fields: "reject"
    property "target"
      type: "ref"
      description: "目标平台配置。"
      required: true
      expression: false
      targets:
        - "target"
    property "implementation"
      type: "text"
      description: "插件/原生模块绑定名。"
      required: true
      expression: false
  schema #s_mobile_permission "mobile.permission"
    summary: "设备权限状态处理要求。"
    primary: "name"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "name"
      type: "text"
      description: "设备能力名。"
      required: true
      expression: false
    property "usage"
      type: "text"
      description: "前台或后台。"
      required: true
      expression: false
      enum:
        - "foreground"
        - "background"
    property "request"
      type: "text"
      description: "请求时机。"
      required: true
      expression: false
      enum:
        - "user_gesture"
    property "on_denied"
      type: "text"
      description: "拒绝路径。"
      required: true
      expression: false
      enum:
        - "explain_and_stop"
    property "on_unavailable"
      type: "text"
      description: "不支持路径。"
      required: true
      expression: false
      enum:
        - "show_unavailable"
  schema #s_mobile_capability "mobile.capability"
    summary: "跨平台设备接口。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "interface"
      type: "text"
      description: "能力接口版本。"
      required: true
      expression: false
    property "permission"
      type: "ref"
      description: "权限契约。"
      required: true
      expression: false
      targets:
        - "mobile.permission"
    property "bindings"
      type: "list<record<MobileBinding>>"
      description: "每目标实现。"
      required: true
      expression: false
    property "input"
      type: "record"
      description: "输入类型。"
      required: true
      expression: false
    property "output"
      type: "text|ref"
      description: "结果类型。"
      required: true
      expression: false
    property "lifecycle"
      type: "text"
      description: "组件销毁后的处理。"
      required: true
      expression: false
      enum:
        - "cancel_on_unmount"
    property "errors"
      type: "list<text>"
      description: "权限拒绝/取消/不可用等。"
      required: true
      expression: false
    port "output"
      type: "dynamic"
      phase: "execution"
  rule #rule_MOBILE_TARGETS "MOBILE_TARGETS"
    level: "MUST"
    statement: |
      多个 target 分别生成工程，不能把平台能力并集冒充共同能力。未支持的平台/插件报错或要求显式分支。SDK、架构、签名与构建主机锁定。
    verification: "build-adapter"
    origin: "scenario-review-and-1.0-completion"
  rule #rule_MOBILE_PERMISSIONS "MOBILE_PERMISSIONS"
    level: "MUST"
    statement: |
      声明权限不是用户已授权。处理未询问、允许、拒绝、不可用、取消和后台限制；页面卸载后的回调不能回写失效状态。
    verification: "device-runtime"
    origin: "scenario-review-and-1.0-completion"

