    property "depends_on"
      type: "list<ref>"
      description: "显式计划前置依赖；兄弟声明顺序不代表部署顺序。"
      required: false
      expression: false
  schema #s_cloudflare_hyperdrive "cloudflare.hyperdrive"
    summary: "连接已有 PostgreSQL 等支持源的连接资源。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "managed-resource"
    property "provider"
      type: "ref"
      description: "账号提供方。"
      required: true
      expression: false
      targets:
        - "cloudflare.provider"
    property "name"
      type: "text"
      description: "名称。"
      required: true
      expression: false
    property "origin"
      type: "ref"
      description: "连接凭据句柄。"
      required: true
      expression: false
      targets:
        - "secret"
    property "on_remove"
      type: "text"
      description: "移除策略。"
      required: true
      expression: false
      enum:
        - "retain"
        - "approval_required"
    property "depends_on"
      type: "list<ref>"
      description: "显式计划前置依赖；兄弟声明顺序不代表部署顺序。"
      required: false
      expression: false
  rule #rule_CF_DIALECT "CF_DIALECT"
    level: "MUST"
    statement: |
      D1 使用独立 SQL 方言，不把 PostgreSQL RLS/类型/索引静默投影为 D1。需要 PostgreSQL 时声明外部数据库与可用连接方案。
    verification: "adapter"
    origin: "scenario-review-and-1.0-completion"
  rule #rule_CF_MANAGED_STATE "CF_MANAGED_STATE"
    level: "MUST"
    statement: |
      通过已锁定适配器管理每项资源。重复 apply 复用外部 ID，要求 import 接管、state 锁与漂移检测。同字段不能同时由多个管理工具独立覆盖。
    verification: "provider-runtime"
    origin: "scenario-review-and-1.0-completion"

// source: profiles/18-host.uicl
profile #profile_host "SSH 主机操作与 ECS 发布"
  id: "uicl.host"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    通用已有 Linux 主机部署。SSH 不授予云控制面权限。
  requires:
    - "uicl.core@1.0.0"
    - "uicl.deployment@1.0.0"
  origin: "scenario-review-and-1.0-completion"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "ops"
  record_schema #r_SshAuthentication "SshAuthentication"
    summary: "SSH 认证。"
    unknown_fields: "reject"
    property "method"
      type: "text"
      description: "认证方式。"
      required: true
      expression: false
      enum:
        - "password"
        - "private_key"
    property "credential"
      type: "ref"
      description: "秘密句柄。"
      required: true
      expression: false
      targets:
        - "secret"
  record_schema #r_HostKey "HostKey"
    summary: "可信服务器身份。"
    unknown_fields: "reject"
    property "policy"
      type: "text"
      description: "固定指纹。"
      required: true
      expression: false
      enum:
        - "pinned"
    property "fingerprint"
      type: "text"
      description: "可信渠道取得的主机指纹。"
      required: true
      expression: true
  record_schema #r_HostExpected "HostExpected"
    summary: "主机前置检查。"
    unknown_fields: "reject"
    property "os"
      type: "text"
      description: "操作系统。"
      required: true
      expression: false
    property "architecture"
      type: "text"
      description: "CPU 架构。"
      required: true
      expression: false
    property "service_manager"
      type: "text"
      description: "服务管理器。"
      required: true
      expression: false
  record_schema #r_Privilege "Privilege"
    summary: "远程操作提权要求。"
    unknown_fields: "reject"
    property "method"
      type: "text"
      description: "sudo 或 none。"
      required: true
      expression: false
      enum:
        - "sudo"
        - "none"
    property "mode"
      type: "text"
      description: "提权方式。"
      required: true
      expression: false
      enum:
        - "noninteractive"
        - "credential"
    property "credential"
      type: "ref"
      description: "单独 sudo 凭据，不默认等于 SSH 密码。"
      required: false
      expression: false
      targets:
        - "secret"
  record_schema #r_Health "Health"
    summary: "健康检查。"
    unknown_fields: "reject"
    property "url"
      type: "text"
      description: "目标 URL；受执行位置和网络策略限制。"
      required: true
      expression: false
    property "expected_status"
      type: "int"
      description: "期望 HTTP 状态。"
      required: true
      expression: false
    property "timeout_ms"
      type: "int"
      description: "超时。"
      required: true
      expression: false
  record_schema #r_ReleaseRecovery "ReleaseRecovery"
    summary: "发布恢复。"
    unknown_fields: "reject"
    property "on_unhealthy"
      type: "text"
      description: "程序版本恢复范围。"
      required: true
      expression: false
      enum:
        - "previous_binary"
        - "stop"
    property "on_disconnect"
      type: "text"
      description: "断线先对账。"
      required: true
      expression: false
      enum:
        - "reconcile"
    property "database"
      type: "text"
      description: "不自动逆转数据库。"
      required: true
      expression: false
      enum:
        - "no_automatic_rollback"
  schema #s_ops_ssh_host "ops.ssh_host"
    summary: "已有主机的可信连接配置。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "managed-resource"
    property "address"
      type: "text"
      description: "IP 或主机名。"
      required: true
      expression: true
    property "port"
      type: "int"
      description: "SSH 端口。"
      required: false
      expression: false
      default: 22
    property "user"
      type: "text"
      description: "SSH 用户。"
      required: true
      expression: true
    property "authentication"
      type: "record<SshAuthentication>"
      description: "认证。"
      required: true
      expression: false
    property "host_key"
      type: "record<HostKey>"
      description: "服务端身份。"
      required: true
      expression: false
    property "expected"
      type: "record<HostExpected>"
      description: "前置环境。"
      required: true
      expression: false
    property "privilege"
      type: "record<Privilege>"
      description: "提权。"
      required: true
      expression: false
    property "depends_on"
      type: "list<ref>"
      description: "显式计划前置依赖；兄弟声明顺序不代表部署顺序。"
      required: false
      expression: false
  schema #s_ops_service_release "ops.service_release"
    summary: "上传校验、版本目录、进程管理及健康检查。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects:
      - "host.deploy"
    category: "managed-resource"
    property "host"
      type: "ref"
      description: "SSH 主机。"
      required: true
      expression: false
      targets:
        - "ops.ssh_host"
    property "artifact"
      type: "ref"
      description: "真实构建产物。"
      required: true
      expression: false
    property "service_name"
      type: "text"
      description: "服务名。"
      required: true
      expression: false
    property "run_as"
      type: "text"
      description: "独立服务账户，须预先存在或经引导创建。"
      required: true
      expression: false
    property "directory"
      type: "text"
      description: "受管发布目录。"
      required: true
      expression: false
    property "executable"
      type: "text"
      description: "包内可执行入口。"
      required: true
      expression: false
    property "environment"
      type: "record"
      description: "环境变量；秘密只在运行端定向注入。"
      required: false
      expression: false
      default: {}
    property "retain_releases"
      type: "int"
      description: "保留程序版本数量。"
      required: true
      expression: false
    property "health"
      type: "record<Health>"
      description: "健康检查。"
      required: true
      expression: false
    property "recovery"
      type: "record<ReleaseRecovery>"
      description: "失败/断线恢复。"
      required: true
      expression: false
    property "approval"
      type: "text"
      description: "发布需要外部授权。"
      required: true
      expression: false
      enum:
        - "required"
    property "depends_on"
      type: "list<ref>"
      description: "显式计划前置依赖；兄弟声明顺序不代表部署顺序。"
      required: false
      expression: false
  rule #rule_HOST_AUTH "HOST_AUTH"
    level: "MUST"
    statement: |
      SSH 密码/密钥仅由凭据代理交给认证入口。严格主机指纹校验，变化时报错；不能为方便而自动关闭验证。sudo 权限必须独立检查。
    verification: "ssh-adapter"
    origin: "scenario-review-and-1.0-completion"
  rule #rule_HOST_RECONCILE "HOST_RECONCILE"
    level: "MUST"
    statement: |
      断线不能直接解释为失败。执行日志/标识与目标状态决定恢复；先对账后重试迁移。上传到临时版本目录、校验摘要后切换；previous_binary 不回滚数据库。
    verification: "ssh-runtime"
    origin: "scenario-review-and-1.0-completion"
  rule #rule_HOST_CLOUD_BOUNDARY "HOST_CLOUD_BOUNDARY"
    level: "MUST"
    statement: |
      登录 ECS 的系统权限与阿里云 RAM/安全组/实例创建权限分离。普通 SSH 场景不需要也不拥有云控制面权限；网络和账户前置条件不满足应阻断。
    verification: "adapter-preflight"
    origin: "scenario-review-and-1.0-completion"

// source: profiles/19-lifecycle.uicl
profile #profile_lifecycle "需求、项目与观测"
  id: "uicl.lifecycle"
  version: "1.0.0"
  core: "1.0"
  status: "consolidated-draft"
  summary: |
    把完整开发交付过程关联起来，不把计划当执行事实。
  requires:
    - "uicl.core@1.0.0"
    - "uicl.application@1.0.0"
    - "uicl.testing@1.0.0"
    - "uicl.deployment@1.0.0"
  origin: "conversation-design"
  implementation: "syntax-shape-prototype; domain-runtime-not-implemented"
  namespaces:
    - "decision"
    - "observe"
    - "project"
    - "requirement"
  schema #s_requirement "requirement"
    summary: "可引用的业务需求。"
    primary: "title"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "title"
      type: "text"
      description: "需求摘要。"
      required: true
      expression: false
    property "statement"
      type: "text"
      description: "完整要求。"
      required: true
      expression: false
    property "acceptance"
      type: "list<text>"
      description: "验收标准，不等于已通过。"
      required: true
      expression: false
  schema #s_decision "decision"
    summary: "未决需求阻断发布。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "question"
      type: "text"
      description: "需要决定的问题。"
      required: true
      expression: false
    property "options"
      type: "list<text>"
      description: "候选。"
      required: true
      expression: false
    property "resolved"
      type: "bool"
      description: "是否已明确解决。"
      required: true
      expression: false
    property "answer"
      type: "text"
      description: "已确认答案。"
      required: false
      expression: false
  schema #s_project "project"
    summary: "跨模块项目入口。"
    primary: "title"
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "title"
      type: "text"
      description: "项目名。"
      required: true
      expression: false
    property "requirements"
      type: "list<ref>"
      description: "需求列表。"
      required: true
      expression: false
      targets:
        - "requirement"
    property "design"
      type: "ref"
      description: "设计系统。"
      required: true
      expression: false
      targets:
        - "design"
    property "app"
      type: "ref"
      description: "UI 应用。"
      required: true
      expression: false
      targets:
        - "app"
    property "service"
      type: "ref"
      description: "后端服务。"
      required: true
      expression: false
      targets:
        - "service"
    property "database"
      type: "ref"
      description: "数据库。"
      required: true
      expression: false
      targets:
        - "pg.database"
    property "tests"
      type: "list<ref>"
      description: "验收。"
      required: true
      expression: false
      targets:
        - "test"
    property "builds"
      type: "list<ref>"
      description: "构建声明。"
      required: true
      expression: false
      targets:
        - "build"
    property "deployment"
      type: "ref"
      description: "部署环境。"
      required: true
      expression: false
      targets:
        - "deployment"
  schema #s_observe "observe"
    summary: "运行观测契约，不默认收集正文。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
    effects: []
    category: "declaration"
    property "target"
      type: "ref"
      description: "被观测对象。"
      required: true
      expression: false
    property "signals"
      type: "list<text>"
      description: "日志/指标/追踪。"
      required: true
      expression: false
    property "payloads"
      type: "text"
      description: "禁止敏感正文。"
      required: true
      expression: false
      enum:
        - "deny"
    property "retention_days"
      type: "int"
      description: "保留期限。"
      required: true
      expression: false
    property "binding"
      type: "text"
      description: "授权接收端。"
      required: true
      expression: false
  rule #rule_LIFECYCLE_GATES "LIFECYCLE_GATES"
    level: "MUST"
    statement: |
      未解决 decision、未知检查、缺失工具/模型/身份绑定或未授权的数据出站均阻断发布。不因语法可解析就声称应用可运行。
    verification: "planner-runtime"
    origin: "conversation-design"
  rule #rule_LIFECYCLE_OBSERVE "LIFECYCLE_OBSERVE"
    level: "MUST"
    statement: |
      日志/追踪默认不记录请求正文、凭据、模型完整上下文；没有授权接收端不上传。验证/执行状态必须诚实区分声明、计划、实际回执。
    verification: "runtime"
    origin: "conversation-design"

// source: meta/examples.uicl
example #example_1 "01-hello"
  path: "examples/01-hello.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    app "你好"
      ui.text "我的第一个 UICL 应用"
  ```

example #example_2 "02-counter"
  path: "examples/02-counter.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    app #counter "计数器"
      state #count
        value: 0
      ui.text
        value: $count
      ui.button #increase "加一"
        on click
          set
            target: @count
            value: = $count + 1
  ```

example #example_3 "03-device-notes"
  path: "examples/03-device-notes.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    app #notes_app "随手记"
      collection #notes
        storage: device
        operations:
          - read
          - create
        field "content"
          type: text
          min: 1
      form #editor "新增便签"
        create: @notes
      list #entries
        source: @notes
        empty_text: "尚无便签。"
  ```

example #example_4 "04-design-system"
  path: "examples/04-design-system.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    design #brand "通用阅读设计系统"
      mode: system
      tokens:
        color:
          brand: "#315BEA"
          surface: "#FFFFFF"
          text: "#172033"
        spacing:
          normal: 16
        radius:
          card: 12
      locales:
        - "zh-CN"
        - en
      breakpoints:
        - name: wide
          min_width: 840
          columns: 2
      theme "dark"
        tokens:
          color:
            surface: "#111827"
            text: "#F9FAFB"
      style #panel "panel"
        values:
          padding: 16
          radius: 12
      a11y
        target: "wcag-2.2-aa"
        reduce_motion: respect_system
        keyboard: true
    
    app #design_demo "设计预览"
      design: @brand
      ui.card
        style: @panel
        ui.heading "产品概览"
        ui.text "目标声明需要通过实际检查才能成为达标证据。"
  ```

example #example_5 "05-component"
  path: "examples/05-component.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    component #metric "指标卡"
      props:
        title: text
        value: int
      events: {}
      ui.card
        ui.heading
          value: $props.title
        ui.text
          value: $props.value
    
    app #dashboard "仪表板"
      page #home "首页"
        route: "/"
        component.use
          component: @metric
          props:
            title: "今日任务"
            value: 8
  ```

example #example_6 "06-mobile-targets"
  path: "examples/06-mobile-targets.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    target #uni
      adapter: "mobile.uniapp_x"
      framework: uniapp_x
      platforms:
        - android
        - ios
      toolchain: locked
    
    target #rn
      adapter: "mobile.react_native"
      framework: react_native
      platforms:
        - android
        - ios
      toolchain: locked
    
    app #mobile_notes "跨端便签"
      targets:
        - @uni
        - @rn
      collection #notes
        storage: device
        field "content"
          type: text
          min: 1
      form #editor "新增"
        create: @notes
      list #entries
        source: @notes
  ```

example #example_7 "07-mobile-camera"
  path: "examples/07-mobile-camera.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.mobile@1.0.0", "uicl.resource@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    target #uni
      adapter: "mobile.uniapp_x"
      platforms: [android, ios]
      toolchain: locked
    
    target #rn
      adapter: "mobile.react_native"
      platforms: [android, ios]
      toolchain: locked
    
    mobile.permission #camera_permission "camera"
      usage: foreground
      request: user_gesture
      on_denied: explain_and_stop
      on_unavailable: show_unavailable
    
    mobile.capability #camera
      interface: "device.camera.capture@1"
      permission: @camera_permission
      bindings:
        - target: @uni
          implementation: "host.uts.camera"
        - target: @rn
          implementation: "host.rn.camera"
      input: {}
      output: "Artifact<image>"
      lifecycle: cancel_on_unmount
      errors: [CANCELLED, PERMISSION_DENIED, UNAVAILABLE]
    
    app #camera_app "拍照示例"
      targets: [@uni, @rn]
      ui.button #capture "拍照"
        on click
          invoke #photo
            capability: @camera
            args: {}
  ```

example #example_8 "08-windows-native"
  path: "examples/08-windows-native.uicl"
  profiles: ["uicl.application@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.native@1.0.0", "uicl.resource@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    target #windows
      adapter: "desktop.wpf"
      platform: windows
      framework: wpf
      language: csharp
      architectures: [x64, arm64]
      toolchain: locked
      build_host: windows
      ui_privilege: as_invoker
    
    file #native_source "原生接口待实现边界"
      media: "text/x-csharp"
      source: @"../assets/ServiceActions.cs"
    
    native.operation #set_start_mode
      interface: "windows.service.set_start_mode@1"
      implementation: @native_source
      entry: "ServiceActions.SetStartMode"
      input:
        service: text
        mode: text
      output: unit
      effects: [os.service.configure]
      policy:
        allowed_objects: [DemoMaintenanceService]
        execution: elevated_broker
        approval: each_invocation
      recovery:
        capture_before: true
        restore: compare_and_set
      threading: worker
      errors: [DENIED, NOT_FOUND, CONFLICT, INDETERMINATE]
    
    app #maintenance "桌面维护工具"
      target: @windows
      ui.text "只允许修改由本示例管理的演示服务。"
      ui.button #manual "设为手动启动"
        on click
          invoke
            capability: @set_start_mode
            args:
              service: "DemoMaintenanceService"
              mode: manual
  ```

example #example_9 "09-postgresql"
  path: "examples/09-postgresql.uicl"
  profiles: ["uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.meta@1.0.0", "uicl.postgresql@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    pg.database #business
      name: "business"
      engine_major: 18
      schema: public
    
      pg.table #customers
        name: "customers"
        columns:
          - name: id
            type: uuid
            nullable: false
          - name: email
            type: text
            nullable: false
        primary_key: [id]
        unique:
          - columns: [email]
    
      pg.table #orders
        name: "orders"
        columns:
          - name: id
            type: uuid
            nullable: false
          - name: customer_id
            type: uuid
            nullable: false
          - name: amount
            type: "numeric(12,2)"
            nullable: false
          - name: status
            type: text
            nullable: false
            default: "pending"
        primary_key: [id]
        foreign_keys:
          - columns: [customer_id]
            target: @customers
            target_columns: [id]
            on_delete: restrict
        checks:
          - name: amount_nonnegative
            sql: "amount >= 0"
        indexes:
          - name: pending_orders_by_customer
            columns: [customer_id]
            method: btree
            where_sql: "status = 'pending'"
            build: concurrently
    
    pg.migration #index_migration
      database: @business
      from_version: "1"
      to_version: "2"
      atomic: split_allowed
      destructive: deny
      lock_timeout_ms: 5000
      statement_timeout_ms: 120000
      steps:
        - operation: create_index
          target: @orders
          name: "pending_orders_by_customer"
          build: concurrently
  ```

example #example_10 "10-cloudflare"
  path: "examples/10-cloudflare.uicl"
  profiles: ["uicl.backend@1.0.0", "uicl.cloudflare@1.0.0", "uicl.core@1.0.0", "uicl.deployment@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    parameter #account_id "Cloudflare 账号"
      type: text
    
    secret #cloudflare_token "资源管理 Token"
      source: runtime_prompt
      scope: [cloudflare_adapter]
    
    cloudflare.provider #cf
      account_id: $account_id
      token: @cloudflare_token
      adapter_binding: "cloudflare_adapter"
    
    file #worker_bundle "Worker 源码"
      source: @"../assets/worker.mjs"
      media: "text/javascript"
    
    cloudflare.r2_bucket #uploads
      provider: @cf
      name: "uicl-example-uploads"
      on_remove: retain
    
    cloudflare.d1_database #db
      provider: @cf
      name: "uicl-example-db"
      on_remove: retain
    
    cloudflare.worker #api
      provider: @cf
      name: "uicl-example-api"
      entry: @worker_bundle
      compatibility_date: "2026-09-01"
      workers_dev: true
      bindings:
        DB: @db
        FILES: @uploads
    
    deployment #production "Cloudflare 示例"
      resources: [@uploads, @db, @api]
      state:
        binding: "infra-state:cloudflare-example"
        locking: required
        encryption: required
      existing_resources: require_import
      approval: required
  ```

example #example_11 "11-ecs-ssh"
  path: "examples/11-ecs-ssh.uicl"
  profiles: ["uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.deployment@1.0.0", "uicl.design@1.0.0", "uicl.host@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    parameter #server_ip "ECS IP"
      type: text
    parameter #ssh_user "SSH 用户"
      type: text
    parameter #host_fingerprint "可信主机指纹"
      type: text
    
    secret #ssh_password "SSH 密码"
      source: runtime_prompt
      scope: [ssh_adapter]
    
    ops.ssh_host #ecs
      address: $server_ip
      user: $ssh_user
      port: 22
      authentication:
        method: password
        credential: @ssh_password
      host_key:
        policy: pinned
        fingerprint: $host_fingerprint
      expected:
        os: linux
        architecture: x86_64
        service_manager: systemd
      privilege:
        method: sudo
        mode: noninteractive
    
    // 此处是外部产物定位声明，不随包提供可执行文件。
    artifact #release
      media: "application/gzip"
      source: @"artifact://host-supplied/example-api"
    
    ops.service_release #api
      host: @ecs
      artifact: @release
      service_name: "example-api"
      run_as: "example-api"
      directory: "/opt/example-api"
      executable: "bin/api"
      retain_releases: 3
      health:
        url: "http://127.0.0.1:8080/health"
        expected_status: 200
        timeout_ms: 30000
      recovery:
        on_unhealthy: previous_binary
        on_disconnect: reconcile
        database: no_automatic_rollback
      approval: required
    
    deployment #production "已有 Linux ECS"
      resources: [@ecs, @api]
      state:
        binding: "ops-state:ecs-example"
        locking: required
      existing_resources: require_import
      approval: required
  ```

example #example_12 "12-aigc-image"
  path: "examples/12-aigc-image.uicl"
  profiles: ["uicl.aigc@1.0.0", "uicl.backend@1.0.0", "uicl.core@1.0.0", "uicl.design@1.0.0", "uicl.meta@1.0.0", "uicl.resource@1.0.0", "uicl.testing@1.0.0", "uicl.ui@1.0.0"]
  readiness: "contract-example; tools-checked; real-runtime-not-executed"
  body: ```uicl
    uicl "1.0"
    
    image #cover "咖啡海报"
      prompt: "一杯冰咖啡，干净背景，顶部为精确标题留白。"
      size: [1200, 1600]
      prefer:
        lighting: "柔和侧光"
        palette:
          - "奶油白"
          - "咖啡棕"
      scene
        background: "浅色无纹理背景"
        subject "冰咖啡"
          count: 1
          region: [0.25, 0.25, 0.5, 0.6]
      overlay
        overlay.text "夏日限定"
          region: [0.1, 0.05, 0.8, 0.12]
          font: "licensed-font:headline"
          font_px: 72
          align: center
      require
        check "media.dimensions"
          equals: [1200, 1600]
        check "media.mime"
          equals: "image/png"
      review
        criterion "主要杯子只有一个，标题不遮挡主体。"
    
    generate #render
      from: @cover
      phase: build
      output: "image/png"
      binding: "image_generation"
      limits:
        timeout_ms: 90000
        attempts: 1
        max_cost_minor: 100
        currency: USD
      approval: required
  ```

