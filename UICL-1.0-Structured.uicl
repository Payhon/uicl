    unknown_properties: "reject"
    effects: []
    category: "managed-resource"
    property "provider"
      type: "ref"
      description: "账号提供方。"
      required: true
      expression: false
      targets:
        - "cloudflare.provider"
    property "name"
      type: "text"
      description: "云端名称。"
      required: true
      expression: false
    property "on_remove"
      type: "text"
      description: "数据资源删除策略。"
      required: true
      expression: false
      enum:
        - "retain"
        - "approval_required"
    property "depends_on"
      type: "list<ref>"
      description: "显式计划前置依赖；兄弟声明顺序不代表部署顺序。"
      required: false
      expression: false
    port "resource"
      type: "CloudResource"
      phase: "execution"
  schema #s_cloudflare_worker "cloudflare.worker"
    summary: "Worker 部署单元与绑定。"
    primary: null
    identity: "required"
    children: []
    unknown_properties: "reject"
